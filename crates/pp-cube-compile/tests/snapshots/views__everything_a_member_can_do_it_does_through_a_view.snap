---
source: crates/pp-cube-compile/tests/views.rs
expression: "compiled(DialectId::Presto, REPEATED_SUM)"
---
 WITH 
cte_0 AS (  SELECT "sales".channel_cd "sales_view__channel_cd", sum("sales".amount) "sales__amount"  
  FROM  dw.sales_dtl  AS "sales" GROUP BY 1),
cte_1 AS (  SELECT "keys"."sales_view__channel_cd" "sales_view__channel_cd", sum("stores_key_stores".floor_area) "stores__floor_area"  
  FROM (SELECT DISTINCT "stores_key_sales".channel_cd "sales_view__channel_cd", "stores_key_stores".store_cd "stores__store_cd"  
  FROM  dw.sales_dtl  AS "stores_key_sales"
  LEFT JOIN  dw.dim_store  AS "stores_key_stores" ON "stores_key_sales".store_cd = "stores_key_stores".store_cd) AS "keys"
  LEFT JOIN  dw.dim_store  AS "stores_key_stores" ON (("keys"."stores__store_cd" = "stores_key_stores".store_cd)) GROUP BY 1)
SELECT "fk_aggregate_keys"."sales_view__channel_cd" "sales_view__channel_cd", "q_0"."sales__amount" "sales_view__amount", "q_1"."stores__floor_area" "sales_view__stores_floor_area"  
FROM (SELECT DISTINCT "sales_view__channel_cd" "sales_view__channel_cd"  
FROM (SELECT DISTINCT "sales_view__channel_cd" "sales_view__channel_cd"  
FROM  cte_0  AS "cte_0"
 UNION ALL 
SELECT DISTINCT "sales_view__channel_cd" "sales_view__channel_cd"  
FROM  cte_1  AS "cte_1") AS "fk_aggregate_keys_source") AS "fk_aggregate_keys"
LEFT JOIN  cte_0  AS "q_0" ON (("fk_aggregate_keys"."sales_view__channel_cd" = "q_0"."sales_view__channel_cd" OR (("fk_aggregate_keys"."sales_view__channel_cd" IS NULL) AND ("q_0"."sales_view__channel_cd" IS NULL))))
LEFT JOIN  cte_1  AS "q_1" ON (("fk_aggregate_keys"."sales_view__channel_cd" = "q_1"."sales_view__channel_cd" OR (("fk_aggregate_keys"."sales_view__channel_cd" IS NULL) AND ("q_1"."sales_view__channel_cd" IS NULL)))) ORDER BY  1  ASC
-- parameters: []
