---
source: crates/pp-cube-compile/tests/filters.rs
expression: "compiled(r#\"\"filters\": [\n            {\"member\": \"sales.qty\", \"operator\": \"gt\", \"values\": [\"1\"]},\n            {\"member\": \"sales.qty\", \"operator\": \"gte\", \"values\": [\"2\"]},\n            {\"member\": \"sales.qty\", \"operator\": \"lt\", \"values\": [\"30\"]},\n            {\"member\": \"sales.qty\", \"operator\": \"lte\", \"values\": [\"40\"]}\n        ]\"#)"
---
SELECT "sales".channel_cd "sales__channel_cd", sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ("sales".qty > CAST(? AS DOUBLE)) AND ("sales".qty >= CAST(? AS DOUBLE)) AND ("sales".qty < CAST(? AS DOUBLE)) AND ("sales".qty <= CAST(? AS DOUBLE)) GROUP BY 1 ORDER BY  2  DESC
-- parameters: [Text("1"), Text("2"), Text("30"), Text("40")]
