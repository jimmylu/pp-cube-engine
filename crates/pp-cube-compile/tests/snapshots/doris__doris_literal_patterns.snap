contains:
SELECT sum(`sales`.amount) `sales__total`  
FROM  dw.sales  AS `sales`
WHERE ((LOWER(`sales`.region) LIKE CONCAT('%', LOWER(?), '%'))) AND (`sales`.region = ?)
