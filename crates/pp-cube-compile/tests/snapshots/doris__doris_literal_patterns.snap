FROM  dw.sales  AS `sales`
WHERE ((LOWER(`sales`.region) NOT LIKE CONCAT('%', LOWER(?), '%')) OR `sales`.region IS NULL) AND (`sales`.region = ?)
[Text("A\\%\\_\\\\B"), Text("north")]

