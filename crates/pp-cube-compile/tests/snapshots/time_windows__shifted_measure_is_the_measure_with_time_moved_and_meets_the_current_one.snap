---
source: crates/pp-cube-compile/tests/time_windows.rs
expression: "[over(r#\"\"sales.amount\", \"sales.amount_prior_year\"\"#, YEAR_BY_MONTH),\nover(r#\"\"sales.amount_next_month\"\"#,\nYEAR_BY_MONTH),].map(|query| compiled(DialectId::Presto, &query)).join(\"\\n\\n\")"
---
 WITH 
cte_0 AS (  SELECT date_trunc('month', CAST(date_add('minute', timezone_minute(COALESCE(("sales".sold_at + interval '1' year), CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), date_add('hour', timezone_hour(COALESCE(("sales".sold_at + interval '1' year), CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), COALESCE(("sales".sold_at + interval '1' year), CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP)) "sales__sold_at_month", sum("sales".amount) "sales__amount"  
  FROM  dw.sales_dtl  AS "sales"
  WHERE (("sales".sold_at + interval '1' year) >= from_iso8601_timestamp(?) AND ("sales".sold_at + interval '1' year) <= from_iso8601_timestamp(?)) GROUP BY 1 ORDER BY  1  ASC),
cte_1 AS (  SELECT "fk_aggregate"."sales__sold_at_month" "sales__sold_at_month", "fk_aggregate"."sales__amount" "sales__amount_prior_year"  
  FROM  cte_0  AS "fk_aggregate"),
cte_2 AS (  SELECT date_trunc('month', CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP)) "sales__sold_at_month", sum("sales".amount) "sales__amount"  
  FROM  dw.sales_dtl  AS "sales"
  WHERE ("sales".sold_at >= from_iso8601_timestamp(?) AND "sales".sold_at <= from_iso8601_timestamp(?)) GROUP BY 1)
SELECT "fk_aggregate_keys"."sales__sold_at_month" "sales__sold_at_month", "q_1"."sales__amount" "sales__amount", "q_0"."sales__amount_prior_year" "sales__amount_prior_year"  
FROM (SELECT DISTINCT "sales__sold_at_month" "sales__sold_at_month"  
FROM (SELECT DISTINCT "sales__sold_at_month" "sales__sold_at_month"  
FROM  cte_1  AS "cte_1"
 UNION ALL 
SELECT DISTINCT "sales__sold_at_month" "sales__sold_at_month"  
FROM  cte_2  AS "cte_2") AS "fk_aggregate_keys_source") AS "fk_aggregate_keys"
LEFT JOIN  cte_1  AS "q_0" ON (("fk_aggregate_keys"."sales__sold_at_month" = "q_0"."sales__sold_at_month" OR (("fk_aggregate_keys"."sales__sold_at_month" IS NULL) AND ("q_0"."sales__sold_at_month" IS NULL))))
LEFT JOIN  cte_2  AS "q_1" ON (("fk_aggregate_keys"."sales__sold_at_month" = "q_1"."sales__sold_at_month" OR (("fk_aggregate_keys"."sales__sold_at_month" IS NULL) AND ("q_1"."sales__sold_at_month" IS NULL)))) ORDER BY  1  ASC
-- parameters: [Text("2026-01-01T00:00:00.000Z"), Text("2026-12-31T23:59:59.999Z"), Text("2026-01-01T00:00:00.000Z"), Text("2026-12-31T23:59:59.999Z")]

 WITH 
cte_0 AS (  SELECT date_trunc('month', CAST(date_add('minute', timezone_minute(COALESCE(("sales".sold_at + interval '-1' month), CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), date_add('hour', timezone_hour(COALESCE(("sales".sold_at + interval '-1' month), CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), COALESCE(("sales".sold_at + interval '-1' month), CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP)) "sales__sold_at_month", sum("sales".amount) "sales__amount"  
  FROM  dw.sales_dtl  AS "sales"
  WHERE (("sales".sold_at + interval '-1' month) >= from_iso8601_timestamp(?) AND ("sales".sold_at + interval '-1' month) <= from_iso8601_timestamp(?)) GROUP BY 1 ORDER BY  1  ASC),
cte_1 AS (  SELECT "fk_aggregate"."sales__sold_at_month" "sales__sold_at_month", "fk_aggregate"."sales__amount" "sales__amount_next_month"  
  FROM  cte_0  AS "fk_aggregate")
SELECT "fk_aggregate"."sales__sold_at_month" "sales__sold_at_month", "fk_aggregate"."sales__amount_next_month" "sales__amount_next_month"  
FROM  cte_1  AS "fk_aggregate" ORDER BY  1  ASC
-- parameters: [Text("2026-01-01T00:00:00.000Z"), Text("2026-12-31T23:59:59.999Z")]
