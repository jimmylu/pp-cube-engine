---
source: crates/pp-cube-compile/tests/time_windows.rs
expression: "[over(r#\"\"sales.amount_mtd\"\"#, THREE_DAYS),\nover(r#\"\"sales.amount_ytd\", \"sales.amount\"\"#,\nYEAR_BY_MONTH),].map(|query| compiled(DialectId::Presto, &query)).join(\"\\n\\n\")"
---
 WITH 
time_series AS (  SELECT d AS date_from,
  date_add('MILLISECOND', -1, d + interval '1' day) AS date_to
  FROM UNNEST(
  SEQUENCE(CAST(from_iso8601_timestamp('2026-10-01T00:00:00.000') AS TIMESTAMP), CAST(from_iso8601_timestamp('2026-10-03T23:59:59.999') AS TIMESTAMP), INTERVAL '1' day)
  ) AS dates(d)),
cte_0 AS (  SELECT date_trunc('day', CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP)) "sales__sold_at_day", sum("sales".amount) "sales__amount_mtd"  
  FROM  dw.sales_dtl  AS "sales"
  WHERE (CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP) >= from_iso8601_timestamp(?) AND CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP) <= from_iso8601_timestamp(?)) GROUP BY 1 ORDER BY  1  ASC),
cte_1 AS (  SELECT "time_series"."date_from" "sales__sold_at_day", sum("rolling_source"."sales__amount_mtd") "sales__amount_mtd"  
  FROM  time_series  AS "time_series"
  LEFT JOIN  cte_0  AS "rolling_source" ON "rolling_source"."sales__sold_at_day" >= date_trunc('month', "time_series"."date_from") and "rolling_source"."sales__sold_at_day" <= "time_series"."date_to" GROUP BY 1 ORDER BY  1  ASC)
SELECT "fk_aggregate"."sales__sold_at_day" "sales__sold_at_day", "fk_aggregate"."sales__amount_mtd" "sales__amount_mtd"  
FROM  cte_1  AS "fk_aggregate" ORDER BY  1  ASC
-- parameters: [Text("2026-10-01T00:00:00.000"), Text("2026-10-04T23:59:58.999")]

 WITH 
time_series AS (  SELECT d AS date_from,
  date_add('MILLISECOND', -1, d + interval '1' month) AS date_to
  FROM UNNEST(
  SEQUENCE(CAST(from_iso8601_timestamp('2026-01-01T00:00:00.000') AS TIMESTAMP), CAST(from_iso8601_timestamp('2026-12-31T23:59:59.999') AS TIMESTAMP), INTERVAL '1' month)
  ) AS dates(d)),
cte_0 AS (  SELECT date_trunc('month', CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP)) "sales__sold_at_month", sum("sales".amount) "sales__amount_ytd"  
  FROM  dw.sales_dtl  AS "sales"
  WHERE (CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP) >= from_iso8601_timestamp(?) AND CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP) <= from_iso8601_timestamp(?)) GROUP BY 1 ORDER BY  1  ASC),
cte_1 AS (  SELECT "time_series"."date_from" "sales__sold_at_month", sum("rolling_source"."sales__amount_ytd") "sales__amount_ytd"  
  FROM  time_series  AS "time_series"
  LEFT JOIN  cte_0  AS "rolling_source" ON "rolling_source"."sales__sold_at_month" >= date_trunc('year', "time_series"."date_from") and "rolling_source"."sales__sold_at_month" <= "time_series"."date_to" GROUP BY 1 ORDER BY  1  ASC),
cte_2 AS (  SELECT date_trunc('month', CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP)) "sales__sold_at_month", sum("sales".amount) "sales__amount"  
  FROM  dw.sales_dtl  AS "sales"
  WHERE ("sales".sold_at >= from_iso8601_timestamp(?) AND "sales".sold_at <= from_iso8601_timestamp(?)) GROUP BY 1)
SELECT "fk_aggregate_keys"."sales__sold_at_month" "sales__sold_at_month", "q_0"."sales__amount_ytd" "sales__amount_ytd", "q_1"."sales__amount" "sales__amount"  
FROM (SELECT DISTINCT "sales__sold_at_month" "sales__sold_at_month"  
FROM (SELECT DISTINCT "sales__sold_at_month" "sales__sold_at_month"  
FROM  cte_1  AS "cte_1"
 UNION ALL 
SELECT DISTINCT "sales__sold_at_month" "sales__sold_at_month"  
FROM  cte_2  AS "cte_2") AS "fk_aggregate_keys_source") AS "fk_aggregate_keys"
LEFT JOIN  cte_1  AS "q_0" ON (("fk_aggregate_keys"."sales__sold_at_month" = "q_0"."sales__sold_at_month" OR (("fk_aggregate_keys"."sales__sold_at_month" IS NULL) AND ("q_0"."sales__sold_at_month" IS NULL))))
LEFT JOIN  cte_2  AS "q_1" ON (("fk_aggregate_keys"."sales__sold_at_month" = "q_1"."sales__sold_at_month" OR (("fk_aggregate_keys"."sales__sold_at_month" IS NULL) AND ("q_1"."sales__sold_at_month" IS NULL)))) ORDER BY  1  ASC
-- parameters: [Text("2026-01-01T00:00:00.000"), Text("2027-01-31T23:59:58.999"), Text("2026-01-01T00:00:00.000Z"), Text("2026-12-31T23:59:59.999Z")]
