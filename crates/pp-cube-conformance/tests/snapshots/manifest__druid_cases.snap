---
source: crates/pp-cube-conformance/tests/manifest.rs
expression: "golden_text(\"druid\")"
---
-- day
SELECT DATE_TRUNC('day', CAST(TIME_FORMAT("sales".__time, 'yyyy-MM-dd HH:mm:ss', 'Asia/Tokyo') AS TIMESTAMP)) "sales__sold_at_day", sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ("sales".__time >= TIME_PARSE(?) AND "sales".__time <= TIME_PARSE(?))
GROUP BY 1
ORDER BY  1  ASC
-- parameters: ["2026-09-30T15:00:00.000Z", "2026-10-31T14:59:59.999Z"]

-- week
SELECT DATE_TRUNC('week', CAST(TIME_FORMAT("sales".__time, 'yyyy-MM-dd HH:mm:ss', 'Asia/Tokyo') AS TIMESTAMP)) "sales__sold_at_week", sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ("sales".__time >= TIME_PARSE(?) AND "sales".__time <= TIME_PARSE(?))
GROUP BY 1
ORDER BY  1  ASC
-- parameters: ["2026-09-30T15:00:00.000Z", "2026-10-31T14:59:59.999Z"]

-- month
SELECT DATE_TRUNC('month', CAST(TIME_FORMAT("sales".__time, 'yyyy-MM-dd HH:mm:ss', 'Asia/Tokyo') AS TIMESTAMP)) "sales__sold_at_month", sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ("sales".__time >= TIME_PARSE(?) AND "sales".__time <= TIME_PARSE(?))
GROUP BY 1
ORDER BY  1  ASC
-- parameters: ["2026-09-30T15:00:00.000Z", "2026-10-31T14:59:59.999Z"]

-- quarter
SELECT DATE_TRUNC('quarter', CAST(TIME_FORMAT("sales".__time, 'yyyy-MM-dd HH:mm:ss', 'Asia/Tokyo') AS TIMESTAMP)) "sales__sold_at_quarter", sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ("sales".__time >= TIME_PARSE(?) AND "sales".__time <= TIME_PARSE(?))
GROUP BY 1
ORDER BY  1  ASC
-- parameters: ["2026-09-30T15:00:00.000Z", "2026-10-31T14:59:59.999Z"]

-- year
SELECT DATE_TRUNC('year', CAST(TIME_FORMAT("sales".__time, 'yyyy-MM-dd HH:mm:ss', 'Asia/Tokyo') AS TIMESTAMP)) "sales__sold_at_year", sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ("sales".__time >= TIME_PARSE(?) AND "sales".__time <= TIME_PARSE(?))
GROUP BY 1
ORDER BY  1  ASC
-- parameters: ["2026-09-30T15:00:00.000Z", "2026-10-31T14:59:59.999Z"]

-- inDateRange
SELECT sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ("sales".__time >= TIME_PARSE(?) AND "sales".__time <= TIME_PARSE(?))
-- parameters: ["2026-09-30T15:00:00.000Z", "2026-10-31T14:59:59.999Z"]

-- notInDateRange
SELECT sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ("sales".__time < TIME_PARSE(?) OR "sales".__time > TIME_PARSE(?))
-- parameters: ["2026-09-30T15:00:00.000Z", "2026-10-31T14:59:59.999Z"]

-- beforeDate
SELECT sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ("sales".__time < TIME_PARSE(?))
-- parameters: ["2026-09-30T15:00:00.000Z"]

-- beforeOrOnDate
SELECT sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ("sales".__time <= TIME_PARSE(?))
-- parameters: ["2026-10-01T14:59:59.999Z"]

-- afterDate
SELECT sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ("sales".__time > TIME_PARSE(?))
-- parameters: ["2026-10-01T14:59:59.999Z"]

-- afterOrOnDate
SELECT sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ("sales".__time >= TIME_PARSE(?))
-- parameters: ["2026-09-30T15:00:00.000Z"]

-- security
SELECT sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE (("sales".__time < TIME_PARSE(?)) OR ("sales".__time >= TIME_PARSE(?))) AND ("sales".__time >= TIME_PARSE(?) AND "sales".__time <= TIME_PARSE(?))
-- parameters: ["2026-09-30T15:00:00.000Z", "2026-09-30T15:00:00.000Z", "2026-09-30T15:00:00.000Z", "2026-10-31T14:59:59.999Z"]

-- rolling_tokyo
 WITH 
time_series AS (  SELECT TIME_PARSE(dates.f) date_from, TIME_PARSE(dates.t) date_to 
  FROM (VALUES
      ('2026-10-01T00:00:00.000', '2026-10-01T23:59:59.999'),
      ('2026-10-02T00:00:00.000', '2026-10-02T23:59:59.999')
  ) AS dates (f, t)),
cte_0 AS (  SELECT DATE_TRUNC('day', CAST(TIME_FORMAT("sales".__time, 'yyyy-MM-dd HH:mm:ss', 'Asia/Tokyo') AS TIMESTAMP)) "sales__sold_at_day", sum("sales".amount) "sales__amount_2d" 
  FROM  druid.sales_dtl  AS "sales"
  WHERE (CAST(TIME_FORMAT("sales".__time, 'yyyy-MM-dd HH:mm:ss', 'Asia/Tokyo') AS TIMESTAMP) >= TIME_PARSE(?) AND CAST(TIME_FORMAT("sales".__time, 'yyyy-MM-dd HH:mm:ss', 'Asia/Tokyo') AS TIMESTAMP) <= TIME_PARSE(?))
  GROUP BY 1
  ORDER BY  1  ASC),
cte_1 AS (  SELECT "time_series"."date_from" "sales__sold_at_day", "rolling"."sales__amount_2d" "sales__amount_2d" 
  FROM time_series  AS "time_series"
  LEFT JOIN (
    SELECT "time_series"."date_from" "sales__sold_at_day", sum("rolling_source"."sales__amount_2d") "sales__amount_2d" 
    FROM time_series  AS "time_series"
    INNER JOIN cte_0 AS "rolling_source" ON 1 = 1
    WHERE "rolling_source"."sales__sold_at_day" > ("time_series"."date_to" - INTERVAL '2' DAY) AND "rolling_source"."sales__sold_at_day" <= "time_series"."date_to"
    GROUP BY 1
  ) AS "rolling" ON "time_series"."date_from" = "rolling"."sales__sold_at_day")
SELECT "fk_aggregate"."sales__sold_at_day" "sales__sold_at_day", "fk_aggregate"."sales__amount_2d" "sales__amount_2d" 
FROM  cte_1  AS "fk_aggregate"
GROUP BY 1, 2
ORDER BY  1  ASC
-- parameters: ["2026-09-29T00:00:00.000", "2026-10-02T23:59:59.999"]

-- dst
SELECT DATE_TRUNC('day', CAST(TIME_FORMAT("sales".__time, 'yyyy-MM-dd HH:mm:ss', 'America/New_York') AS TIMESTAMP)) "sales__sold_at_day", sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ("sales".__time >= TIME_PARSE(?) AND "sales".__time <= TIME_PARSE(?))
GROUP BY 1
ORDER BY  1  ASC
-- parameters: ["2026-11-01T04:00:00.000Z", "2026-11-02T04:59:59.999Z"]

-- aggregates
SELECT "sales".channel_cd "sales__channel_cd", count("sales".sale_id) "sales__row_count", COUNT(DISTINCT "sales".order_no) "sales__order_count", sum("sales".amount) "sales__amount", avg("sales".amount) "sales__avg_amount", min("sales".amount) "sales__min_amount", max("sales".amount) "sales__max_amount" 
FROM  druid.sales_dtl  AS "sales"
GROUP BY 1
ORDER BY  1  ASC
-- parameters: []

-- filtered_measure_ratio_segment
SELECT "sales".channel_cd "sales__channel_cd", sum(CASE WHEN ("sales".category_cd = 'TOY') THEN "sales".amount END) "sales__toy_amount", sum("sales".amount) / NULLIF(COUNT(DISTINCT "sales".order_no), 0) "sales__amount_per_order" 
FROM  druid.sales_dtl  AS "sales"
WHERE ("sales".category_cd = 'TOY')
GROUP BY 1
ORDER BY  1  ASC
-- parameters: []

-- equals_many
SELECT sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ("sales".channel_cd IN (?, ?))
-- parameters: ["C1", "C3"]

-- notEquals
SELECT sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ("sales".region_cd <> ? OR "sales".region_cd IS NULL)
-- parameters: ["north"]

-- boolean_equals
SELECT sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE (("sales".is_valid = 1) = ?)
-- parameters: ["true"]

-- set
SELECT sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ("sales".region_cd IS NOT NULL)
-- parameters: []

-- notSet
SELECT sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ("sales".region_cd IS NULL)
-- parameters: []

-- gt
SELECT sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ("sales".qty > ?)
-- parameters: ["3"]

-- gte
SELECT sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ("sales".qty >= ?)
-- parameters: ["3"]

-- lt
SELECT sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ("sales".qty < ?)
-- parameters: ["3"]

-- lte
SELECT sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ("sales".qty <= ?)
-- parameters: ["3"]

-- contains
SELECT sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ((LOWER("sales".region_cd) LIKE CONCAT('%', LOWER(?), '%') ESCAPE '\'))
-- parameters: ["A\\%\\_\\\\B"]

-- notContains
SELECT sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ((LOWER("sales".region_cd) NOT LIKE CONCAT('%', LOWER(?), '%') ESCAPE '\') OR "sales".region_cd IS NULL)
-- parameters: ["A\\%\\_\\\\B"]

-- startsWith
SELECT sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ((LOWER("sales".region_cd) LIKE CONCAT('', LOWER(?), '%') ESCAPE '\'))
-- parameters: ["A\\%\\_\\\\B"]

-- notStartsWith
SELECT sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ((LOWER("sales".region_cd) NOT LIKE CONCAT('', LOWER(?), '%') ESCAPE '\') OR "sales".region_cd IS NULL)
-- parameters: ["A\\%\\_\\\\B"]

-- endsWith
SELECT sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ((LOWER("sales".region_cd) LIKE CONCAT('%', LOWER(?), '') ESCAPE '\'))
-- parameters: ["A\\%\\_\\\\B"]

-- notEndsWith
SELECT sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ((LOWER("sales".region_cd) NOT LIKE CONCAT('%', LOWER(?), '') ESCAPE '\') OR "sales".region_cd IS NULL)
-- parameters: ["A\\%\\_\\\\B"]

-- measure_filters
SELECT "sales".channel_cd "sales__channel_cd", sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
GROUP BY 1
HAVING (sum("sales".amount) > ?) AND (sum("sales".amount) <> ? OR sum("sales".amount) IS NULL)
ORDER BY  1  ASC
-- parameters: ["20", "110"]

-- nested_groups
SELECT sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ("sales".category_cd = ?) AND ((("sales".channel_cd = ?) AND ("sales".qty > ?)) OR ("sales".channel_cd = ?))
-- parameters: ["BOOK", "C3", "5", "C2"]

-- order_limit_offset
SELECT "sales".channel_cd "sales__channel_cd", "sales".category_cd "sales__category_cd", sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
GROUP BY 1, 2
ORDER BY  1  DESC,  2  ASC
LIMIT 2
OFFSET 1
-- parameters: []

-- page_past_last_group
SELECT "sales".channel_cd "sales__channel_cd", "sales".category_cd "sales__category_cd", sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
GROUP BY 1, 2
ORDER BY  1  DESC,  2  ASC
LIMIT 2
OFFSET 4
-- parameters: []

-- plain_range
SELECT sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ("sales".__time >= TIME_PARSE(?) AND "sales".__time <= TIME_PARSE(?))
-- parameters: ["2026-10-02T00:00:00.000Z", "2026-10-04T23:59:59.999Z"]

-- query_timezone
SELECT DATE_TRUNC('day', CAST(TIME_FORMAT("sales".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP)) "sales__sold_at_day", sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ("sales".__time >= TIME_PARSE(?) AND "sales".__time <= TIME_PARSE(?))
GROUP BY 1
ORDER BY  1  ASC
-- parameters: ["2026-10-01T00:00:00.000Z", "2026-10-01T23:59:59.999Z"]

-- filtered_source
SELECT "valid_sales".channel_cd "valid_sales__channel_cd", sum("valid_sales".amount) "valid_sales__amount" 
FROM  (SELECT channel_cd, amount FROM druid.sales_dtl WHERE is_valid = 1)  AS "valid_sales"
GROUP BY 1
ORDER BY  1  ASC
-- parameters: []

-- joined_dimension
SELECT "stores".store_name "stores__store_name", sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
LEFT JOIN  druid.dim_store  AS "stores" ON "sales".store_cd = "stores".store_cd
WHERE ("stores".store_name IN (?, ?))
GROUP BY 1
ORDER BY  1  ASC
-- parameters: ["central", "uptown"]

-- joined_one_to_one_measures
SELECT "sales".channel_cd "sales__channel_cd", sum("receipts".tax) "receipts__tax", count("receipts".receipt_no) "receipts__receipt_count", sum("receipts".tax) / NULLIF(count("receipts".receipt_no), 0) "receipts__tax_per_receipt" 
FROM  druid.sales_dtl  AS "sales"
LEFT JOIN  druid.receipt  AS "receipts" ON "sales".receipt_no = "receipts".receipt_no
GROUP BY 1
ORDER BY  1  ASC
-- parameters: []

-- joined_many_to_one_counts
SELECT "sales".category_cd "sales__category_cd", COUNT(DISTINCT "stores".store_cd) "stores__store_count", COUNT(DISTINCT "stores".store_name) "stores__name_count" 
FROM  druid.sales_dtl  AS "sales"
LEFT JOIN  druid.dim_store  AS "stores" ON "sales".store_cd = "stores".store_cd
GROUP BY 1
ORDER BY  1  ASC
-- parameters: []

-- join_reading_a_third_cube
SELECT "promos".promo_name "promos__promo_name", sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
LEFT JOIN  druid.dim_store  AS "stores" ON "sales".store_cd = "stores".store_cd
LEFT JOIN  druid.dim_region  AS "regions" ON "stores".region_cd = "regions".region_cd
LEFT JOIN  druid.promo  AS "promos" ON "sales".promo_cd = "promos".promo_cd AND "promos".region_cd = "regions".region_cd
WHERE ("promos".promo_name IS NOT NULL)
GROUP BY 1
ORDER BY  1  ASC
-- parameters: []

-- multi_fact_by_dimension
 WITH 
cte_0 AS (  SELECT "stores".store_name "stores__store_name", sum("sales".amount) "sales__amount" 
  FROM  druid.sales_dtl  AS "sales"
  LEFT JOIN  druid.dim_store  AS "stores" ON "sales".store_cd = "stores".store_cd
  WHERE ("stores".store_name IS NOT NULL)
  GROUP BY 1),
cte_1 AS (  SELECT "stores".store_name "stores__store_name", sum("refunds".amount) "refunds__amount", count("refunds".refund_id) "refunds__refund_count" 
  FROM  druid.refund_dtl  AS "refunds"
  LEFT JOIN  druid.dim_store  AS "stores" ON "refunds".store_cd = "stores".store_cd
  WHERE ("stores".store_name IS NOT NULL)
  GROUP BY 1)
SELECT "full_aggregate"."stores__store_name" "stores__store_name", "full_aggregate"."sales__amount" "sales__amount", "full_aggregate"."refunds__amount" "refunds__amount", "full_aggregate"."refunds__refund_count" "refunds__refund_count" 
FROM (SELECT COALESCE("q_l"."stores__store_name", "q_r"."stores__store_name") "stores__store_name", MAX("q_l"."sales__amount") "sales__amount", MAX("q_r"."refunds__amount") "refunds__amount", MAX("q_r"."refunds__refund_count") "refunds__refund_count" 
FROM  cte_0  AS "q_l"
FULL JOIN  cte_1  AS "q_r" ON ("q_l"."stores__store_name" = "q_r"."stores__store_name")
GROUP BY 1) AS "full_aggregate"
GROUP BY 1, 2, 3, 4
ORDER BY  1  ASC
-- parameters: []

-- multi_fact_null_key
 WITH 
cte_0 AS (  SELECT "stores".store_name "stores__store_name", sum("sales".amount) "sales__amount" 
  FROM  druid.sales_dtl  AS "sales"
  LEFT JOIN  druid.dim_store  AS "stores" ON "sales".store_cd = "stores".store_cd
  GROUP BY 1),
cte_1 AS (  SELECT "stores".store_name "stores__store_name", sum("refunds".amount) "refunds__amount" 
  FROM  druid.refund_dtl  AS "refunds"
  LEFT JOIN  druid.dim_store  AS "stores" ON "refunds".store_cd = "stores".store_cd
  GROUP BY 1),
cte_2 AS (  SELECT "stores".store_name "stores__store_name", count("visits".visit_id) "visits__visit_count" 
  FROM  druid.visit  AS "visits"
  LEFT JOIN  druid.dim_store  AS "stores" ON "visits".store_cd = "stores".store_cd
  GROUP BY 1)
SELECT "full_aggregate"."stores__store_name" "stores__store_name", "full_aggregate"."sales__amount" "sales__amount", "full_aggregate"."refunds__amount" "refunds__amount", "full_aggregate"."visits__visit_count" "visits__visit_count" 
FROM (SELECT COALESCE("q_l"."stores__store_name", "q_r"."stores__store_name") "stores__store_name", MAX("q_l"."sales__amount") "sales__amount", MAX("q_l"."refunds__amount") "refunds__amount", MAX("q_r"."visits__visit_count") "visits__visit_count" 
FROM (SELECT COALESCE("q_l"."stores__store_name", "q_r"."stores__store_name") "stores__store_name", MAX("q_l"."sales__amount") "sales__amount", MAX("q_r"."refunds__amount") "refunds__amount" 
FROM  cte_0  AS "q_l"
FULL JOIN  cte_1  AS "q_r" ON ("q_l"."stores__store_name" = "q_r"."stores__store_name")
GROUP BY 1) AS "q_l"
FULL JOIN  cte_2  AS "q_r" ON ("q_l"."stores__store_name" = "q_r"."stores__store_name")
GROUP BY 1) AS "full_aggregate"
WHERE ("full_aggregate"."visits__visit_count" > ?)
GROUP BY 1, 2, 3, 4
ORDER BY  4  DESC,  2  DESC
-- parameters: ["0"]

-- multi_fact_totals
 WITH 
cte_0 AS (  SELECT sum("sales".amount) "sales__amount" 
  FROM  druid.sales_dtl  AS "sales"),
cte_1 AS (  SELECT sum("refunds".amount) "refunds__amount" 
  FROM  druid.refund_dtl  AS "refunds")
SELECT "q_0"."sales__amount" "sales__amount", "q_1"."refunds__amount" "refunds__amount" 
FROM  cte_0  AS "q_0"
INNER JOIN  cte_1  AS "q_1" ON 1 = 1
-- parameters: []

-- multi_fact_page
 WITH 
cte_0 AS (  SELECT "stores".store_name "stores__store_name", sum("sales".amount) "sales__amount" 
  FROM  druid.sales_dtl  AS "sales"
  LEFT JOIN  druid.dim_store  AS "stores" ON "sales".store_cd = "stores".store_cd
  WHERE ("stores".store_name IS NOT NULL)
  GROUP BY 1),
cte_1 AS (  SELECT "stores".store_name "stores__store_name", sum("refunds".amount) "refunds__amount" 
  FROM  druid.refund_dtl  AS "refunds"
  LEFT JOIN  druid.dim_store  AS "stores" ON "refunds".store_cd = "stores".store_cd
  WHERE ("stores".store_name IS NOT NULL)
  GROUP BY 1)
SELECT "full_aggregate"."stores__store_name" "stores__store_name", "full_aggregate"."sales__amount" "sales__amount", "full_aggregate"."refunds__amount" "refunds__amount" 
FROM (SELECT COALESCE("q_l"."stores__store_name", "q_r"."stores__store_name") "stores__store_name", MAX("q_l"."sales__amount") "sales__amount", MAX("q_r"."refunds__amount") "refunds__amount" 
FROM  cte_0  AS "q_l"
FULL JOIN  cte_1  AS "q_r" ON ("q_l"."stores__store_name" = "q_r"."stores__store_name")
GROUP BY 1) AS "full_aggregate"
GROUP BY 1, 2, 3
ORDER BY  2  DESC
LIMIT 1
OFFSET 1
-- parameters: []

-- sum_over_repeated_rows
 WITH 
cte_0 AS (  SELECT "sales".category_cd "sales__category_cd", sum("sales".amount) "sales__amount" 
  FROM  druid.sales_dtl  AS "sales"
  GROUP BY 1),
cte_1 AS (  SELECT "keys"."sales__category_cd" "sales__category_cd", sum("stores_key_stores".floor_area) "stores__floor_area" 
  FROM (SELECT DISTINCT "stores_key_sales".category_cd "sales__category_cd", "stores_key_stores".store_cd "stores__store_cd" 
  FROM  druid.sales_dtl  AS "stores_key_sales"
  LEFT JOIN  druid.dim_store  AS "stores_key_stores" ON "stores_key_sales".store_cd = "stores_key_stores".store_cd) AS "keys"
  LEFT JOIN  druid.dim_store  AS "stores_key_stores" ON (("keys"."stores__store_cd" = "stores_key_stores".store_cd))
  GROUP BY 1)
SELECT "full_aggregate"."sales__category_cd" "sales__category_cd", "full_aggregate"."sales__amount" "sales__amount", "full_aggregate"."stores__floor_area" "stores__floor_area" 
FROM (SELECT COALESCE("q_l"."sales__category_cd", "q_r"."sales__category_cd") "sales__category_cd", MAX("q_l"."sales__amount") "sales__amount", MAX("q_r"."stores__floor_area") "stores__floor_area" 
FROM  cte_0  AS "q_l"
FULL JOIN  cte_1  AS "q_r" ON ("q_l"."sales__category_cd" = "q_r"."sales__category_cd")
GROUP BY 1) AS "full_aggregate"
GROUP BY 1, 2, 3
ORDER BY  1  ASC
-- parameters: []

-- two_cubes_in_one_select
SELECT "sales".channel_cd "sales__channel_cd", sum("sales".amount) "sales__amount", sum("receipts".tax) "receipts__tax" 
FROM  druid.sales_dtl  AS "sales"
LEFT JOIN  druid.receipt  AS "receipts" ON "sales".receipt_no = "receipts".receipt_no
GROUP BY 1
ORDER BY  1  ASC
-- parameters: []

-- security_multi_fact
 WITH 
cte_0 AS (  SELECT "stores".store_name "stores__store_name", sum("sales".amount) "sales__amount" 
  FROM  druid.sales_dtl  AS "sales"
  LEFT JOIN  druid.dim_store  AS "stores" ON "sales".store_cd = "stores".store_cd
  LEFT JOIN  druid.dim_region  AS "regions" ON "stores".region_cd = "regions".region_cd
  WHERE ("regions".region_name = ?)
  GROUP BY 1),
cte_1 AS (  SELECT "stores".store_name "stores__store_name", sum("refunds".amount) "refunds__amount" 
  FROM  druid.refund_dtl  AS "refunds"
  LEFT JOIN  druid.dim_store  AS "stores" ON "refunds".store_cd = "stores".store_cd
  LEFT JOIN  druid.dim_region  AS "regions" ON "stores".region_cd = "regions".region_cd
  WHERE ("regions".region_name = ?)
  GROUP BY 1)
SELECT "full_aggregate"."stores__store_name" "stores__store_name", "full_aggregate"."sales__amount" "sales__amount", "full_aggregate"."refunds__amount" "refunds__amount" 
FROM (SELECT COALESCE("q_l"."stores__store_name", "q_r"."stores__store_name") "stores__store_name", MAX("q_l"."sales__amount") "sales__amount", MAX("q_r"."refunds__amount") "refunds__amount" 
FROM  cte_0  AS "q_l"
FULL JOIN  cte_1  AS "q_r" ON ("q_l"."stores__store_name" = "q_r"."stores__store_name")
GROUP BY 1) AS "full_aggregate"
GROUP BY 1, 2, 3
ORDER BY  1  ASC
-- parameters: ["north", "north"]

-- security_two_hop_join
SELECT sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
LEFT JOIN  druid.dim_store  AS "stores" ON "sales".store_cd = "stores".store_cd
LEFT JOIN  druid.dim_region  AS "regions" ON "stores".region_cd = "regions".region_cd
WHERE (("sales".is_valid = 1) = ?) AND ("regions".region_name = ?)
-- parameters: ["true", "north"]

-- security_pattern
SELECT sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE (((LOWER("sales".region_cd) LIKE CONCAT('%', LOWER(?), '%') ESCAPE '\')) OR ("sales".channel_cd = ?)) AND ((LOWER("sales".region_cd) LIKE CONCAT('', LOWER(?), '%') ESCAPE '\'))
-- parameters: ["north", "C3", "a\\%"]

-- rolling_trailing
 WITH 
time_series AS (  SELECT TIME_PARSE(dates.f) date_from, TIME_PARSE(dates.t) date_to 
  FROM (VALUES
      ('2026-10-01T00:00:00.000', '2026-10-01T23:59:59.999'),
      ('2026-10-02T00:00:00.000', '2026-10-02T23:59:59.999'),
      ('2026-10-03T00:00:00.000', '2026-10-03T23:59:59.999'),
      ('2026-10-04T00:00:00.000', '2026-10-04T23:59:59.999'),
      ('2026-10-05T00:00:00.000', '2026-10-05T23:59:59.999'),
      ('2026-10-06T00:00:00.000', '2026-10-06T23:59:59.999'),
      ('2026-10-07T00:00:00.000', '2026-10-07T23:59:59.999')
  ) AS dates (f, t)),
cte_0 AS (  SELECT DATE_TRUNC('day', CAST(TIME_FORMAT("sales".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP)) "sales__sold_at_day", sum("sales".amount) "sales__amount_3d" 
  FROM  druid.sales_dtl  AS "sales"
  WHERE (CAST(TIME_FORMAT("sales".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP) >= TIME_PARSE(?) AND CAST(TIME_FORMAT("sales".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP) <= TIME_PARSE(?))
  GROUP BY 1
  ORDER BY  1  ASC),
cte_1 AS (  SELECT "time_series"."date_from" "sales__sold_at_day", "rolling"."sales__amount_3d" "sales__amount_3d" 
  FROM time_series  AS "time_series"
  LEFT JOIN (
    SELECT "time_series"."date_from" "sales__sold_at_day", sum("rolling_source"."sales__amount_3d") "sales__amount_3d" 
    FROM time_series  AS "time_series"
    INNER JOIN cte_0 AS "rolling_source" ON 1 = 1
    WHERE "rolling_source"."sales__sold_at_day" > ("time_series"."date_to" - INTERVAL '3' DAY) AND "rolling_source"."sales__sold_at_day" <= "time_series"."date_to"
    GROUP BY 1
  ) AS "rolling" ON "time_series"."date_from" = "rolling"."sales__sold_at_day")
SELECT "fk_aggregate"."sales__sold_at_day" "sales__sold_at_day", "fk_aggregate"."sales__amount_3d" "sales__amount_3d" 
FROM  cte_1  AS "fk_aggregate"
GROUP BY 1, 2
ORDER BY  1  ASC
-- parameters: ["2026-09-28T00:00:00.000", "2026-10-07T23:59:59.999"]

-- rolling_distinct_count
 WITH 
time_series AS (  SELECT TIME_PARSE(dates.f) date_from, TIME_PARSE(dates.t) date_to 
  FROM (VALUES
      ('2026-10-02T00:00:00.000', '2026-10-02T23:59:59.999'),
      ('2026-10-03T00:00:00.000', '2026-10-03T23:59:59.999')
  ) AS dates (f, t)),
cte_0 AS (  SELECT DATE_TRUNC('day', CAST(TIME_FORMAT("sales".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP)) "sales__sold_at_day", "sales".order_no "sales__orders_2d" 
  FROM  druid.sales_dtl  AS "sales"
  WHERE (CAST(TIME_FORMAT("sales".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP) >= TIME_PARSE(?) AND CAST(TIME_FORMAT("sales".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP) <= TIME_PARSE(?))
  ORDER BY  1  ASC),
cte_1 AS (  SELECT "time_series"."date_from" "sales__sold_at_day", "rolling"."sales__orders_2d" "sales__orders_2d" 
  FROM time_series  AS "time_series"
  LEFT JOIN (
    SELECT "time_series"."date_from" "sales__sold_at_day", COUNT(DISTINCT "rolling_source"."sales__orders_2d") "sales__orders_2d" 
    FROM time_series  AS "time_series"
    INNER JOIN cte_0 AS "rolling_source" ON 1 = 1
    WHERE "rolling_source"."sales__sold_at_day" > ("time_series"."date_to" - INTERVAL '2' DAY) AND "rolling_source"."sales__sold_at_day" <= "time_series"."date_to"
    GROUP BY 1
  ) AS "rolling" ON "time_series"."date_from" = "rolling"."sales__sold_at_day")
SELECT "fk_aggregate"."sales__sold_at_day" "sales__sold_at_day", "fk_aggregate"."sales__orders_2d" "sales__orders_2d" 
FROM  cte_1  AS "fk_aggregate"
GROUP BY 1, 2
ORDER BY  1  ASC
-- parameters: ["2026-09-30T00:00:00.000", "2026-10-03T23:59:59.999"]

-- month_to_date
 WITH 
time_series AS (  SELECT TIME_PARSE(dates.f) date_from, TIME_PARSE(dates.t) date_to 
  FROM (VALUES
      ('2026-10-04T00:00:00.000', '2026-10-04T23:59:59.999'),
      ('2026-10-05T00:00:00.000', '2026-10-05T23:59:59.999'),
      ('2026-10-06T00:00:00.000', '2026-10-06T23:59:59.999')
  ) AS dates (f, t)),
cte_0 AS (  SELECT DATE_TRUNC('day', CAST(TIME_FORMAT("sales".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP)) "sales__sold_at_day", sum("sales".amount) "sales__amount_mtd" 
  FROM  druid.sales_dtl  AS "sales"
  WHERE (CAST(TIME_FORMAT("sales".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP) >= TIME_PARSE(?) AND CAST(TIME_FORMAT("sales".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP) <= TIME_PARSE(?))
  GROUP BY 1
  ORDER BY  1  ASC),
cte_1 AS (  SELECT "time_series"."date_from" "sales__sold_at_day", "rolling"."sales__amount_mtd" "sales__amount_mtd" 
  FROM time_series  AS "time_series"
  LEFT JOIN (
    SELECT "time_series"."date_from" "sales__sold_at_day", sum("rolling_source"."sales__amount_mtd") "sales__amount_mtd" 
    FROM time_series  AS "time_series"
    INNER JOIN cte_0 AS "rolling_source" ON 1 = 1
    WHERE "rolling_source"."sales__sold_at_day" >= DATE_TRUNC('month', "time_series"."date_from") and "rolling_source"."sales__sold_at_day" <= "time_series"."date_to"
    GROUP BY 1
  ) AS "rolling" ON "time_series"."date_from" = "rolling"."sales__sold_at_day")
SELECT "fk_aggregate"."sales__sold_at_day" "sales__sold_at_day", "fk_aggregate"."sales__amount_mtd" "sales__amount_mtd" 
FROM  cte_1  AS "fk_aggregate"
GROUP BY 1, 2
ORDER BY  1  ASC
-- parameters: ["2026-10-01T00:00:00.000", "2026-10-06T23:59:59.999"]

-- rolling_at_range_end
 WITH 
cte_0 AS (  SELECT sum("sales".amount) "sales__amount_3d" 
  FROM  druid.sales_dtl  AS "sales"
  WHERE ("sales".__time > TIME_PARSE(?) AND "sales".__time <= TIME_PARSE(?)))
SELECT "fk_aggregate"."sales__amount_3d" "sales__amount_3d" 
FROM  cte_0  AS "fk_aggregate"
-- parameters: ["2026-10-01T23:59:59.999Z", "2026-10-04T23:59:59.999Z"]

-- running_total_by_month
 WITH 
time_series AS (  SELECT TIME_PARSE(dates.f) date_from, TIME_PARSE(dates.t) date_to 
  FROM (VALUES
      ('2026-09-01T00:00:00.000', '2026-09-30T23:59:59.999'),
      ('2026-10-01T00:00:00.000', '2026-10-31T23:59:59.999'),
      ('2026-11-01T00:00:00.000', '2026-11-30T23:59:59.999')
  ) AS dates (f, t)),
cte_0 AS (  SELECT DATE_TRUNC('month', CAST(TIME_FORMAT("sales".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP)) "sales__sold_at_month", sum("sales".amount) "sales__amount_so_far" 
  FROM  druid.sales_dtl  AS "sales"
  WHERE (CAST(TIME_FORMAT("sales".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP) <= TIME_PARSE(?))
  GROUP BY 1
  ORDER BY  1  ASC),
cte_1 AS (  SELECT "time_series"."date_from" "sales__sold_at_month", "rolling"."sales__amount_so_far" "sales__amount_so_far" 
  FROM time_series  AS "time_series"
  LEFT JOIN (
    SELECT "time_series"."date_from" "sales__sold_at_month", sum("rolling_source"."sales__amount_so_far") "sales__amount_so_far" 
    FROM time_series  AS "time_series"
    INNER JOIN cte_0 AS "rolling_source" ON 1 = 1
    WHERE "rolling_source"."sales__sold_at_month" <= "time_series"."date_to"
    GROUP BY 1
  ) AS "rolling" ON "time_series"."date_from" = "rolling"."sales__sold_at_month")
SELECT "fk_aggregate"."sales__sold_at_month" "sales__sold_at_month", "fk_aggregate"."sales__amount_so_far" "sales__amount_so_far" 
FROM  cte_1  AS "fk_aggregate"
GROUP BY 1, 2
ORDER BY  1  ASC
-- parameters: ["2026-11-30T23:59:59.999"]

-- prior_day
 WITH 
cte_0 AS (  SELECT DATE_TRUNC('day', CAST(TIME_FORMAT((("sales".__time + INTERVAL '1' DAY)), 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP)) "sales__sold_at_day", sum("sales".amount) "sales__amount" 
  FROM  druid.sales_dtl  AS "sales"
  WHERE ((("sales".__time + INTERVAL '1' DAY)) >= TIME_PARSE(?) AND (("sales".__time + INTERVAL '1' DAY)) <= TIME_PARSE(?))
  GROUP BY 1
  ORDER BY  1  ASC),
cte_1 AS (  SELECT "fk_aggregate"."sales__sold_at_day" "sales__sold_at_day", "fk_aggregate"."sales__amount" "sales__amount_prior_day" 
  FROM  cte_0  AS "fk_aggregate"),
cte_2 AS (  SELECT DATE_TRUNC('day', CAST(TIME_FORMAT("sales".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP)) "sales__sold_at_day", sum("sales".amount) "sales__amount" 
  FROM  druid.sales_dtl  AS "sales"
  WHERE ("sales".__time >= TIME_PARSE(?) AND "sales".__time <= TIME_PARSE(?))
  GROUP BY 1)
SELECT "full_aggregate"."sales__sold_at_day" "sales__sold_at_day", "full_aggregate"."sales__amount" "sales__amount", "full_aggregate"."sales__amount_prior_day" "sales__amount_prior_day" 
FROM (SELECT COALESCE("q_l"."sales__sold_at_day", "q_r"."sales__sold_at_day") "sales__sold_at_day", MAX("q_l"."sales__amount_prior_day") "sales__amount_prior_day", MAX("q_r"."sales__amount") "sales__amount" 
FROM  cte_1  AS "q_l"
FULL JOIN  cte_2  AS "q_r" ON ("q_l"."sales__sold_at_day" = "q_r"."sales__sold_at_day")
GROUP BY 1) AS "full_aggregate"
GROUP BY 1, 2, 3
ORDER BY  1  ASC
-- parameters: ["2026-10-02T00:00:00.000Z", "2026-10-04T23:59:59.999Z", "2026-10-02T00:00:00.000Z", "2026-10-04T23:59:59.999Z"]

-- change_from_prior_day
 WITH 
cte_0 AS (  SELECT DATE_TRUNC('day', CAST(TIME_FORMAT("sales".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP)) "sales__sold_at_day", sum("sales".amount) "sales__amount" 
  FROM  druid.sales_dtl  AS "sales"
  WHERE ("sales".__time >= TIME_PARSE(?) AND "sales".__time <= TIME_PARSE(?))
  GROUP BY 1
  ORDER BY  1  ASC),
cte_1 AS (  SELECT DATE_TRUNC('day', CAST(TIME_FORMAT((("sales".__time + INTERVAL '1' DAY)), 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP)) "sales__sold_at_day", sum("sales".amount) "sales__amount" 
  FROM  druid.sales_dtl  AS "sales"
  WHERE ((("sales".__time + INTERVAL '1' DAY)) >= TIME_PARSE(?) AND (("sales".__time + INTERVAL '1' DAY)) <= TIME_PARSE(?))
  GROUP BY 1
  ORDER BY  1  ASC),
cte_2 AS (  SELECT "fk_aggregate"."sales__sold_at_day" "sales__sold_at_day", "fk_aggregate"."sales__amount" "sales__amount_prior_day" 
  FROM  cte_1  AS "fk_aggregate"),
cte_3 AS (  SELECT "full_aggregate"."sales__sold_at_day" "sales__sold_at_day", "full_aggregate"."sales__amount" - "full_aggregate"."sales__amount_prior_day" "sales__amount_change" 
  FROM (SELECT COALESCE("q_l"."sales__sold_at_day", "q_r"."sales__sold_at_day") "sales__sold_at_day", MAX("q_l"."sales__amount") "sales__amount", MAX("q_r"."sales__amount_prior_day") "sales__amount_prior_day" 
  FROM  cte_0  AS "q_l"
  FULL JOIN  cte_2  AS "q_r" ON ("q_l"."sales__sold_at_day" = "q_r"."sales__sold_at_day")
  GROUP BY 1) AS "full_aggregate")
SELECT "fk_aggregate"."sales__sold_at_day" "sales__sold_at_day", "fk_aggregate"."sales__amount_change" "sales__amount_change" 
FROM  cte_3  AS "fk_aggregate"
GROUP BY 1, 2
ORDER BY  1  ASC
-- parameters: ["2026-10-02T00:00:00.000Z", "2026-10-04T23:59:59.999Z", "2026-10-02T00:00:00.000Z", "2026-10-04T23:59:59.999Z"]

-- security_rolling
 WITH 
time_series AS (  SELECT TIME_PARSE(dates.f) date_from, TIME_PARSE(dates.t) date_to 
  FROM (VALUES
      ('2026-10-01T00:00:00.000', '2026-10-01T23:59:59.999'),
      ('2026-10-02T00:00:00.000', '2026-10-02T23:59:59.999'),
      ('2026-10-03T00:00:00.000', '2026-10-03T23:59:59.999')
  ) AS dates (f, t)),
cte_0 AS (  SELECT DATE_TRUNC('day', CAST(TIME_FORMAT("sales".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP)) "sales__sold_at_day", sum("sales".amount) "sales__amount_3d" 
  FROM  druid.sales_dtl  AS "sales"
  WHERE (CAST(TIME_FORMAT("sales".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP) >= TIME_PARSE(?) AND CAST(TIME_FORMAT("sales".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP) <= TIME_PARSE(?)) AND ("sales".channel_cd = ?)
  GROUP BY 1
  ORDER BY  1  ASC),
cte_1 AS (  SELECT "time_series"."date_from" "sales__sold_at_day", "rolling"."sales__amount_3d" "sales__amount_3d" 
  FROM time_series  AS "time_series"
  LEFT JOIN (
    SELECT "time_series"."date_from" "sales__sold_at_day", sum("rolling_source"."sales__amount_3d") "sales__amount_3d" 
    FROM time_series  AS "time_series"
    INNER JOIN cte_0 AS "rolling_source" ON 1 = 1
    WHERE "rolling_source"."sales__sold_at_day" > ("time_series"."date_to" - INTERVAL '3' DAY) AND "rolling_source"."sales__sold_at_day" <= "time_series"."date_to"
    GROUP BY 1
  ) AS "rolling" ON "time_series"."date_from" = "rolling"."sales__sold_at_day")
SELECT "fk_aggregate"."sales__sold_at_day" "sales__sold_at_day", "fk_aggregate"."sales__amount_3d" "sales__amount_3d" 
FROM  cte_1  AS "fk_aggregate"
GROUP BY 1, 2
ORDER BY  1  ASC
-- parameters: ["2026-09-28T00:00:00.000", "2026-10-03T23:59:59.999", "C1"]

-- approximate_distinct_count
SELECT "sales".channel_cd "sales__channel_cd", APPROX_COUNT_DISTINCT("sales".order_no) "sales__order_count_approx" 
FROM  druid.sales_dtl  AS "sales"
GROUP BY 1
ORDER BY  1  ASC
-- parameters: []

-- granularity_of_two_days
SELECT TIME_FLOOR(CAST(TIME_FORMAT("sales".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP), 'P2D', TIME_PARSE('2026-10-01T00:00:00.000')) "sales__sold_at_two_days", sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ("sales".__time >= TIME_PARSE(?) AND "sales".__time <= TIME_PARSE(?))
GROUP BY 1
ORDER BY  1  ASC
-- parameters: ["2026-10-01T00:00:00.000Z", "2026-10-31T23:59:59.999Z"]

-- granularity_of_two_quarters
SELECT TIME_FLOOR(CAST(TIME_FORMAT("sales".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP), 'P6M', TIME_PARSE('2026-01-01T00:00:00.000')) "sales__sold_at_half_year", sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ("sales".__time >= TIME_PARSE(?) AND "sales".__time <= TIME_PARSE(?))
GROUP BY 1
ORDER BY  1  ASC
-- parameters: ["2026-10-01T00:00:00.000Z", "2026-10-31T23:59:59.999Z"]

-- granularity_with_offset
SELECT (DATE_TRUNC('week', (CAST(TIME_FORMAT("sales".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP) - INTERVAL '3' DAY)) + INTERVAL '3' DAY) "sales__sold_at_retail_week", sum("sales".amount) "sales__amount" 
FROM  druid.sales_dtl  AS "sales"
WHERE ("sales".__time >= TIME_PARSE(?) AND "sales".__time <= TIME_PARSE(?))
GROUP BY 1
ORDER BY  1  ASC
-- parameters: ["2026-10-01T00:00:00.000Z", "2026-10-31T23:59:59.999Z"]

-- view_by_joined_dimension
SELECT "stores".store_name "sales_overview__stores_store_name", sum("sales".amount) "sales_overview__amount" 
FROM  druid.sales_dtl  AS "sales"
LEFT JOIN  druid.dim_store  AS "stores" ON "sales".store_cd = "stores".store_cd
GROUP BY 1
ORDER BY  1  ASC
-- parameters: []

-- view_two_hops_filtered
SELECT "regions".region_name "sales_overview__region_name", sum("sales".amount) "sales_overview__amount", count("sales".sale_id) "sales_overview__row_count" 
FROM  druid.sales_dtl  AS "sales"
LEFT JOIN  druid.dim_store  AS "stores" ON "sales".store_cd = "stores".store_cd
LEFT JOIN  druid.dim_region  AS "regions" ON "stores".region_cd = "regions".region_cd
WHERE ("sales".channel_cd IN (?, ?))
GROUP BY 1
ORDER BY  1  ASC
-- parameters: ["C1", "C2"]

-- view_sum_over_repeated_rows
 WITH 
cte_0 AS (  SELECT "sales".channel_cd "sales_overview__channel_cd", sum("sales".amount) "sales__amount" 
  FROM  druid.sales_dtl  AS "sales"
  GROUP BY 1),
cte_1 AS (  SELECT "keys"."sales_overview__channel_cd" "sales_overview__channel_cd", sum("stores_key_stores".floor_area) "stores__floor_area" 
  FROM (SELECT DISTINCT "stores_key_sales".channel_cd "sales_overview__channel_cd", "stores_key_stores".store_cd "stores__store_cd" 
  FROM  druid.sales_dtl  AS "stores_key_sales"
  LEFT JOIN  druid.dim_store  AS "stores_key_stores" ON "stores_key_sales".store_cd = "stores_key_stores".store_cd) AS "keys"
  LEFT JOIN  druid.dim_store  AS "stores_key_stores" ON (("keys"."stores__store_cd" = "stores_key_stores".store_cd))
  GROUP BY 1)
SELECT "full_aggregate"."sales_overview__channel_cd" "sales_overview__channel_cd", "full_aggregate"."sales__amount" "sales_overview__amount", "full_aggregate"."stores__floor_area" "sales_overview__stores_floor_area" 
FROM (SELECT COALESCE("q_l"."sales_overview__channel_cd", "q_r"."sales_overview__channel_cd") "sales_overview__channel_cd", MAX("q_l"."sales__amount") "sales__amount", MAX("q_r"."stores__floor_area") "stores__floor_area" 
FROM  cte_0  AS "q_l"
FULL JOIN  cte_1  AS "q_r" ON ("q_l"."sales_overview__channel_cd" = "q_r"."sales_overview__channel_cd")
GROUP BY 1) AS "full_aggregate"
GROUP BY 1, 2, 3
ORDER BY  1  ASC
-- parameters: []

-- view_formula_and_one_to_one
 WITH 
cte_0 AS (  SELECT "sales".channel_cd "sales_overview__channel_cd", sum("sales".amount) / NULLIF(COUNT(DISTINCT "sales".order_no), 0) "sales__amount_per_order" 
  FROM  druid.sales_dtl  AS "sales"
  GROUP BY 1),
cte_1 AS (  SELECT "sales".channel_cd "sales_overview__channel_cd", sum("receipts".tax) "receipts__tax" 
  FROM  druid.sales_dtl  AS "sales"
  LEFT JOIN  druid.receipt  AS "receipts" ON "sales".receipt_no = "receipts".receipt_no
  GROUP BY 1)
SELECT "full_aggregate"."sales_overview__channel_cd" "sales_overview__channel_cd", "full_aggregate"."sales__amount_per_order" "sales_overview__amount_per_order", "full_aggregate"."receipts__tax" "sales_overview__tax" 
FROM (SELECT COALESCE("q_l"."sales_overview__channel_cd", "q_r"."sales_overview__channel_cd") "sales_overview__channel_cd", MAX("q_l"."sales__amount_per_order") "sales__amount_per_order", MAX("q_r"."receipts__tax") "receipts__tax" 
FROM  cte_0  AS "q_l"
FULL JOIN  cte_1  AS "q_r" ON ("q_l"."sales_overview__channel_cd" = "q_r"."sales_overview__channel_cd")
GROUP BY 1) AS "full_aggregate"
GROUP BY 1, 2, 3
ORDER BY  1  ASC
-- parameters: []

-- security_view
SELECT "stores".store_name "sales_overview__stores_store_name", sum("sales".amount) "sales_overview__amount" 
FROM  druid.sales_dtl  AS "sales"
LEFT JOIN  druid.dim_store  AS "stores" ON "sales".store_cd = "stores".store_cd
LEFT JOIN  druid.dim_region  AS "regions" ON "stores".region_cd = "regions".region_cd
WHERE ("regions".region_name = ?)
GROUP BY 1
ORDER BY  1  ASC
-- parameters: ["north"]

-- uw_renewal_share_by_branch
SELECT "branches".branch_name "branches__branch_name", CAST(count(CASE WHEN ("policies".renewal_of IS NOT NULL) THEN "policies".policy_id END) AS DOUBLE) / NULLIF(count("policies".policy_id), 0) "policies__renewal_share", count(CASE WHEN ("policies".renewal_of IS NOT NULL) THEN "policies".policy_id END) "policies__renewed_count", count("policies".policy_id) "policies__policy_count" 
FROM  druid.ins_policy  AS "policies"
LEFT JOIN  druid.ins_branch  AS "branches" ON "policies".branch_cd = "branches".branch_cd
GROUP BY 1
ORDER BY  1  ASC
-- parameters: []

-- uw_premium_ytd_by_month
 WITH 
time_series AS (  SELECT TIME_PARSE(dates.f) date_from, TIME_PARSE(dates.t) date_to 
  FROM (VALUES
      ('2026-01-01T00:00:00.000', '2026-01-31T23:59:59.999'),
      ('2026-02-01T00:00:00.000', '2026-02-28T23:59:59.999'),
      ('2026-03-01T00:00:00.000', '2026-03-31T23:59:59.999'),
      ('2026-04-01T00:00:00.000', '2026-04-30T23:59:59.999'),
      ('2026-05-01T00:00:00.000', '2026-05-31T23:59:59.999'),
      ('2026-06-01T00:00:00.000', '2026-06-30T23:59:59.999')
  ) AS dates (f, t)),
cte_0 AS (  SELECT DATE_TRUNC('month', CAST(TIME_FORMAT("policies".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP)) "policies__issued_at_month", sum("policies".written_premium) "policies__written_premium_ytd" 
  FROM  druid.ins_policy  AS "policies"
  WHERE (CAST(TIME_FORMAT("policies".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP) >= TIME_PARSE(?) AND CAST(TIME_FORMAT("policies".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP) <= TIME_PARSE(?))
  GROUP BY 1
  ORDER BY  1  ASC),
cte_1 AS (  SELECT "time_series"."date_from" "policies__issued_at_month", "rolling"."policies__written_premium_ytd" "policies__written_premium_ytd" 
  FROM time_series  AS "time_series"
  LEFT JOIN (
    SELECT "time_series"."date_from" "policies__issued_at_month", sum("rolling_source"."policies__written_premium_ytd") "policies__written_premium_ytd" 
    FROM time_series  AS "time_series"
    INNER JOIN cte_0 AS "rolling_source" ON 1 = 1
    WHERE "rolling_source"."policies__issued_at_month" >= DATE_TRUNC('year', "time_series"."date_from") and "rolling_source"."policies__issued_at_month" <= "time_series"."date_to"
    GROUP BY 1
  ) AS "rolling" ON "time_series"."date_from" = "rolling"."policies__issued_at_month"),
cte_2 AS (  SELECT DATE_TRUNC('month', CAST(TIME_FORMAT("policies".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP)) "policies__issued_at_month", sum("policies".written_premium) "policies__written_premium" 
  FROM  druid.ins_policy  AS "policies"
  WHERE ("policies".__time >= TIME_PARSE(?) AND "policies".__time <= TIME_PARSE(?))
  GROUP BY 1)
SELECT "full_aggregate"."policies__issued_at_month" "policies__issued_at_month", "full_aggregate"."policies__written_premium" "policies__written_premium", "full_aggregate"."policies__written_premium_ytd" "policies__written_premium_ytd" 
FROM (SELECT COALESCE("q_l"."policies__issued_at_month", "q_r"."policies__issued_at_month") "policies__issued_at_month", MAX("q_l"."policies__written_premium_ytd") "policies__written_premium_ytd", MAX("q_r"."policies__written_premium") "policies__written_premium" 
FROM  cte_1  AS "q_l"
FULL JOIN  cte_2  AS "q_r" ON ("q_l"."policies__issued_at_month" = "q_r"."policies__issued_at_month")
GROUP BY 1) AS "full_aggregate"
GROUP BY 1, 2, 3
ORDER BY  1  ASC
-- parameters: ["2026-01-01T00:00:00.000", "2026-06-30T23:59:59.999", "2026-01-01T00:00:00.000Z", "2026-06-30T23:59:59.999Z"]

-- uw_by_underwriting_year
SELECT (DATE_TRUNC('year', (CAST(TIME_FORMAT("policies".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP) - INTERVAL '3' MONTH)) + INTERVAL '3' MONTH) "policies__issued_at_underwriting_year", sum("policies".written_premium) "policies__written_premium" 
FROM  druid.ins_policy  AS "policies"
WHERE ("policies".__time >= TIME_PARSE(?) AND "policies".__time <= TIME_PARSE(?))
GROUP BY 1
ORDER BY  1  ASC
-- parameters: ["2025-01-01T00:00:00.000Z", "2026-12-31T23:59:59.999Z"]

-- ep_rolling_12m_by_month
 WITH 
time_series AS (  SELECT TIME_PARSE(dates.f) date_from, TIME_PARSE(dates.t) date_to 
  FROM (VALUES
      ('2026-01-01T00:00:00.000', '2026-01-31T23:59:59.999'),
      ('2026-02-01T00:00:00.000', '2026-02-28T23:59:59.999'),
      ('2026-03-01T00:00:00.000', '2026-03-31T23:59:59.999'),
      ('2026-04-01T00:00:00.000', '2026-04-30T23:59:59.999'),
      ('2026-05-01T00:00:00.000', '2026-05-31T23:59:59.999'),
      ('2026-06-01T00:00:00.000', '2026-06-30T23:59:59.999')
  ) AS dates (f, t)),
cte_0 AS (  SELECT DATE_TRUNC('month', CAST(TIME_FORMAT("earned_premiums".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP)) "earned_premiums__earned_month_month", sum("earned_premiums".earned_premium) "earned_premiums__earned_premium_12m" 
  FROM  druid.ins_earned_premium  AS "earned_premiums"
  WHERE (CAST(TIME_FORMAT("earned_premiums".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP) >= TIME_PARSE(?) AND CAST(TIME_FORMAT("earned_premiums".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP) <= TIME_PARSE(?))
  GROUP BY 1
  ORDER BY  1  ASC),
cte_1 AS (  SELECT "time_series"."date_from" "earned_premiums__earned_month_month", "rolling"."earned_premiums__earned_premium_12m" "earned_premiums__earned_premium_12m" 
  FROM time_series  AS "time_series"
  LEFT JOIN (
    SELECT "time_series"."date_from" "earned_premiums__earned_month_month", sum("rolling_source"."earned_premiums__earned_premium_12m") "earned_premiums__earned_premium_12m" 
    FROM time_series  AS "time_series"
    INNER JOIN cte_0 AS "rolling_source" ON 1 = 1
    WHERE "rolling_source"."earned_premiums__earned_month_month" > ("time_series"."date_to" - INTERVAL '12' MONTH) AND "rolling_source"."earned_premiums__earned_month_month" <= "time_series"."date_to"
    GROUP BY 1
  ) AS "rolling" ON "time_series"."date_from" = "rolling"."earned_premiums__earned_month_month")
SELECT "fk_aggregate"."earned_premiums__earned_month_month" "earned_premiums__earned_month_month", "fk_aggregate"."earned_premiums__earned_premium_12m" "earned_premiums__earned_premium_12m" 
FROM  cte_1  AS "fk_aggregate"
GROUP BY 1, 2
ORDER BY  1  ASC
-- parameters: ["2025-01-01T00:00:00.000", "2026-06-30T23:59:59.999"]

-- ep_written_vs_earned_by_line
 WITH 
cte_0 AS (  SELECT "products".line_of_business "products__line_of_business", sum("policies".written_premium) "policies__written_premium" 
  FROM  druid.ins_policy  AS "policies"
  LEFT JOIN  druid.ins_product  AS "products" ON "policies".product_cd = "products".product_cd
  GROUP BY 1),
cte_1 AS (  SELECT "products".line_of_business "products__line_of_business", sum("earned_premiums".earned_premium) "earned_premiums__earned_premium" 
  FROM  druid.ins_earned_premium  AS "earned_premiums"
  LEFT JOIN  druid.ins_policy  AS "policies" ON "earned_premiums".policy_id = "policies".policy_id
  LEFT JOIN  druid.ins_product  AS "products" ON "policies".product_cd = "products".product_cd
  GROUP BY 1)
SELECT "full_aggregate"."products__line_of_business" "products__line_of_business", "full_aggregate"."policies__written_premium" "policies__written_premium", "full_aggregate"."earned_premiums__earned_premium" "earned_premiums__earned_premium" 
FROM (SELECT COALESCE("q_l"."products__line_of_business", "q_r"."products__line_of_business") "products__line_of_business", MAX("q_l"."policies__written_premium") "policies__written_premium", MAX("q_r"."earned_premiums__earned_premium") "earned_premiums__earned_premium" 
FROM  cte_0  AS "q_l"
FULL JOIN  cte_1  AS "q_r" ON ("q_l"."products__line_of_business" = "q_r"."products__line_of_business")
GROUP BY 1) AS "full_aggregate"
GROUP BY 1, 2, 3
ORDER BY  1  ASC
-- parameters: []

-- cl_counts_by_cause
SELECT "claims".cause_cd "claims__cause_cd", count("claims".claim_id) "claims__claim_count", count(CASE WHEN ("claims".status = 'OPEN') THEN "claims".claim_id END) "claims__open_count", avg("claims".report_lag_days) "claims__avg_report_lag_days", max("claims".report_lag_days) "claims__max_report_lag_days" 
FROM  druid.ins_claim  AS "claims"
GROUP BY 1
ORDER BY  1  ASC
-- parameters: []

-- cl_outstanding_by_line
SELECT "products".line_of_business "products__line_of_business", count("claims".claim_id) "claims__claim_count", sum("claim_reserves".outstanding) "claim_reserves__outstanding", sum("claim_reserves".outstanding) / NULLIF(count("claims".claim_id), 0) "claims__avg_outstanding" 
FROM  druid.ins_claim  AS "claims"
LEFT JOIN  druid.ins_policy  AS "policies" ON "claims".policy_id = "policies".policy_id
LEFT JOIN  druid.ins_product  AS "products" ON "policies".product_cd = "products".product_cd
LEFT JOIN  druid.ins_claim_reserve  AS "claim_reserves" ON "claims".claim_id = "claim_reserves".claim_id
GROUP BY 1
ORDER BY  1  ASC
-- parameters: []

-- cl_paid_and_outstanding_by_line
 WITH 
cte_0 AS (  SELECT "products".line_of_business "products__line_of_business", sum("claim_payments".paid_amount) "claim_payments__paid_amount" 
  FROM  druid.ins_claim_payment  AS "claim_payments"
  LEFT JOIN  druid.ins_claim  AS "claims" ON "claim_payments".claim_id = "claims".claim_id
  LEFT JOIN  druid.ins_policy  AS "policies" ON "claims".policy_id = "policies".policy_id
  LEFT JOIN  druid.ins_product  AS "products" ON "policies".product_cd = "products".product_cd
  GROUP BY 1),
cte_1 AS (  SELECT "keys"."products__line_of_business" "products__line_of_business", sum("claim_reserves_key_claim_reserves".outstanding) "claim_reserves__outstanding" 
  FROM (SELECT DISTINCT "claim_reserves_key_products".line_of_business "products__line_of_business", "claim_reserves_key_claim_reserves".claim_id "claim_reserves__claim_id" 
  FROM  druid.ins_claim_payment  AS "claim_reserves_key_claim_payments"
  LEFT JOIN  druid.ins_claim  AS "claim_reserves_key_claims" ON "claim_reserves_key_claim_payments".claim_id = "claim_reserves_key_claims".claim_id
  LEFT JOIN  druid.ins_policy  AS "claim_reserves_key_policies" ON "claim_reserves_key_claims".policy_id = "claim_reserves_key_policies".policy_id
  LEFT JOIN  druid.ins_product  AS "claim_reserves_key_products" ON "claim_reserves_key_policies".product_cd = "claim_reserves_key_products".product_cd
  LEFT JOIN  druid.ins_claim_reserve  AS "claim_reserves_key_claim_reserves" ON "claim_reserves_key_claims".claim_id = "claim_reserves_key_claim_reserves".claim_id) AS "keys"
  LEFT JOIN  druid.ins_claim_reserve  AS "claim_reserves_key_claim_reserves" ON (("keys"."claim_reserves__claim_id" = "claim_reserves_key_claim_reserves".claim_id))
  GROUP BY 1)
SELECT "full_aggregate"."products__line_of_business" "products__line_of_business", "full_aggregate"."claim_payments__paid_amount" "claim_payments__paid_amount", "full_aggregate"."claim_reserves__outstanding" "claim_reserves__outstanding" 
FROM (SELECT COALESCE("q_l"."products__line_of_business", "q_r"."products__line_of_business") "products__line_of_business", MAX("q_l"."claim_payments__paid_amount") "claim_payments__paid_amount", MAX("q_r"."claim_reserves__outstanding") "claim_reserves__outstanding" 
FROM  cte_0  AS "q_l"
FULL JOIN  cte_1  AS "q_r" ON ("q_l"."products__line_of_business" = "q_r"."products__line_of_business")
GROUP BY 1) AS "full_aggregate"
GROUP BY 1, 2, 3
ORDER BY  1  ASC
-- parameters: []

-- cl_development_triangle
SELECT DATE_TRUNC('year', CAST(TIME_FORMAT("claims".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP)) "claims__loss_at_year", DATE_TRUNC('year', CAST(TIME_FORMAT("claim_payments".__time, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS TIMESTAMP)) "claim_payments__paid_at_year", sum("claim_payments".paid_amount) "claim_payments__paid_amount" 
FROM  druid.ins_claim_payment  AS "claim_payments"
LEFT JOIN  druid.ins_claim  AS "claims" ON "claim_payments".claim_id = "claims".claim_id
GROUP BY 1, 2
ORDER BY  1  ASC,  2  ASC
-- parameters: []

-- x_premium_paid_by_line
 WITH 
cte_0 AS (  SELECT "products".line_of_business "products__line_of_business", sum("earned_premiums".earned_premium) "earned_premiums__earned_premium" 
  FROM  druid.ins_earned_premium  AS "earned_premiums"
  LEFT JOIN  druid.ins_policy  AS "policies" ON "earned_premiums".policy_id = "policies".policy_id
  LEFT JOIN  druid.ins_product  AS "products" ON "policies".product_cd = "products".product_cd
  GROUP BY 1),
cte_1 AS (  SELECT "products".line_of_business "products__line_of_business", sum("claim_payments".paid_amount) "claim_payments__paid_amount" 
  FROM  druid.ins_claim_payment  AS "claim_payments"
  LEFT JOIN  druid.ins_claim  AS "claims" ON "claim_payments".claim_id = "claims".claim_id
  LEFT JOIN  druid.ins_policy  AS "policies" ON "claims".policy_id = "policies".policy_id
  LEFT JOIN  druid.ins_product  AS "products" ON "policies".product_cd = "products".product_cd
  GROUP BY 1),
cte_2 AS (  SELECT "products".line_of_business "products__line_of_business", count("claims".claim_id) "claims__claim_count" 
  FROM  druid.ins_claim  AS "claims"
  LEFT JOIN  druid.ins_policy  AS "policies" ON "claims".policy_id = "policies".policy_id
  LEFT JOIN  druid.ins_product  AS "products" ON "policies".product_cd = "products".product_cd
  GROUP BY 1)
SELECT "full_aggregate"."products__line_of_business" "products__line_of_business", "full_aggregate"."earned_premiums__earned_premium" "earned_premiums__earned_premium", "full_aggregate"."claim_payments__paid_amount" "claim_payments__paid_amount", "full_aggregate"."claims__claim_count" "claims__claim_count" 
FROM (SELECT COALESCE("q_l"."products__line_of_business", "q_r"."products__line_of_business") "products__line_of_business", MAX("q_l"."earned_premiums__earned_premium") "earned_premiums__earned_premium", MAX("q_l"."claim_payments__paid_amount") "claim_payments__paid_amount", MAX("q_r"."claims__claim_count") "claims__claim_count" 
FROM (SELECT COALESCE("q_l"."products__line_of_business", "q_r"."products__line_of_business") "products__line_of_business", MAX("q_l"."earned_premiums__earned_premium") "earned_premiums__earned_premium", MAX("q_r"."claim_payments__paid_amount") "claim_payments__paid_amount" 
FROM  cte_0  AS "q_l"
FULL JOIN  cte_1  AS "q_r" ON ("q_l"."products__line_of_business" = "q_r"."products__line_of_business")
GROUP BY 1) AS "q_l"
FULL JOIN  cte_2  AS "q_r" ON ("q_l"."products__line_of_business" = "q_r"."products__line_of_business")
GROUP BY 1) AS "full_aggregate"
GROUP BY 1, 2, 3, 4
ORDER BY  1  ASC
-- parameters: []

-- x_premium_paid_ceded_by_region
 WITH 
cte_0 AS (  SELECT "branches".region_name "branches__region_name", sum("policies".written_premium) "policies__written_premium" 
  FROM  druid.ins_policy  AS "policies"
  LEFT JOIN  druid.ins_branch  AS "branches" ON "policies".branch_cd = "branches".branch_cd
  LEFT JOIN  druid.ins_product  AS "products" ON "policies".product_cd = "products".product_cd
  WHERE ("products".line_of_business = ?)
  GROUP BY 1),
cte_1 AS (  SELECT "branches".region_name "branches__region_name", sum("cessions".ceded_premium) "cessions__ceded_premium" 
  FROM  druid.ins_cession  AS "cessions"
  LEFT JOIN  druid.ins_policy  AS "policies" ON "cessions".policy_id = "policies".policy_id
  LEFT JOIN  druid.ins_branch  AS "branches" ON "policies".branch_cd = "branches".branch_cd
  LEFT JOIN  druid.ins_product  AS "products" ON "policies".product_cd = "products".product_cd
  WHERE ("products".line_of_business = ?)
  GROUP BY 1),
cte_2 AS (  SELECT "branches".region_name "branches__region_name", sum("claim_payments".paid_amount) "claim_payments__paid_amount" 
  FROM  druid.ins_claim_payment  AS "claim_payments"
  LEFT JOIN  druid.ins_claim  AS "claims" ON "claim_payments".claim_id = "claims".claim_id
  LEFT JOIN  druid.ins_policy  AS "policies" ON "claims".policy_id = "policies".policy_id
  LEFT JOIN  druid.ins_branch  AS "branches" ON "policies".branch_cd = "branches".branch_cd
  LEFT JOIN  druid.ins_product  AS "products" ON "policies".product_cd = "products".product_cd
  WHERE ("products".line_of_business = ?)
  GROUP BY 1)
SELECT "full_aggregate"."branches__region_name" "branches__region_name", "full_aggregate"."policies__written_premium" "policies__written_premium", "full_aggregate"."cessions__ceded_premium" "cessions__ceded_premium", "full_aggregate"."claim_payments__paid_amount" "claim_payments__paid_amount" 
FROM (SELECT COALESCE("q_l"."branches__region_name", "q_r"."branches__region_name") "branches__region_name", MAX("q_l"."policies__written_premium") "policies__written_premium", MAX("q_l"."cessions__ceded_premium") "cessions__ceded_premium", MAX("q_r"."claim_payments__paid_amount") "claim_payments__paid_amount" 
FROM (SELECT COALESCE("q_l"."branches__region_name", "q_r"."branches__region_name") "branches__region_name", MAX("q_l"."policies__written_premium") "policies__written_premium", MAX("q_r"."cessions__ceded_premium") "cessions__ceded_premium" 
FROM  cte_0  AS "q_l"
FULL JOIN  cte_1  AS "q_r" ON ("q_l"."branches__region_name" = "q_r"."branches__region_name")
GROUP BY 1) AS "q_l"
FULL JOIN  cte_2  AS "q_r" ON ("q_l"."branches__region_name" = "q_r"."branches__region_name")
GROUP BY 1) AS "full_aggregate"
GROUP BY 1, 2, 3, 4
ORDER BY  1  ASC
-- parameters: ["MOTOR", "MOTOR", "MOTOR"]

-- x_totals
 WITH 
cte_0 AS (  SELECT sum("policies".written_premium) "policies__written_premium" 
  FROM  druid.ins_policy  AS "policies"),
cte_1 AS (  SELECT sum("earned_premiums".earned_premium) "earned_premiums__earned_premium" 
  FROM  druid.ins_earned_premium  AS "earned_premiums"),
cte_2 AS (  SELECT sum("claim_payments".paid_amount) "claim_payments__paid_amount" 
  FROM  druid.ins_claim_payment  AS "claim_payments"),
cte_3 AS (  SELECT sum("claim_reserves".outstanding) "claim_reserves__outstanding" 
  FROM  druid.ins_claim_reserve  AS "claim_reserves"),
cte_4 AS (  SELECT sum("cessions".ceded_premium) "cessions__ceded_premium" 
  FROM  druid.ins_cession  AS "cessions")
SELECT "q_0"."policies__written_premium" "policies__written_premium", "q_1"."earned_premiums__earned_premium" "earned_premiums__earned_premium", "q_2"."claim_payments__paid_amount" "claim_payments__paid_amount", "q_3"."claim_reserves__outstanding" "claim_reserves__outstanding", "q_4"."cessions__ceded_premium" "cessions__ceded_premium" 
FROM  cte_0  AS "q_0"
INNER JOIN  cte_1  AS "q_1" ON 1 = 1
INNER JOIN  cte_2  AS "q_2" ON 1 = 1
INNER JOIN  cte_3  AS "q_3" ON 1 = 1
INNER JOIN  cte_4  AS "q_4" ON 1 = 1
-- parameters: []

-- v_claims_by_line_cause
SELECT "products".line_of_business "claims_overview__line_of_business", "claims".cause_cd "claims_overview__cause_cd", sum("claim_payments".paid_amount) "claims_overview__paid_amount", COUNT(DISTINCT "claims".claim_id) "claims_overview__claim_count", sum("claim_payments".paid_amount) / NULLIF(COUNT(DISTINCT "claims".claim_id), 0) "claims_overview__paid_per_claim" 
FROM  druid.ins_claim_payment  AS "claim_payments"
LEFT JOIN  druid.ins_claim  AS "claims" ON "claim_payments".claim_id = "claims".claim_id
LEFT JOIN  druid.ins_policy  AS "policies" ON "claims".policy_id = "policies".policy_id
LEFT JOIN  druid.ins_product  AS "products" ON "policies".product_cd = "products".product_cd
WHERE ("claim_payments".__time >= TIME_PARSE(?) AND "claim_payments".__time <= TIME_PARSE(?))
GROUP BY 1, 2
ORDER BY  1  ASC,  2  ASC
-- parameters: ["2026-01-01T00:00:00.000Z", "2026-12-31T23:59:59.999Z"]

-- security_region_across_facts
 WITH 
cte_0 AS (  SELECT "products".line_of_business "products__line_of_business", sum("earned_premiums".earned_premium) "earned_premiums__earned_premium" 
  FROM  druid.ins_earned_premium  AS "earned_premiums"
  LEFT JOIN  druid.ins_policy  AS "policies" ON "earned_premiums".policy_id = "policies".policy_id
  LEFT JOIN  druid.ins_product  AS "products" ON "policies".product_cd = "products".product_cd
  LEFT JOIN  druid.ins_branch  AS "branches" ON "policies".branch_cd = "branches".branch_cd
  WHERE ("branches".region_name = ?)
  GROUP BY 1),
cte_1 AS (  SELECT "products".line_of_business "products__line_of_business", sum("claim_payments".paid_amount) "claim_payments__paid_amount" 
  FROM  druid.ins_claim_payment  AS "claim_payments"
  LEFT JOIN  druid.ins_claim  AS "claims" ON "claim_payments".claim_id = "claims".claim_id
  LEFT JOIN  druid.ins_policy  AS "policies" ON "claims".policy_id = "policies".policy_id
  LEFT JOIN  druid.ins_product  AS "products" ON "policies".product_cd = "products".product_cd
  LEFT JOIN  druid.ins_branch  AS "branches" ON "policies".branch_cd = "branches".branch_cd
  WHERE ("branches".region_name = ?)
  GROUP BY 1),
cte_2 AS (  SELECT "products".line_of_business "products__line_of_business", count("claims".claim_id) "claims__claim_count" 
  FROM  druid.ins_claim  AS "claims"
  LEFT JOIN  druid.ins_policy  AS "policies" ON "claims".policy_id = "policies".policy_id
  LEFT JOIN  druid.ins_product  AS "products" ON "policies".product_cd = "products".product_cd
  LEFT JOIN  druid.ins_branch  AS "branches" ON "policies".branch_cd = "branches".branch_cd
  WHERE ("branches".region_name = ?)
  GROUP BY 1)
SELECT "full_aggregate"."products__line_of_business" "products__line_of_business", "full_aggregate"."earned_premiums__earned_premium" "earned_premiums__earned_premium", "full_aggregate"."claim_payments__paid_amount" "claim_payments__paid_amount", "full_aggregate"."claims__claim_count" "claims__claim_count" 
FROM (SELECT COALESCE("q_l"."products__line_of_business", "q_r"."products__line_of_business") "products__line_of_business", MAX("q_l"."earned_premiums__earned_premium") "earned_premiums__earned_premium", MAX("q_l"."claim_payments__paid_amount") "claim_payments__paid_amount", MAX("q_r"."claims__claim_count") "claims__claim_count" 
FROM (SELECT COALESCE("q_l"."products__line_of_business", "q_r"."products__line_of_business") "products__line_of_business", MAX("q_l"."earned_premiums__earned_premium") "earned_premiums__earned_premium", MAX("q_r"."claim_payments__paid_amount") "claim_payments__paid_amount" 
FROM  cte_0  AS "q_l"
FULL JOIN  cte_1  AS "q_r" ON ("q_l"."products__line_of_business" = "q_r"."products__line_of_business")
GROUP BY 1) AS "q_l"
FULL JOIN  cte_2  AS "q_r" ON ("q_l"."products__line_of_business" = "q_r"."products__line_of_business")
GROUP BY 1) AS "full_aggregate"
GROUP BY 1, 2, 3, 4
ORDER BY  1  ASC
-- parameters: ["East", "East", "East"]
