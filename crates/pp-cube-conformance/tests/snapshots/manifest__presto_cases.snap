---
source: crates/pp-cube-conformance/tests/manifest.rs
expression: "golden_text(\"presto\")"
---
-- day
SELECT date_trunc('day', CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'Asia/Tokyo'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'Asia/Tokyo'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP)) "sales__sold_at_day", sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ("sales".sold_at >= from_iso8601_timestamp(?) AND "sales".sold_at <= from_iso8601_timestamp(?)) GROUP BY 1 ORDER BY  1  ASC
-- parameters: ["2026-09-30T15:00:00.000Z", "2026-10-31T14:59:59.999Z"]

-- week
SELECT date_trunc('week', CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'Asia/Tokyo'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'Asia/Tokyo'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP)) "sales__sold_at_week", sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ("sales".sold_at >= from_iso8601_timestamp(?) AND "sales".sold_at <= from_iso8601_timestamp(?)) GROUP BY 1 ORDER BY  1  ASC
-- parameters: ["2026-09-30T15:00:00.000Z", "2026-10-31T14:59:59.999Z"]

-- month
SELECT date_trunc('month', CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'Asia/Tokyo'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'Asia/Tokyo'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP)) "sales__sold_at_month", sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ("sales".sold_at >= from_iso8601_timestamp(?) AND "sales".sold_at <= from_iso8601_timestamp(?)) GROUP BY 1 ORDER BY  1  ASC
-- parameters: ["2026-09-30T15:00:00.000Z", "2026-10-31T14:59:59.999Z"]

-- quarter
SELECT date_trunc('quarter', CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'Asia/Tokyo'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'Asia/Tokyo'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP)) "sales__sold_at_quarter", sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ("sales".sold_at >= from_iso8601_timestamp(?) AND "sales".sold_at <= from_iso8601_timestamp(?)) GROUP BY 1 ORDER BY  1  ASC
-- parameters: ["2026-09-30T15:00:00.000Z", "2026-10-31T14:59:59.999Z"]

-- year
SELECT date_trunc('year', CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'Asia/Tokyo'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'Asia/Tokyo'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP)) "sales__sold_at_year", sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ("sales".sold_at >= from_iso8601_timestamp(?) AND "sales".sold_at <= from_iso8601_timestamp(?)) GROUP BY 1 ORDER BY  1  ASC
-- parameters: ["2026-09-30T15:00:00.000Z", "2026-10-31T14:59:59.999Z"]

-- inDateRange
SELECT sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ("sales".sold_at >= from_iso8601_timestamp(?) AND "sales".sold_at <= from_iso8601_timestamp(?))
-- parameters: ["2026-09-30T15:00:00.000Z", "2026-10-31T14:59:59.999Z"]

-- notInDateRange
SELECT sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ("sales".sold_at < from_iso8601_timestamp(?) OR "sales".sold_at > from_iso8601_timestamp(?))
-- parameters: ["2026-09-30T15:00:00.000Z", "2026-10-31T14:59:59.999Z"]

-- beforeDate
SELECT sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ("sales".sold_at < from_iso8601_timestamp(?))
-- parameters: ["2026-09-30T15:00:00.000Z"]

-- beforeOrOnDate
SELECT sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ("sales".sold_at <= from_iso8601_timestamp(?))
-- parameters: ["2026-10-01T14:59:59.999Z"]

-- afterDate
SELECT sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ("sales".sold_at > from_iso8601_timestamp(?))
-- parameters: ["2026-10-01T14:59:59.999Z"]

-- afterOrOnDate
SELECT sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ("sales".sold_at >= from_iso8601_timestamp(?))
-- parameters: ["2026-09-30T15:00:00.000Z"]

-- security
SELECT sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE (("sales".sold_at < from_iso8601_timestamp(?)) OR ("sales".sold_at >= from_iso8601_timestamp(?))) AND ("sales".sold_at >= from_iso8601_timestamp(?) AND "sales".sold_at <= from_iso8601_timestamp(?))
-- parameters: ["2026-09-30T15:00:00.000Z", "2026-09-30T15:00:00.000Z", "2026-09-30T15:00:00.000Z", "2026-10-31T14:59:59.999Z"]

-- rolling_tokyo
 WITH 
time_series AS (  SELECT d AS date_from,
  date_add('MILLISECOND', -1, d + interval '1' day) AS date_to
  FROM UNNEST(
  SEQUENCE(CAST(from_iso8601_timestamp('2026-10-01T00:00:00.000') AS TIMESTAMP), CAST(from_iso8601_timestamp('2026-10-02T23:59:59.999') AS TIMESTAMP), INTERVAL '1' day)
  ) AS dates(d)),
cte_0 AS (  SELECT date_trunc('day', CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'Asia/Tokyo'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'Asia/Tokyo'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP)) "sales__sold_at_day", sum("sales".amount) "sales__amount_2d"  
  FROM  dw.sales_dtl  AS "sales"
  WHERE (CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'Asia/Tokyo'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'Asia/Tokyo'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP) >= from_iso8601_timestamp(?) AND CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'Asia/Tokyo'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'Asia/Tokyo'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP) <= from_iso8601_timestamp(?)) GROUP BY 1 ORDER BY  1  ASC),
cte_1 AS (  SELECT "time_series"."date_from" "sales__sold_at_day", sum("rolling_source"."sales__amount_2d") "sales__amount_2d"  
  FROM  time_series  AS "time_series"
  LEFT JOIN  cte_0  AS "rolling_source" ON "rolling_source"."sales__sold_at_day" > "time_series"."date_to" - interval '2' day AND "rolling_source"."sales__sold_at_day" <= "time_series"."date_to" GROUP BY 1 ORDER BY  1  ASC)
SELECT "fk_aggregate"."sales__sold_at_day" "sales__sold_at_day", "fk_aggregate"."sales__amount_2d" "sales__amount_2d"  
FROM  cte_1  AS "fk_aggregate" ORDER BY  1  ASC
-- parameters: ["2026-09-29T00:00:00.000", "2026-10-03T23:59:58.999"]

-- dst
SELECT date_trunc('day', CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'America/New_York'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'America/New_York'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP)) "sales__sold_at_day", sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ("sales".sold_at >= from_iso8601_timestamp(?) AND "sales".sold_at <= from_iso8601_timestamp(?)) GROUP BY 1 ORDER BY  1  ASC
-- parameters: ["2026-11-01T04:00:00.000Z", "2026-11-02T04:59:59.999Z"]

-- aggregates
SELECT "sales".channel_cd "sales__channel_cd", count("sales".sale_id) "sales__row_count", COUNT(DISTINCT "sales".order_no) "sales__order_count", sum("sales".amount) "sales__amount", avg("sales".amount) "sales__avg_amount", min("sales".amount) "sales__min_amount", max("sales".amount) "sales__max_amount"  
FROM  dw.sales_dtl  AS "sales" GROUP BY 1 ORDER BY  1  ASC
-- parameters: []

-- filtered_measure_ratio_segment
SELECT "sales".channel_cd "sales__channel_cd", sum(CASE WHEN ("sales".category_cd = 'TOY') THEN "sales".amount END) "sales__toy_amount", sum("sales".amount) / NULLIF(COUNT(DISTINCT "sales".order_no), 0) "sales__amount_per_order"  
FROM  dw.sales_dtl  AS "sales"
WHERE ("sales".category_cd = 'TOY') GROUP BY 1 ORDER BY  1  ASC
-- parameters: []

-- equals_many
SELECT sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ("sales".channel_cd IN (?, ?))
-- parameters: ["C1", "C3"]

-- notEquals
SELECT sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ("sales".region_cd <> ? OR "sales".region_cd IS NULL)
-- parameters: ["north"]

-- boolean_equals
SELECT sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE (("sales".is_valid = 1) = CAST(? AS BOOLEAN))
-- parameters: ["true"]

-- set
SELECT sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ("sales".region_cd IS NOT NULL)
-- parameters: []

-- notSet
SELECT sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ("sales".region_cd IS NULL)
-- parameters: []

-- gt
SELECT sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ("sales".qty > CAST(? AS DOUBLE))
-- parameters: ["3"]

-- gte
SELECT sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ("sales".qty >= CAST(? AS DOUBLE))
-- parameters: ["3"]

-- lt
SELECT sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ("sales".qty < CAST(? AS DOUBLE))
-- parameters: ["3"]

-- lte
SELECT sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ("sales".qty <= CAST(? AS DOUBLE))
-- parameters: ["3"]

-- contains
SELECT sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ((LOWER("sales".region_cd)  LIKE CONCAT('%', LOWER(?), '%') ESCAPE '\'))
-- parameters: ["A\\%\\_\\\\B"]

-- notContains
SELECT sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ((LOWER("sales".region_cd) NOT  LIKE CONCAT('%', LOWER(?), '%') ESCAPE '\') OR "sales".region_cd IS NULL)
-- parameters: ["A\\%\\_\\\\B"]

-- startsWith
SELECT sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ((LOWER("sales".region_cd)  LIKE CONCAT('', LOWER(?), '%') ESCAPE '\'))
-- parameters: ["A\\%\\_\\\\B"]

-- notStartsWith
SELECT sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ((LOWER("sales".region_cd) NOT  LIKE CONCAT('', LOWER(?), '%') ESCAPE '\') OR "sales".region_cd IS NULL)
-- parameters: ["A\\%\\_\\\\B"]

-- endsWith
SELECT sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ((LOWER("sales".region_cd)  LIKE CONCAT('%', LOWER(?), '') ESCAPE '\'))
-- parameters: ["A\\%\\_\\\\B"]

-- notEndsWith
SELECT sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ((LOWER("sales".region_cd) NOT  LIKE CONCAT('%', LOWER(?), '') ESCAPE '\') OR "sales".region_cd IS NULL)
-- parameters: ["A\\%\\_\\\\B"]

-- measure_filters
SELECT "sales".channel_cd "sales__channel_cd", sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales" GROUP BY 1
HAVING (sum("sales".amount) > CAST(? AS DOUBLE)) AND (sum("sales".amount) <> CAST(? AS DOUBLE) OR sum("sales".amount) IS NULL) ORDER BY  1  ASC
-- parameters: ["20", "110"]

-- nested_groups
SELECT sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ("sales".category_cd = ?) AND ((("sales".channel_cd = ?) AND ("sales".qty > CAST(? AS DOUBLE))) OR ("sales".channel_cd = ?))
-- parameters: ["BOOK", "C3", "5", "C2"]

-- order_limit_offset
SELECT "sales".channel_cd "sales__channel_cd", "sales".category_cd "sales__category_cd", sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales" GROUP BY 1, 2 ORDER BY  1  DESC,  2  ASC
OFFSET 1
LIMIT 2
-- parameters: []

-- page_past_last_group
SELECT "sales".channel_cd "sales__channel_cd", "sales".category_cd "sales__category_cd", sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales" GROUP BY 1, 2 ORDER BY  1  DESC,  2  ASC
OFFSET 4
LIMIT 2
-- parameters: []

-- plain_range
SELECT sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ("sales".sold_at >= from_iso8601_timestamp(?) AND "sales".sold_at <= from_iso8601_timestamp(?))
-- parameters: ["2026-10-02T00:00:00.000Z", "2026-10-04T23:59:59.999Z"]

-- query_timezone
SELECT date_trunc('day', CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP)) "sales__sold_at_day", sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE ("sales".sold_at >= from_iso8601_timestamp(?) AND "sales".sold_at <= from_iso8601_timestamp(?)) GROUP BY 1 ORDER BY  1  ASC
-- parameters: ["2026-10-01T00:00:00.000Z", "2026-10-01T23:59:59.999Z"]

-- filtered_source
SELECT "valid_sales".channel_cd "valid_sales__channel_cd", sum("valid_sales".amount) "valid_sales__amount"  
FROM  (SELECT channel_cd, amount FROM dw.sales_dtl WHERE is_valid = 1)  AS "valid_sales" GROUP BY 1 ORDER BY  1  ASC
-- parameters: []

-- joined_dimension
SELECT "stores".store_name "stores__store_name", sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
LEFT JOIN  dw.dim_store  AS "stores" ON "sales".store_cd = "stores".store_cd
WHERE ("stores".store_name IN (?, ?)) GROUP BY 1 ORDER BY  1  ASC
-- parameters: ["central", "uptown"]

-- joined_one_to_one_measures
SELECT "sales".channel_cd "sales__channel_cd", sum("receipts".tax) "receipts__tax", count("receipts".receipt_no) "receipts__receipt_count", sum("receipts".tax) / NULLIF(count("receipts".receipt_no), 0) "receipts__tax_per_receipt"  
FROM  dw.sales_dtl  AS "sales"
LEFT JOIN  dw.receipt  AS "receipts" ON "sales".receipt_no = "receipts".receipt_no GROUP BY 1 ORDER BY  1  ASC
-- parameters: []

-- joined_many_to_one_counts
SELECT "sales".category_cd "sales__category_cd", COUNT(DISTINCT "stores".store_cd) "stores__store_count", COUNT(DISTINCT "stores".store_name) "stores__name_count"  
FROM  dw.sales_dtl  AS "sales"
LEFT JOIN  dw.dim_store  AS "stores" ON "sales".store_cd = "stores".store_cd GROUP BY 1 ORDER BY  1  ASC
-- parameters: []

-- join_reading_a_third_cube
SELECT "promos".promo_name "promos__promo_name", sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
LEFT JOIN  dw.dim_store  AS "stores" ON "sales".store_cd = "stores".store_cd
LEFT JOIN  dw.dim_region  AS "regions" ON "stores".region_cd = "regions".region_cd
LEFT JOIN  dw.promo  AS "promos" ON "sales".promo_cd = "promos".promo_cd AND "promos".region_cd = "regions".region_cd
WHERE ("promos".promo_name IS NOT NULL) GROUP BY 1 ORDER BY  1  ASC
-- parameters: []

-- multi_fact_by_dimension
 WITH 
cte_0 AS (  SELECT "stores".store_name "stores__store_name", sum("sales".amount) "sales__amount"  
  FROM  dw.sales_dtl  AS "sales"
  LEFT JOIN  dw.dim_store  AS "stores" ON "sales".store_cd = "stores".store_cd
  WHERE ("stores".store_name IS NOT NULL) GROUP BY 1),
cte_1 AS (  SELECT "stores".store_name "stores__store_name", sum("refunds".amount) "refunds__amount", count("refunds".refund_id) "refunds__refund_count"  
  FROM  dw.refund_dtl  AS "refunds"
  LEFT JOIN  dw.dim_store  AS "stores" ON "refunds".store_cd = "stores".store_cd
  WHERE ("stores".store_name IS NOT NULL) GROUP BY 1)
SELECT "fk_aggregate_keys"."stores__store_name" "stores__store_name", "q_0"."sales__amount" "sales__amount", "q_1"."refunds__amount" "refunds__amount", "q_1"."refunds__refund_count" "refunds__refund_count"  
FROM (SELECT DISTINCT "stores__store_name" "stores__store_name"  
FROM (SELECT DISTINCT "stores__store_name" "stores__store_name"  
FROM  cte_0  AS "cte_0"
 UNION ALL 
SELECT DISTINCT "stores__store_name" "stores__store_name"  
FROM  cte_1  AS "cte_1") AS "fk_aggregate_keys_source") AS "fk_aggregate_keys"
LEFT JOIN  cte_0  AS "q_0" ON (("fk_aggregate_keys"."stores__store_name" = "q_0"."stores__store_name" OR (("fk_aggregate_keys"."stores__store_name" IS NULL) AND ("q_0"."stores__store_name" IS NULL))))
LEFT JOIN  cte_1  AS "q_1" ON (("fk_aggregate_keys"."stores__store_name" = "q_1"."stores__store_name" OR (("fk_aggregate_keys"."stores__store_name" IS NULL) AND ("q_1"."stores__store_name" IS NULL)))) ORDER BY  1  ASC
-- parameters: []

-- multi_fact_null_key
 WITH 
cte_0 AS (  SELECT "stores".store_name "stores__store_name", sum("sales".amount) "sales__amount"  
  FROM  dw.sales_dtl  AS "sales"
  LEFT JOIN  dw.dim_store  AS "stores" ON "sales".store_cd = "stores".store_cd GROUP BY 1),
cte_1 AS (  SELECT "stores".store_name "stores__store_name", sum("refunds".amount) "refunds__amount"  
  FROM  dw.refund_dtl  AS "refunds"
  LEFT JOIN  dw.dim_store  AS "stores" ON "refunds".store_cd = "stores".store_cd GROUP BY 1),
cte_2 AS (  SELECT "stores".store_name "stores__store_name", count("visits".visit_id) "visits__visit_count"  
  FROM  dw.visit  AS "visits"
  LEFT JOIN  dw.dim_store  AS "stores" ON "visits".store_cd = "stores".store_cd GROUP BY 1)
SELECT "fk_aggregate_keys"."stores__store_name" "stores__store_name", "q_0"."sales__amount" "sales__amount", "q_1"."refunds__amount" "refunds__amount", "q_2"."visits__visit_count" "visits__visit_count"  
FROM (SELECT DISTINCT "stores__store_name" "stores__store_name"  
FROM (SELECT DISTINCT "stores__store_name" "stores__store_name"  
FROM  cte_0  AS "cte_0"
 UNION ALL 
SELECT DISTINCT "stores__store_name" "stores__store_name"  
FROM  cte_1  AS "cte_1"
 UNION ALL 
SELECT DISTINCT "stores__store_name" "stores__store_name"  
FROM  cte_2  AS "cte_2") AS "fk_aggregate_keys_source") AS "fk_aggregate_keys"
LEFT JOIN  cte_0  AS "q_0" ON (("fk_aggregate_keys"."stores__store_name" = "q_0"."stores__store_name" OR (("fk_aggregate_keys"."stores__store_name" IS NULL) AND ("q_0"."stores__store_name" IS NULL))))
LEFT JOIN  cte_1  AS "q_1" ON (("fk_aggregate_keys"."stores__store_name" = "q_1"."stores__store_name" OR (("fk_aggregate_keys"."stores__store_name" IS NULL) AND ("q_1"."stores__store_name" IS NULL))))
LEFT JOIN  cte_2  AS "q_2" ON (("fk_aggregate_keys"."stores__store_name" = "q_2"."stores__store_name" OR (("fk_aggregate_keys"."stores__store_name" IS NULL) AND ("q_2"."stores__store_name" IS NULL))))
WHERE ("q_2"."visits__visit_count" > CAST(? AS DOUBLE)) ORDER BY  4  DESC,  2  DESC
-- parameters: ["0"]

-- multi_fact_totals
 WITH 
cte_0 AS (  SELECT sum("sales".amount) "sales__amount"  
  FROM  dw.sales_dtl  AS "sales"),
cte_1 AS (  SELECT sum("refunds".amount) "refunds__amount"  
  FROM  dw.refund_dtl  AS "refunds")
SELECT "q_0"."sales__amount" "sales__amount", "q_1"."refunds__amount" "refunds__amount"  
FROM  cte_0  AS "q_0"
INNER JOIN  cte_1  AS "q_1" ON 1 = 1
-- parameters: []

-- multi_fact_page
 WITH 
cte_0 AS (  SELECT "stores".store_name "stores__store_name", sum("sales".amount) "sales__amount"  
  FROM  dw.sales_dtl  AS "sales"
  LEFT JOIN  dw.dim_store  AS "stores" ON "sales".store_cd = "stores".store_cd
  WHERE ("stores".store_name IS NOT NULL) GROUP BY 1),
cte_1 AS (  SELECT "stores".store_name "stores__store_name", sum("refunds".amount) "refunds__amount"  
  FROM  dw.refund_dtl  AS "refunds"
  LEFT JOIN  dw.dim_store  AS "stores" ON "refunds".store_cd = "stores".store_cd
  WHERE ("stores".store_name IS NOT NULL) GROUP BY 1)
SELECT "fk_aggregate_keys"."stores__store_name" "stores__store_name", "q_0"."sales__amount" "sales__amount", "q_1"."refunds__amount" "refunds__amount"  
FROM (SELECT DISTINCT "stores__store_name" "stores__store_name"  
FROM (SELECT DISTINCT "stores__store_name" "stores__store_name"  
FROM  cte_0  AS "cte_0"
 UNION ALL 
SELECT DISTINCT "stores__store_name" "stores__store_name"  
FROM  cte_1  AS "cte_1") AS "fk_aggregate_keys_source") AS "fk_aggregate_keys"
LEFT JOIN  cte_0  AS "q_0" ON (("fk_aggregate_keys"."stores__store_name" = "q_0"."stores__store_name" OR (("fk_aggregate_keys"."stores__store_name" IS NULL) AND ("q_0"."stores__store_name" IS NULL))))
LEFT JOIN  cte_1  AS "q_1" ON (("fk_aggregate_keys"."stores__store_name" = "q_1"."stores__store_name" OR (("fk_aggregate_keys"."stores__store_name" IS NULL) AND ("q_1"."stores__store_name" IS NULL)))) ORDER BY  2  DESC
OFFSET 1
LIMIT 1
-- parameters: []

-- sum_over_repeated_rows
 WITH 
cte_0 AS (  SELECT "sales".category_cd "sales__category_cd", sum("sales".amount) "sales__amount"  
  FROM  dw.sales_dtl  AS "sales" GROUP BY 1),
cte_1 AS (  SELECT "keys"."sales__category_cd" "sales__category_cd", sum("stores_key_stores".floor_area) "stores__floor_area"  
  FROM (SELECT DISTINCT "stores_key_sales".category_cd "sales__category_cd", "stores_key_stores".store_cd "stores__store_cd"  
  FROM  dw.sales_dtl  AS "stores_key_sales"
  LEFT JOIN  dw.dim_store  AS "stores_key_stores" ON "stores_key_sales".store_cd = "stores_key_stores".store_cd) AS "keys"
  LEFT JOIN  dw.dim_store  AS "stores_key_stores" ON (("keys"."stores__store_cd" = "stores_key_stores".store_cd)) GROUP BY 1)
SELECT "fk_aggregate_keys"."sales__category_cd" "sales__category_cd", "q_0"."sales__amount" "sales__amount", "q_1"."stores__floor_area" "stores__floor_area"  
FROM (SELECT DISTINCT "sales__category_cd" "sales__category_cd"  
FROM (SELECT DISTINCT "sales__category_cd" "sales__category_cd"  
FROM  cte_0  AS "cte_0"
 UNION ALL 
SELECT DISTINCT "sales__category_cd" "sales__category_cd"  
FROM  cte_1  AS "cte_1") AS "fk_aggregate_keys_source") AS "fk_aggregate_keys"
LEFT JOIN  cte_0  AS "q_0" ON (("fk_aggregate_keys"."sales__category_cd" = "q_0"."sales__category_cd" OR (("fk_aggregate_keys"."sales__category_cd" IS NULL) AND ("q_0"."sales__category_cd" IS NULL))))
LEFT JOIN  cte_1  AS "q_1" ON (("fk_aggregate_keys"."sales__category_cd" = "q_1"."sales__category_cd" OR (("fk_aggregate_keys"."sales__category_cd" IS NULL) AND ("q_1"."sales__category_cd" IS NULL)))) ORDER BY  1  ASC
-- parameters: []

-- two_cubes_in_one_select
SELECT "sales".channel_cd "sales__channel_cd", sum("sales".amount) "sales__amount", sum("receipts".tax) "receipts__tax"  
FROM  dw.sales_dtl  AS "sales"
LEFT JOIN  dw.receipt  AS "receipts" ON "sales".receipt_no = "receipts".receipt_no GROUP BY 1 ORDER BY  1  ASC
-- parameters: []

-- security_multi_fact
 WITH 
cte_0 AS (  SELECT "stores".store_name "stores__store_name", sum("sales".amount) "sales__amount"  
  FROM  dw.sales_dtl  AS "sales"
  LEFT JOIN  dw.dim_store  AS "stores" ON "sales".store_cd = "stores".store_cd
  LEFT JOIN  dw.dim_region  AS "regions" ON "stores".region_cd = "regions".region_cd
  WHERE ("regions".region_name = ?) GROUP BY 1),
cte_1 AS (  SELECT "stores".store_name "stores__store_name", sum("refunds".amount) "refunds__amount"  
  FROM  dw.refund_dtl  AS "refunds"
  LEFT JOIN  dw.dim_store  AS "stores" ON "refunds".store_cd = "stores".store_cd
  LEFT JOIN  dw.dim_region  AS "regions" ON "stores".region_cd = "regions".region_cd
  WHERE ("regions".region_name = ?) GROUP BY 1)
SELECT "fk_aggregate_keys"."stores__store_name" "stores__store_name", "q_0"."sales__amount" "sales__amount", "q_1"."refunds__amount" "refunds__amount"  
FROM (SELECT DISTINCT "stores__store_name" "stores__store_name"  
FROM (SELECT DISTINCT "stores__store_name" "stores__store_name"  
FROM  cte_0  AS "cte_0"
 UNION ALL 
SELECT DISTINCT "stores__store_name" "stores__store_name"  
FROM  cte_1  AS "cte_1") AS "fk_aggregate_keys_source") AS "fk_aggregate_keys"
LEFT JOIN  cte_0  AS "q_0" ON (("fk_aggregate_keys"."stores__store_name" = "q_0"."stores__store_name" OR (("fk_aggregate_keys"."stores__store_name" IS NULL) AND ("q_0"."stores__store_name" IS NULL))))
LEFT JOIN  cte_1  AS "q_1" ON (("fk_aggregate_keys"."stores__store_name" = "q_1"."stores__store_name" OR (("fk_aggregate_keys"."stores__store_name" IS NULL) AND ("q_1"."stores__store_name" IS NULL)))) ORDER BY  1  ASC
-- parameters: ["north", "north"]

-- security_two_hop_join
SELECT sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
LEFT JOIN  dw.dim_store  AS "stores" ON "sales".store_cd = "stores".store_cd
LEFT JOIN  dw.dim_region  AS "regions" ON "stores".region_cd = "regions".region_cd
WHERE (("sales".is_valid = 1) = CAST(? AS BOOLEAN)) AND ("regions".region_name = ?)
-- parameters: ["true", "north"]

-- security_pattern
SELECT sum("sales".amount) "sales__amount"  
FROM  dw.sales_dtl  AS "sales"
WHERE (((LOWER("sales".region_cd)  LIKE CONCAT('%', LOWER(?), '%') ESCAPE '\')) OR ("sales".channel_cd = ?)) AND ((LOWER("sales".region_cd)  LIKE CONCAT('', LOWER(?), '%') ESCAPE '\'))
-- parameters: ["north", "C3", "a\\%"]

-- rolling_trailing
 WITH 
time_series AS (  SELECT d AS date_from,
  date_add('MILLISECOND', -1, d + interval '1' day) AS date_to
  FROM UNNEST(
  SEQUENCE(CAST(from_iso8601_timestamp('2026-10-01T00:00:00.000') AS TIMESTAMP), CAST(from_iso8601_timestamp('2026-10-07T23:59:59.999') AS TIMESTAMP), INTERVAL '1' day)
  ) AS dates(d)),
cte_0 AS (  SELECT date_trunc('day', CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP)) "sales__sold_at_day", sum("sales".amount) "sales__amount_3d"  
  FROM  dw.sales_dtl  AS "sales"
  WHERE (CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP) >= from_iso8601_timestamp(?) AND CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP) <= from_iso8601_timestamp(?)) GROUP BY 1 ORDER BY  1  ASC),
cte_1 AS (  SELECT "time_series"."date_from" "sales__sold_at_day", sum("rolling_source"."sales__amount_3d") "sales__amount_3d"  
  FROM  time_series  AS "time_series"
  LEFT JOIN  cte_0  AS "rolling_source" ON "rolling_source"."sales__sold_at_day" > "time_series"."date_to" - interval '3' day AND "rolling_source"."sales__sold_at_day" <= "time_series"."date_to" GROUP BY 1 ORDER BY  1  ASC)
SELECT "fk_aggregate"."sales__sold_at_day" "sales__sold_at_day", "fk_aggregate"."sales__amount_3d" "sales__amount_3d"  
FROM  cte_1  AS "fk_aggregate" ORDER BY  1  ASC
-- parameters: ["2026-09-28T00:00:00.000", "2026-10-08T23:59:58.999"]

-- rolling_distinct_count
 WITH 
time_series AS (  SELECT d AS date_from,
  date_add('MILLISECOND', -1, d + interval '1' day) AS date_to
  FROM UNNEST(
  SEQUENCE(CAST(from_iso8601_timestamp('2026-10-02T00:00:00.000') AS TIMESTAMP), CAST(from_iso8601_timestamp('2026-10-03T23:59:59.999') AS TIMESTAMP), INTERVAL '1' day)
  ) AS dates(d)),
cte_0 AS (  SELECT date_trunc('day', CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP)) "sales__sold_at_day", "sales".order_no "sales__orders_2d"  
  FROM  dw.sales_dtl  AS "sales"
  WHERE (CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP) >= from_iso8601_timestamp(?) AND CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP) <= from_iso8601_timestamp(?)) ORDER BY  1  ASC),
cte_1 AS (  SELECT "time_series"."date_from" "sales__sold_at_day", COUNT(DISTINCT "rolling_source"."sales__orders_2d") "sales__orders_2d"  
  FROM  time_series  AS "time_series"
  LEFT JOIN  cte_0  AS "rolling_source" ON "rolling_source"."sales__sold_at_day" > "time_series"."date_to" - interval '2' day AND "rolling_source"."sales__sold_at_day" <= "time_series"."date_to" GROUP BY 1 ORDER BY  1  ASC)
SELECT "fk_aggregate"."sales__sold_at_day" "sales__sold_at_day", "fk_aggregate"."sales__orders_2d" "sales__orders_2d"  
FROM  cte_1  AS "fk_aggregate" ORDER BY  1  ASC
-- parameters: ["2026-09-30T00:00:00.000", "2026-10-04T23:59:58.999"]

-- month_to_date
 WITH 
time_series AS (  SELECT d AS date_from,
  date_add('MILLISECOND', -1, d + interval '1' day) AS date_to
  FROM UNNEST(
  SEQUENCE(CAST(from_iso8601_timestamp('2026-10-04T00:00:00.000') AS TIMESTAMP), CAST(from_iso8601_timestamp('2026-10-06T23:59:59.999') AS TIMESTAMP), INTERVAL '1' day)
  ) AS dates(d)),
cte_0 AS (  SELECT date_trunc('day', CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP)) "sales__sold_at_day", sum("sales".amount) "sales__amount_mtd"  
  FROM  dw.sales_dtl  AS "sales"
  WHERE (CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP) >= from_iso8601_timestamp(?) AND CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP) <= from_iso8601_timestamp(?)) GROUP BY 1 ORDER BY  1  ASC),
cte_1 AS (  SELECT "time_series"."date_from" "sales__sold_at_day", sum("rolling_source"."sales__amount_mtd") "sales__amount_mtd"  
  FROM  time_series  AS "time_series"
  LEFT JOIN  cte_0  AS "rolling_source" ON "rolling_source"."sales__sold_at_day" >= date_trunc('month', "time_series"."date_from") and "rolling_source"."sales__sold_at_day" <= "time_series"."date_to" GROUP BY 1 ORDER BY  1  ASC)
SELECT "fk_aggregate"."sales__sold_at_day" "sales__sold_at_day", "fk_aggregate"."sales__amount_mtd" "sales__amount_mtd"  
FROM  cte_1  AS "fk_aggregate" ORDER BY  1  ASC
-- parameters: ["2026-10-01T00:00:00.000", "2026-10-07T23:59:58.999"]

-- rolling_at_range_end
 WITH 
cte_0 AS (  SELECT sum("sales".amount) "sales__amount_3d"  
  FROM  dw.sales_dtl  AS "sales"
  WHERE ("sales".sold_at > from_iso8601_timestamp(?) AND "sales".sold_at <= from_iso8601_timestamp(?)))
SELECT "fk_aggregate"."sales__amount_3d" "sales__amount_3d"  
FROM  cte_0  AS "fk_aggregate"
-- parameters: ["2026-10-01T23:59:59.999Z", "2026-10-04T23:59:59.999Z"]

-- running_total_by_month
 WITH 
time_series AS (  SELECT d AS date_from,
  date_add('MILLISECOND', -1, d + interval '1' month) AS date_to
  FROM UNNEST(
  SEQUENCE(CAST(from_iso8601_timestamp('2026-09-01T00:00:00.000') AS TIMESTAMP), CAST(from_iso8601_timestamp('2026-11-30T23:59:59.999') AS TIMESTAMP), INTERVAL '1' month)
  ) AS dates(d)),
cte_0 AS (  SELECT date_trunc('month', CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP)) "sales__sold_at_month", sum("sales".amount) "sales__amount_so_far"  
  FROM  dw.sales_dtl  AS "sales"
  WHERE (CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP) <= from_iso8601_timestamp(?)) GROUP BY 1 ORDER BY  1  ASC),
cte_1 AS (  SELECT "time_series"."date_from" "sales__sold_at_month", sum("rolling_source"."sales__amount_so_far") "sales__amount_so_far"  
  FROM  time_series  AS "time_series"
  LEFT JOIN  cte_0  AS "rolling_source" ON "rolling_source"."sales__sold_at_month" <= "time_series"."date_to" GROUP BY 1 ORDER BY  1  ASC)
SELECT "fk_aggregate"."sales__sold_at_month" "sales__sold_at_month", "fk_aggregate"."sales__amount_so_far" "sales__amount_so_far"  
FROM  cte_1  AS "fk_aggregate" ORDER BY  1  ASC
-- parameters: ["2026-12-30T23:59:58.999"]

-- prior_day
 WITH 
cte_0 AS (  SELECT date_trunc('day', CAST(date_add('minute', timezone_minute(COALESCE(("sales".sold_at + interval '1' day), CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), date_add('hour', timezone_hour(COALESCE(("sales".sold_at + interval '1' day), CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), COALESCE(("sales".sold_at + interval '1' day), CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP)) "sales__sold_at_day", sum("sales".amount) "sales__amount"  
  FROM  dw.sales_dtl  AS "sales"
  WHERE (("sales".sold_at + interval '1' day) >= from_iso8601_timestamp(?) AND ("sales".sold_at + interval '1' day) <= from_iso8601_timestamp(?)) GROUP BY 1 ORDER BY  1  ASC),
cte_1 AS (  SELECT "fk_aggregate"."sales__sold_at_day" "sales__sold_at_day", "fk_aggregate"."sales__amount" "sales__amount_prior_day"  
  FROM  cte_0  AS "fk_aggregate"),
cte_2 AS (  SELECT date_trunc('day', CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP)) "sales__sold_at_day", sum("sales".amount) "sales__amount"  
  FROM  dw.sales_dtl  AS "sales"
  WHERE ("sales".sold_at >= from_iso8601_timestamp(?) AND "sales".sold_at <= from_iso8601_timestamp(?)) GROUP BY 1)
SELECT "fk_aggregate_keys"."sales__sold_at_day" "sales__sold_at_day", "q_1"."sales__amount" "sales__amount", "q_0"."sales__amount_prior_day" "sales__amount_prior_day"  
FROM (SELECT DISTINCT "sales__sold_at_day" "sales__sold_at_day"  
FROM (SELECT DISTINCT "sales__sold_at_day" "sales__sold_at_day"  
FROM  cte_1  AS "cte_1"
 UNION ALL 
SELECT DISTINCT "sales__sold_at_day" "sales__sold_at_day"  
FROM  cte_2  AS "cte_2") AS "fk_aggregate_keys_source") AS "fk_aggregate_keys"
LEFT JOIN  cte_1  AS "q_0" ON (("fk_aggregate_keys"."sales__sold_at_day" = "q_0"."sales__sold_at_day" OR (("fk_aggregate_keys"."sales__sold_at_day" IS NULL) AND ("q_0"."sales__sold_at_day" IS NULL))))
LEFT JOIN  cte_2  AS "q_1" ON (("fk_aggregate_keys"."sales__sold_at_day" = "q_1"."sales__sold_at_day" OR (("fk_aggregate_keys"."sales__sold_at_day" IS NULL) AND ("q_1"."sales__sold_at_day" IS NULL)))) ORDER BY  1  ASC
-- parameters: ["2026-10-02T00:00:00.000Z", "2026-10-04T23:59:59.999Z", "2026-10-02T00:00:00.000Z", "2026-10-04T23:59:59.999Z"]

-- change_from_prior_day
 WITH 
cte_0 AS (  SELECT date_trunc('day', CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP)) "sales__sold_at_day", sum("sales".amount) "sales__amount"  
  FROM  dw.sales_dtl  AS "sales"
  WHERE ("sales".sold_at >= from_iso8601_timestamp(?) AND "sales".sold_at <= from_iso8601_timestamp(?)) GROUP BY 1 ORDER BY  1  ASC),
cte_1 AS (  SELECT date_trunc('day', CAST(date_add('minute', timezone_minute(COALESCE(("sales".sold_at + interval '1' day), CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), date_add('hour', timezone_hour(COALESCE(("sales".sold_at + interval '1' day), CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), COALESCE(("sales".sold_at + interval '1' day), CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP)) "sales__sold_at_day", sum("sales".amount) "sales__amount"  
  FROM  dw.sales_dtl  AS "sales"
  WHERE (("sales".sold_at + interval '1' day) >= from_iso8601_timestamp(?) AND ("sales".sold_at + interval '1' day) <= from_iso8601_timestamp(?)) GROUP BY 1 ORDER BY  1  ASC),
cte_2 AS (  SELECT "fk_aggregate"."sales__sold_at_day" "sales__sold_at_day", "fk_aggregate"."sales__amount" "sales__amount_prior_day"  
  FROM  cte_1  AS "fk_aggregate"),
cte_3 AS (  SELECT "fk_aggregate_keys"."sales__sold_at_day" "sales__sold_at_day", "q_0"."sales__amount" - "q_1"."sales__amount_prior_day" "sales__amount_change"  
  FROM (SELECT DISTINCT "sales__sold_at_day" "sales__sold_at_day"  
  FROM (SELECT DISTINCT "sales__sold_at_day" "sales__sold_at_day"  
  FROM  cte_0  AS "cte_0"
   UNION ALL 
  SELECT DISTINCT "sales__sold_at_day" "sales__sold_at_day"  
  FROM  cte_2  AS "cte_2") AS "fk_aggregate_keys_source") AS "fk_aggregate_keys"
  LEFT JOIN  cte_0  AS "q_0" ON (("fk_aggregate_keys"."sales__sold_at_day" = "q_0"."sales__sold_at_day" OR (("fk_aggregate_keys"."sales__sold_at_day" IS NULL) AND ("q_0"."sales__sold_at_day" IS NULL))))
  LEFT JOIN  cte_2  AS "q_1" ON (("fk_aggregate_keys"."sales__sold_at_day" = "q_1"."sales__sold_at_day" OR (("fk_aggregate_keys"."sales__sold_at_day" IS NULL) AND ("q_1"."sales__sold_at_day" IS NULL)))))
SELECT "fk_aggregate"."sales__sold_at_day" "sales__sold_at_day", "fk_aggregate"."sales__amount_change" "sales__amount_change"  
FROM  cte_3  AS "fk_aggregate" ORDER BY  1  ASC
-- parameters: ["2026-10-02T00:00:00.000Z", "2026-10-04T23:59:59.999Z", "2026-10-02T00:00:00.000Z", "2026-10-04T23:59:59.999Z"]

-- security_rolling
 WITH 
time_series AS (  SELECT d AS date_from,
  date_add('MILLISECOND', -1, d + interval '1' day) AS date_to
  FROM UNNEST(
  SEQUENCE(CAST(from_iso8601_timestamp('2026-10-01T00:00:00.000') AS TIMESTAMP), CAST(from_iso8601_timestamp('2026-10-03T23:59:59.999') AS TIMESTAMP), INTERVAL '1' day)
  ) AS dates(d)),
cte_0 AS (  SELECT date_trunc('day', CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP)) "sales__sold_at_day", sum("sales".amount) "sales__amount_3d"  
  FROM  dw.sales_dtl  AS "sales"
  WHERE (CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP) >= from_iso8601_timestamp(?) AND CAST(date_add('minute', timezone_minute(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), date_add('hour', timezone_hour(COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)) AT TIME ZONE 'UTC'), COALESCE("sales".sold_at, CAST(NULL AS TIMESTAMP)))) AS TIMESTAMP) <= from_iso8601_timestamp(?)) AND ("sales".channel_cd = ?) GROUP BY 1 ORDER BY  1  ASC),
cte_1 AS (  SELECT "time_series"."date_from" "sales__sold_at_day", sum("rolling_source"."sales__amount_3d") "sales__amount_3d"  
  FROM  time_series  AS "time_series"
  LEFT JOIN  cte_0  AS "rolling_source" ON "rolling_source"."sales__sold_at_day" > "time_series"."date_to" - interval '3' day AND "rolling_source"."sales__sold_at_day" <= "time_series"."date_to" GROUP BY 1 ORDER BY  1  ASC)
SELECT "fk_aggregate"."sales__sold_at_day" "sales__sold_at_day", "fk_aggregate"."sales__amount_3d" "sales__amount_3d"  
FROM  cte_1  AS "fk_aggregate" ORDER BY  1  ASC
-- parameters: ["2026-09-28T00:00:00.000", "2026-10-04T23:59:58.999", "C1"]
