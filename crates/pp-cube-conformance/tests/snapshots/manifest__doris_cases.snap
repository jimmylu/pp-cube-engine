-- security
SELECT sum(`sales`.amount) `sales__amount`  
FROM  dw.sales_dtl  AS `sales`
WHERE ((`sales`.sold_at < CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3))) OR (`sales`.sold_at >= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3)))) AND (`sales`.sold_at >= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3)) AND `sales`.sold_at <= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3)))
-- parameters: ["2026-09-30T15:00:00.000Z", "2026-09-30T15:00:00.000Z", "2026-09-30T15:00:00.000Z", "2026-10-31T14:59:59.999Z"]

-- rolling_tokyo
 WITH 
time_series AS (  SELECT CAST(REPLACE(dates.f, 'T', ' ') AS DATETIMEV2(3)) date_from, CAST(REPLACE(dates.t, 'T', ' ') AS DATETIMEV2(3)) date_to 
  FROM (
      select '2026-10-01T00:00:00.000' f, '2026-10-01T23:59:59.999' t 
   UNION ALL
      select '2026-10-02T00:00:00.000' f, '2026-10-02T23:59:59.999' t 
  ) AS dates),
cte_0 AS (  SELECT DATE_TRUNC(CONVERT_TZ(`sales`.sold_at, 'UTC', 'Asia/Tokyo'), 'day') `sales__sold_at_day`, sum(`sales`.amount) `sales__amount_2d`  
  FROM  dw.sales_dtl  AS `sales`
  WHERE (CONVERT_TZ(`sales`.sold_at, 'UTC', 'Asia/Tokyo') >= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3)) AND CONVERT_TZ(`sales`.sold_at, 'UTC', 'Asia/Tokyo') <= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3))) GROUP BY 1 ORDER BY  1  ASC),
cte_1 AS (  SELECT `time_series`.`date_from` `sales__sold_at_day`, sum(`rolling_source`.`sales__amount_2d`) `sales__amount_2d`  
  FROM  time_series  AS `time_series`
  LEFT JOIN  cte_0  AS `rolling_source` ON `rolling_source`.`sales__sold_at_day` > DATE_SUB(`time_series`.`date_to`, INTERVAL 2 DAY) AND `rolling_source`.`sales__sold_at_day` <= `time_series`.`date_to` GROUP BY 1 ORDER BY  1  ASC)
SELECT `fk_aggregate`.`sales__sold_at_day` `sales__sold_at_day`, `fk_aggregate`.`sales__amount_2d` `sales__amount_2d`  
FROM  cte_1  AS `fk_aggregate` ORDER BY  1  ASC
-- parameters: ["2026-09-29T00:00:00.000", "2026-10-02T23:59:59.999"]

-- dst
SELECT DATE_TRUNC(CONVERT_TZ(`sales`.sold_at, 'UTC', 'America/New_York'), 'day') `sales__sold_at_day`, sum(`sales`.amount) `sales__amount`  
FROM  dw.sales_dtl  AS `sales`
WHERE (`sales`.sold_at >= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3)) AND `sales`.sold_at <= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3))) GROUP BY 1 ORDER BY  1  ASC
-- parameters: ["2026-11-01T04:00:00.000Z", "2026-11-02T04:59:59.999Z"]

-- aggregates
SELECT `sales`.channel_cd `sales__channel_cd`, count(`sales`.sale_id) `sales__row_count`, COUNT(DISTINCT `sales`.order_no) `sales__order_count`, sum(`sales`.amount) `sales__amount`, avg(`sales`.amount) `sales__avg_amount`, min(`sales`.amount) `sales__min_amount`, max(`sales`.amount) `sales__max_amount`  
FROM  dw.sales_dtl  AS `sales` GROUP BY 1 ORDER BY  1  ASC
-- parameters: []

