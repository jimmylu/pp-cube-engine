-- measure_filters
SELECT `sales`.channel_cd `sales__channel_cd`, sum(`sales`.amount) `sales__amount`  
FROM  dw.sales_dtl  AS `sales` GROUP BY 1
HAVING (sum(`sales`.amount) > CAST(? AS DOUBLE)) AND (sum(`sales`.amount) <> CAST(? AS DOUBLE) OR sum(`sales`.amount) IS NULL) ORDER BY  1  ASC
-- parameters: ["20", "110"]

-- nested_groups
SELECT sum(`sales`.amount) `sales__amount`  
FROM  dw.sales_dtl  AS `sales`
WHERE (`sales`.category_cd = ?) AND (((`sales`.channel_cd = ?) AND (`sales`.qty > CAST(? AS DOUBLE))) OR (`sales`.channel_cd = ?))
-- parameters: ["BOOK", "C3", "5", "C2"]

-- order_limit_offset
SELECT `sales`.channel_cd `sales__channel_cd`, `sales`.category_cd `sales__category_cd`, sum(`sales`.amount) `sales__amount`  
FROM  dw.sales_dtl  AS `sales` GROUP BY 1, 2 ORDER BY  1  DESC,  2  ASC
LIMIT 2 OFFSET 1
-- parameters: []

