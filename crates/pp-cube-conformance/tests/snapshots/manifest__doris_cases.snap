-- plain_range
SELECT sum(`sales`.amount) `sales__amount`  
FROM  dw.sales_dtl  AS `sales`
WHERE (`sales`.sold_at >= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3)) AND `sales`.sold_at <= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3)))
-- parameters: ["2026-10-02T00:00:00.000Z", "2026-10-04T23:59:59.999Z"]

-- query_timezone
SELECT DATE_TRUNC(CONVERT_TZ(`sales`.sold_at, 'UTC', 'UTC'), 'day') `sales__sold_at_day`, sum(`sales`.amount) `sales__amount`  
FROM  dw.sales_dtl  AS `sales`
WHERE (`sales`.sold_at >= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3)) AND `sales`.sold_at <= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3))) GROUP BY 1 ORDER BY  1  ASC
-- parameters: ["2026-10-01T00:00:00.000Z", "2026-10-01T23:59:59.999Z"]

-- filtered_source
SELECT `valid_sales`.channel_cd `valid_sales__channel_cd`, sum(`valid_sales`.amount) `valid_sales__amount`  
FROM  (SELECT channel_cd, amount FROM dw.sales_dtl WHERE is_valid = 1)  AS `valid_sales` GROUP BY 1 ORDER BY  1  ASC
-- parameters: []

-- joined_dimension
SELECT `stores`.store_name `stores__store_name`, sum(`sales`.amount) `sales__amount`  
FROM  dw.sales_dtl  AS `sales`
LEFT JOIN  dw.dim_store  AS `stores` ON `sales`.store_cd = `stores`.store_cd
WHERE (`stores`.store_name IN (?, ?)) GROUP BY 1 ORDER BY  1  ASC
-- parameters: ["central", "uptown"]

-- joined_one_to_one_measures
SELECT `sales`.channel_cd `sales__channel_cd`, sum(`receipts`.tax) `receipts__tax`, count(`receipts`.receipt_no) `receipts__receipt_count`, sum(`receipts`.tax) / NULLIF(count(`receipts`.receipt_no), 0) `receipts__tax_per_receipt`  
FROM  dw.sales_dtl  AS `sales`
LEFT JOIN  dw.receipt  AS `receipts` ON `sales`.receipt_no = `receipts`.receipt_no GROUP BY 1 ORDER BY  1  ASC
-- parameters: []

-- joined_many_to_one_counts
SELECT `sales`.category_cd `sales__category_cd`, COUNT(DISTINCT `stores`.store_cd) `stores__store_count`, COUNT(DISTINCT `stores`.store_name) `stores__name_count`  
FROM  dw.sales_dtl  AS `sales`
LEFT JOIN  dw.dim_store  AS `stores` ON `sales`.store_cd = `stores`.store_cd GROUP BY 1 ORDER BY  1  ASC
-- parameters: []

-- join_reading_a_third_cube
SELECT `promos`.promo_name `promos__promo_name`, sum(`sales`.amount) `sales__amount`  
FROM  dw.sales_dtl  AS `sales`
LEFT JOIN  dw.dim_store  AS `stores` ON `sales`.store_cd = `stores`.store_cd
LEFT JOIN  dw.dim_region  AS `regions` ON `stores`.region_cd = `regions`.region_cd
LEFT JOIN  dw.promo  AS `promos` ON `sales`.promo_cd = `promos`.promo_cd AND `promos`.region_cd = `regions`.region_cd
WHERE (`promos`.promo_name IS NOT NULL) GROUP BY 1 ORDER BY  1  ASC
-- parameters: []

-- multi_fact_by_dimension
 WITH 
cte_0 AS (  SELECT `stores`.store_name `stores__store_name`, sum(`sales`.amount) `sales__amount`  
  FROM  dw.sales_dtl  AS `sales`
  LEFT JOIN  dw.dim_store  AS `stores` ON `sales`.store_cd = `stores`.store_cd
  WHERE (`stores`.store_name IS NOT NULL) GROUP BY 1),
cte_1 AS (  SELECT `stores`.store_name `stores__store_name`, sum(`refunds`.amount) `refunds__amount`, count(`refunds`.refund_id) `refunds__refund_count`  
  FROM  dw.refund_dtl  AS `refunds`
  LEFT JOIN  dw.dim_store  AS `stores` ON `refunds`.store_cd = `stores`.store_cd
  WHERE (`stores`.store_name IS NOT NULL) GROUP BY 1)
SELECT `fk_aggregate_keys`.`stores__store_name` `stores__store_name`, `q_0`.`sales__amount` `sales__amount`, `q_1`.`refunds__amount` `refunds__amount`, `q_1`.`refunds__refund_count` `refunds__refund_count`  
FROM (SELECT DISTINCT `stores__store_name` `stores__store_name`  
FROM (SELECT DISTINCT `stores__store_name` `stores__store_name`  
FROM  cte_0  AS `cte_0`
 UNION ALL 
SELECT DISTINCT `stores__store_name` `stores__store_name`  
FROM  cte_1  AS `cte_1`) AS `fk_aggregate_keys_source`) AS `fk_aggregate_keys`
LEFT JOIN  cte_0  AS `q_0` ON ((`fk_aggregate_keys`.`stores__store_name` = `q_0`.`stores__store_name` OR ((`fk_aggregate_keys`.`stores__store_name` IS NULL) AND (`q_0`.`stores__store_name` IS NULL))))
LEFT JOIN  cte_1  AS `q_1` ON ((`fk_aggregate_keys`.`stores__store_name` = `q_1`.`stores__store_name` OR ((`fk_aggregate_keys`.`stores__store_name` IS NULL) AND (`q_1`.`stores__store_name` IS NULL)))) ORDER BY  1  ASC
-- parameters: []

-- multi_fact_null_key
 WITH 
cte_0 AS (  SELECT `stores`.store_name `stores__store_name`, sum(`sales`.amount) `sales__amount`  
  FROM  dw.sales_dtl  AS `sales`
  LEFT JOIN  dw.dim_store  AS `stores` ON `sales`.store_cd = `stores`.store_cd GROUP BY 1),
cte_1 AS (  SELECT `stores`.store_name `stores__store_name`, sum(`refunds`.amount) `refunds__amount`  
  FROM  dw.refund_dtl  AS `refunds`
  LEFT JOIN  dw.dim_store  AS `stores` ON `refunds`.store_cd = `stores`.store_cd GROUP BY 1),
cte_2 AS (  SELECT `stores`.store_name `stores__store_name`, count(`visits`.visit_id) `visits__visit_count`  
  FROM  dw.visit  AS `visits`
  LEFT JOIN  dw.dim_store  AS `stores` ON `visits`.store_cd = `stores`.store_cd GROUP BY 1)
SELECT `fk_aggregate_keys`.`stores__store_name` `stores__store_name`, `q_0`.`sales__amount` `sales__amount`, `q_1`.`refunds__amount` `refunds__amount`, `q_2`.`visits__visit_count` `visits__visit_count`  
FROM (SELECT DISTINCT `stores__store_name` `stores__store_name`  
FROM (SELECT DISTINCT `stores__store_name` `stores__store_name`  
FROM  cte_0  AS `cte_0`
 UNION ALL 
SELECT DISTINCT `stores__store_name` `stores__store_name`  
FROM  cte_1  AS `cte_1`
 UNION ALL 
SELECT DISTINCT `stores__store_name` `stores__store_name`  
FROM  cte_2  AS `cte_2`) AS `fk_aggregate_keys_source`) AS `fk_aggregate_keys`
LEFT JOIN  cte_0  AS `q_0` ON ((`fk_aggregate_keys`.`stores__store_name` = `q_0`.`stores__store_name` OR ((`fk_aggregate_keys`.`stores__store_name` IS NULL) AND (`q_0`.`stores__store_name` IS NULL))))
LEFT JOIN  cte_1  AS `q_1` ON ((`fk_aggregate_keys`.`stores__store_name` = `q_1`.`stores__store_name` OR ((`fk_aggregate_keys`.`stores__store_name` IS NULL) AND (`q_1`.`stores__store_name` IS NULL))))
LEFT JOIN  cte_2  AS `q_2` ON ((`fk_aggregate_keys`.`stores__store_name` = `q_2`.`stores__store_name` OR ((`fk_aggregate_keys`.`stores__store_name` IS NULL) AND (`q_2`.`stores__store_name` IS NULL))))
WHERE (`q_2`.`visits__visit_count` > CAST(? AS DOUBLE)) ORDER BY  4  DESC,  2  DESC
-- parameters: ["0"]

-- multi_fact_totals
 WITH 
cte_0 AS (  SELECT sum(`sales`.amount) `sales__amount`  
  FROM  dw.sales_dtl  AS `sales`),
cte_1 AS (  SELECT sum(`refunds`.amount) `refunds__amount`  
  FROM  dw.refund_dtl  AS `refunds`)
SELECT `q_0`.`sales__amount` `sales__amount`, `q_1`.`refunds__amount` `refunds__amount`  
FROM  cte_0  AS `q_0`
INNER JOIN  cte_1  AS `q_1` ON 1 = 1
-- parameters: []

-- multi_fact_page
 WITH 
cte_0 AS (  SELECT `stores`.store_name `stores__store_name`, sum(`sales`.amount) `sales__amount`  
  FROM  dw.sales_dtl  AS `sales`
  LEFT JOIN  dw.dim_store  AS `stores` ON `sales`.store_cd = `stores`.store_cd
  WHERE (`stores`.store_name IS NOT NULL) GROUP BY 1),
cte_1 AS (  SELECT `stores`.store_name `stores__store_name`, sum(`refunds`.amount) `refunds__amount`  
  FROM  dw.refund_dtl  AS `refunds`
  LEFT JOIN  dw.dim_store  AS `stores` ON `refunds`.store_cd = `stores`.store_cd
  WHERE (`stores`.store_name IS NOT NULL) GROUP BY 1)
SELECT `fk_aggregate_keys`.`stores__store_name` `stores__store_name`, `q_0`.`sales__amount` `sales__amount`, `q_1`.`refunds__amount` `refunds__amount`  
FROM (SELECT DISTINCT `stores__store_name` `stores__store_name`  
FROM (SELECT DISTINCT `stores__store_name` `stores__store_name`  
FROM  cte_0  AS `cte_0`
 UNION ALL 
SELECT DISTINCT `stores__store_name` `stores__store_name`  
FROM  cte_1  AS `cte_1`) AS `fk_aggregate_keys_source`) AS `fk_aggregate_keys`
LEFT JOIN  cte_0  AS `q_0` ON ((`fk_aggregate_keys`.`stores__store_name` = `q_0`.`stores__store_name` OR ((`fk_aggregate_keys`.`stores__store_name` IS NULL) AND (`q_0`.`stores__store_name` IS NULL))))
LEFT JOIN  cte_1  AS `q_1` ON ((`fk_aggregate_keys`.`stores__store_name` = `q_1`.`stores__store_name` OR ((`fk_aggregate_keys`.`stores__store_name` IS NULL) AND (`q_1`.`stores__store_name` IS NULL)))) ORDER BY  2  DESC
LIMIT 1 OFFSET 1
-- parameters: []

-- sum_over_repeated_rows
 WITH 
cte_0 AS (  SELECT `sales`.category_cd `sales__category_cd`, sum(`sales`.amount) `sales__amount`  
  FROM  dw.sales_dtl  AS `sales` GROUP BY 1),
cte_1 AS (  SELECT `keys`.`sales__category_cd` `sales__category_cd`, sum(`stores_key_stores`.floor_area) `stores__floor_area`  
  FROM (SELECT DISTINCT `stores_key_sales`.category_cd `sales__category_cd`, `stores_key_stores`.store_cd `stores__store_cd`  
  FROM  dw.sales_dtl  AS `stores_key_sales`
  LEFT JOIN  dw.dim_store  AS `stores_key_stores` ON `stores_key_sales`.store_cd = `stores_key_stores`.store_cd) AS `keys`
  LEFT JOIN  dw.dim_store  AS `stores_key_stores` ON ((`keys`.`stores__store_cd` = `stores_key_stores`.store_cd)) GROUP BY 1)
SELECT `fk_aggregate_keys`.`sales__category_cd` `sales__category_cd`, `q_0`.`sales__amount` `sales__amount`, `q_1`.`stores__floor_area` `stores__floor_area`  
FROM (SELECT DISTINCT `sales__category_cd` `sales__category_cd`  
FROM (SELECT DISTINCT `sales__category_cd` `sales__category_cd`  
FROM  cte_0  AS `cte_0`
 UNION ALL 
SELECT DISTINCT `sales__category_cd` `sales__category_cd`  
FROM  cte_1  AS `cte_1`) AS `fk_aggregate_keys_source`) AS `fk_aggregate_keys`
LEFT JOIN  cte_0  AS `q_0` ON ((`fk_aggregate_keys`.`sales__category_cd` = `q_0`.`sales__category_cd` OR ((`fk_aggregate_keys`.`sales__category_cd` IS NULL) AND (`q_0`.`sales__category_cd` IS NULL))))
LEFT JOIN  cte_1  AS `q_1` ON ((`fk_aggregate_keys`.`sales__category_cd` = `q_1`.`sales__category_cd` OR ((`fk_aggregate_keys`.`sales__category_cd` IS NULL) AND (`q_1`.`sales__category_cd` IS NULL)))) ORDER BY  1  ASC
-- parameters: []

-- two_cubes_in_one_select
SELECT `sales`.channel_cd `sales__channel_cd`, sum(`sales`.amount) `sales__amount`, sum(`receipts`.tax) `receipts__tax`  
FROM  dw.sales_dtl  AS `sales`
LEFT JOIN  dw.receipt  AS `receipts` ON `sales`.receipt_no = `receipts`.receipt_no GROUP BY 1 ORDER BY  1  ASC
-- parameters: []

-- security_multi_fact
 WITH 
cte_0 AS (  SELECT `stores`.store_name `stores__store_name`, sum(`sales`.amount) `sales__amount`  
  FROM  dw.sales_dtl  AS `sales`
  LEFT JOIN  dw.dim_store  AS `stores` ON `sales`.store_cd = `stores`.store_cd
  LEFT JOIN  dw.dim_region  AS `regions` ON `stores`.region_cd = `regions`.region_cd
  WHERE (`regions`.region_name = ?) GROUP BY 1),
cte_1 AS (  SELECT `stores`.store_name `stores__store_name`, sum(`refunds`.amount) `refunds__amount`  
  FROM  dw.refund_dtl  AS `refunds`
  LEFT JOIN  dw.dim_store  AS `stores` ON `refunds`.store_cd = `stores`.store_cd
  LEFT JOIN  dw.dim_region  AS `regions` ON `stores`.region_cd = `regions`.region_cd
  WHERE (`regions`.region_name = ?) GROUP BY 1)
SELECT `fk_aggregate_keys`.`stores__store_name` `stores__store_name`, `q_0`.`sales__amount` `sales__amount`, `q_1`.`refunds__amount` `refunds__amount`  
FROM (SELECT DISTINCT `stores__store_name` `stores__store_name`  
FROM (SELECT DISTINCT `stores__store_name` `stores__store_name`  
FROM  cte_0  AS `cte_0`
 UNION ALL 
SELECT DISTINCT `stores__store_name` `stores__store_name`  
FROM  cte_1  AS `cte_1`) AS `fk_aggregate_keys_source`) AS `fk_aggregate_keys`
LEFT JOIN  cte_0  AS `q_0` ON ((`fk_aggregate_keys`.`stores__store_name` = `q_0`.`stores__store_name` OR ((`fk_aggregate_keys`.`stores__store_name` IS NULL) AND (`q_0`.`stores__store_name` IS NULL))))
LEFT JOIN  cte_1  AS `q_1` ON ((`fk_aggregate_keys`.`stores__store_name` = `q_1`.`stores__store_name` OR ((`fk_aggregate_keys`.`stores__store_name` IS NULL) AND (`q_1`.`stores__store_name` IS NULL)))) ORDER BY  1  ASC
-- parameters: ["north", "north"]

-- security_two_hop_join
SELECT sum(`sales`.amount) `sales__amount`  
FROM  dw.sales_dtl  AS `sales`
LEFT JOIN  dw.dim_store  AS `stores` ON `sales`.store_cd = `stores`.store_cd
LEFT JOIN  dw.dim_region  AS `regions` ON `stores`.region_cd = `regions`.region_cd
WHERE ((`sales`.is_valid = 1) = CAST(? AS BOOLEAN)) AND (`regions`.region_name = ?)
-- parameters: ["true", "north"]

-- security_pattern
SELECT sum(`sales`.amount) `sales__amount`  
FROM  dw.sales_dtl  AS `sales`
WHERE (((LOWER(`sales`.region_cd) LIKE CONCAT('%', LOWER(?), '%'))) OR (`sales`.channel_cd = ?)) AND ((LOWER(`sales`.region_cd) LIKE CONCAT('', LOWER(?), '%')))
-- parameters: ["north", "C3", "a\\%"]

-- rolling_trailing
 WITH 
time_series AS (  SELECT CAST(REPLACE(dates.f, 'T', ' ') AS DATETIMEV2(3)) date_from, CAST(REPLACE(dates.t, 'T', ' ') AS DATETIMEV2(3)) date_to 
  FROM (
      select '2026-10-01T00:00:00.000' f, '2026-10-01T23:59:59.999' t 
   UNION ALL
      select '2026-10-02T00:00:00.000' f, '2026-10-02T23:59:59.999' t 
   UNION ALL
      select '2026-10-03T00:00:00.000' f, '2026-10-03T23:59:59.999' t 
   UNION ALL
      select '2026-10-04T00:00:00.000' f, '2026-10-04T23:59:59.999' t 
   UNION ALL
      select '2026-10-05T00:00:00.000' f, '2026-10-05T23:59:59.999' t 
   UNION ALL
      select '2026-10-06T00:00:00.000' f, '2026-10-06T23:59:59.999' t 
   UNION ALL
      select '2026-10-07T00:00:00.000' f, '2026-10-07T23:59:59.999' t 
  ) AS dates),
cte_0 AS (  SELECT DATE_TRUNC(CONVERT_TZ(`sales`.sold_at, 'UTC', 'UTC'), 'day') `sales__sold_at_day`, sum(`sales`.amount) `sales__amount_3d`  
  FROM  dw.sales_dtl  AS `sales`
  WHERE (CONVERT_TZ(`sales`.sold_at, 'UTC', 'UTC') >= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3)) AND CONVERT_TZ(`sales`.sold_at, 'UTC', 'UTC') <= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3))) GROUP BY 1 ORDER BY  1  ASC),
cte_1 AS (  SELECT `time_series`.`date_from` `sales__sold_at_day`, sum(`rolling_source`.`sales__amount_3d`) `sales__amount_3d`  
  FROM  time_series  AS `time_series`
  LEFT JOIN  cte_0  AS `rolling_source` ON `rolling_source`.`sales__sold_at_day` > DATE_SUB(`time_series`.`date_to`, INTERVAL 3 DAY) AND `rolling_source`.`sales__sold_at_day` <= `time_series`.`date_to` GROUP BY 1 ORDER BY  1  ASC)
SELECT `fk_aggregate`.`sales__sold_at_day` `sales__sold_at_day`, `fk_aggregate`.`sales__amount_3d` `sales__amount_3d`  
FROM  cte_1  AS `fk_aggregate` ORDER BY  1  ASC
-- parameters: ["2026-09-28T00:00:00.000", "2026-10-07T23:59:59.999"]

-- rolling_distinct_count
 WITH 
time_series AS (  SELECT CAST(REPLACE(dates.f, 'T', ' ') AS DATETIMEV2(3)) date_from, CAST(REPLACE(dates.t, 'T', ' ') AS DATETIMEV2(3)) date_to 
  FROM (
      select '2026-10-02T00:00:00.000' f, '2026-10-02T23:59:59.999' t 
   UNION ALL
      select '2026-10-03T00:00:00.000' f, '2026-10-03T23:59:59.999' t 
  ) AS dates),
cte_0 AS (  SELECT DATE_TRUNC(CONVERT_TZ(`sales`.sold_at, 'UTC', 'UTC'), 'day') `sales__sold_at_day`, `sales`.order_no `sales__orders_2d`  
  FROM  dw.sales_dtl  AS `sales`
  WHERE (CONVERT_TZ(`sales`.sold_at, 'UTC', 'UTC') >= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3)) AND CONVERT_TZ(`sales`.sold_at, 'UTC', 'UTC') <= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3))) ORDER BY  1  ASC),
cte_1 AS (  SELECT `time_series`.`date_from` `sales__sold_at_day`, COUNT(DISTINCT `rolling_source`.`sales__orders_2d`) `sales__orders_2d`  
  FROM  time_series  AS `time_series`
  LEFT JOIN  cte_0  AS `rolling_source` ON `rolling_source`.`sales__sold_at_day` > DATE_SUB(`time_series`.`date_to`, INTERVAL 2 DAY) AND `rolling_source`.`sales__sold_at_day` <= `time_series`.`date_to` GROUP BY 1 ORDER BY  1  ASC)
SELECT `fk_aggregate`.`sales__sold_at_day` `sales__sold_at_day`, `fk_aggregate`.`sales__orders_2d` `sales__orders_2d`  
FROM  cte_1  AS `fk_aggregate` ORDER BY  1  ASC
-- parameters: ["2026-09-30T00:00:00.000", "2026-10-03T23:59:59.999"]

-- month_to_date
 WITH 
time_series AS (  SELECT CAST(REPLACE(dates.f, 'T', ' ') AS DATETIMEV2(3)) date_from, CAST(REPLACE(dates.t, 'T', ' ') AS DATETIMEV2(3)) date_to 
  FROM (
      select '2026-10-04T00:00:00.000' f, '2026-10-04T23:59:59.999' t 
   UNION ALL
      select '2026-10-05T00:00:00.000' f, '2026-10-05T23:59:59.999' t 
   UNION ALL
      select '2026-10-06T00:00:00.000' f, '2026-10-06T23:59:59.999' t 
  ) AS dates),
cte_0 AS (  SELECT DATE_TRUNC(CONVERT_TZ(`sales`.sold_at, 'UTC', 'UTC'), 'day') `sales__sold_at_day`, sum(`sales`.amount) `sales__amount_mtd`  
  FROM  dw.sales_dtl  AS `sales`
  WHERE (CONVERT_TZ(`sales`.sold_at, 'UTC', 'UTC') >= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3)) AND CONVERT_TZ(`sales`.sold_at, 'UTC', 'UTC') <= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3))) GROUP BY 1 ORDER BY  1  ASC),
cte_1 AS (  SELECT `time_series`.`date_from` `sales__sold_at_day`, sum(`rolling_source`.`sales__amount_mtd`) `sales__amount_mtd`  
  FROM  time_series  AS `time_series`
  LEFT JOIN  cte_0  AS `rolling_source` ON `rolling_source`.`sales__sold_at_day` >= DATE_TRUNC(`time_series`.`date_from`, 'month') and `rolling_source`.`sales__sold_at_day` <= `time_series`.`date_to` GROUP BY 1 ORDER BY  1  ASC)
SELECT `fk_aggregate`.`sales__sold_at_day` `sales__sold_at_day`, `fk_aggregate`.`sales__amount_mtd` `sales__amount_mtd`  
FROM  cte_1  AS `fk_aggregate` ORDER BY  1  ASC
-- parameters: ["2026-10-01T00:00:00.000", "2026-10-06T23:59:59.999"]

-- rolling_at_range_end
 WITH 
cte_0 AS (  SELECT sum(`sales`.amount) `sales__amount_3d`  
  FROM  dw.sales_dtl  AS `sales`
  WHERE (`sales`.sold_at > CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3)) AND `sales`.sold_at <= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3))))
SELECT `fk_aggregate`.`sales__amount_3d` `sales__amount_3d`  
FROM  cte_0  AS `fk_aggregate`
-- parameters: ["2026-10-01T23:59:59.999Z", "2026-10-04T23:59:59.999Z"]

-- running_total_by_month
 WITH 
time_series AS (  SELECT CAST(REPLACE(dates.f, 'T', ' ') AS DATETIMEV2(3)) date_from, CAST(REPLACE(dates.t, 'T', ' ') AS DATETIMEV2(3)) date_to 
  FROM (
      select '2026-09-01T00:00:00.000' f, '2026-09-30T23:59:59.999' t 
   UNION ALL
      select '2026-10-01T00:00:00.000' f, '2026-10-31T23:59:59.999' t 
   UNION ALL
      select '2026-11-01T00:00:00.000' f, '2026-11-30T23:59:59.999' t 
  ) AS dates),
cte_0 AS (  SELECT DATE_TRUNC(CONVERT_TZ(`sales`.sold_at, 'UTC', 'UTC'), 'month') `sales__sold_at_month`, sum(`sales`.amount) `sales__amount_so_far`  
  FROM  dw.sales_dtl  AS `sales`
  WHERE (CONVERT_TZ(`sales`.sold_at, 'UTC', 'UTC') <= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3))) GROUP BY 1 ORDER BY  1  ASC),
cte_1 AS (  SELECT `time_series`.`date_from` `sales__sold_at_month`, sum(`rolling_source`.`sales__amount_so_far`) `sales__amount_so_far`  
  FROM  time_series  AS `time_series`
  LEFT JOIN  cte_0  AS `rolling_source` ON `rolling_source`.`sales__sold_at_month` <= `time_series`.`date_to` GROUP BY 1 ORDER BY  1  ASC)
SELECT `fk_aggregate`.`sales__sold_at_month` `sales__sold_at_month`, `fk_aggregate`.`sales__amount_so_far` `sales__amount_so_far`  
FROM  cte_1  AS `fk_aggregate` ORDER BY  1  ASC
-- parameters: ["2026-11-30T23:59:59.999"]

-- prior_day
 WITH 
cte_0 AS (  SELECT DATE_TRUNC(CONVERT_TZ((DATE_ADD(`sales`.sold_at, INTERVAL 1 DAY)), 'UTC', 'UTC'), 'day') `sales__sold_at_day`, sum(`sales`.amount) `sales__amount`  
  FROM  dw.sales_dtl  AS `sales`
  WHERE ((DATE_ADD(`sales`.sold_at, INTERVAL 1 DAY)) >= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3)) AND (DATE_ADD(`sales`.sold_at, INTERVAL 1 DAY)) <= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3))) GROUP BY 1 ORDER BY  1  ASC),
cte_1 AS (  SELECT `fk_aggregate`.`sales__sold_at_day` `sales__sold_at_day`, `fk_aggregate`.`sales__amount` `sales__amount_prior_day`  
  FROM  cte_0  AS `fk_aggregate`),
cte_2 AS (  SELECT DATE_TRUNC(CONVERT_TZ(`sales`.sold_at, 'UTC', 'UTC'), 'day') `sales__sold_at_day`, sum(`sales`.amount) `sales__amount`  
  FROM  dw.sales_dtl  AS `sales`
  WHERE (`sales`.sold_at >= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3)) AND `sales`.sold_at <= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3))) GROUP BY 1)
SELECT `fk_aggregate_keys`.`sales__sold_at_day` `sales__sold_at_day`, `q_1`.`sales__amount` `sales__amount`, `q_0`.`sales__amount_prior_day` `sales__amount_prior_day`  
FROM (SELECT DISTINCT `sales__sold_at_day` `sales__sold_at_day`  
FROM (SELECT DISTINCT `sales__sold_at_day` `sales__sold_at_day`  
FROM  cte_1  AS `cte_1`
 UNION ALL 
SELECT DISTINCT `sales__sold_at_day` `sales__sold_at_day`  
FROM  cte_2  AS `cte_2`) AS `fk_aggregate_keys_source`) AS `fk_aggregate_keys`
LEFT JOIN  cte_1  AS `q_0` ON ((`fk_aggregate_keys`.`sales__sold_at_day` = `q_0`.`sales__sold_at_day` OR ((`fk_aggregate_keys`.`sales__sold_at_day` IS NULL) AND (`q_0`.`sales__sold_at_day` IS NULL))))
LEFT JOIN  cte_2  AS `q_1` ON ((`fk_aggregate_keys`.`sales__sold_at_day` = `q_1`.`sales__sold_at_day` OR ((`fk_aggregate_keys`.`sales__sold_at_day` IS NULL) AND (`q_1`.`sales__sold_at_day` IS NULL)))) ORDER BY  1  ASC
-- parameters: ["2026-10-02T00:00:00.000Z", "2026-10-04T23:59:59.999Z", "2026-10-02T00:00:00.000Z", "2026-10-04T23:59:59.999Z"]

-- change_from_prior_day
 WITH 
cte_0 AS (  SELECT DATE_TRUNC(CONVERT_TZ(`sales`.sold_at, 'UTC', 'UTC'), 'day') `sales__sold_at_day`, sum(`sales`.amount) `sales__amount`  
  FROM  dw.sales_dtl  AS `sales`
  WHERE (`sales`.sold_at >= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3)) AND `sales`.sold_at <= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3))) GROUP BY 1 ORDER BY  1  ASC),
cte_1 AS (  SELECT DATE_TRUNC(CONVERT_TZ((DATE_ADD(`sales`.sold_at, INTERVAL 1 DAY)), 'UTC', 'UTC'), 'day') `sales__sold_at_day`, sum(`sales`.amount) `sales__amount`  
  FROM  dw.sales_dtl  AS `sales`
  WHERE ((DATE_ADD(`sales`.sold_at, INTERVAL 1 DAY)) >= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3)) AND (DATE_ADD(`sales`.sold_at, INTERVAL 1 DAY)) <= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3))) GROUP BY 1 ORDER BY  1  ASC),
cte_2 AS (  SELECT `fk_aggregate`.`sales__sold_at_day` `sales__sold_at_day`, `fk_aggregate`.`sales__amount` `sales__amount_prior_day`  
  FROM  cte_1  AS `fk_aggregate`),
cte_3 AS (  SELECT `fk_aggregate_keys`.`sales__sold_at_day` `sales__sold_at_day`, `q_0`.`sales__amount` - `q_1`.`sales__amount_prior_day` `sales__amount_change`  
  FROM (SELECT DISTINCT `sales__sold_at_day` `sales__sold_at_day`  
  FROM (SELECT DISTINCT `sales__sold_at_day` `sales__sold_at_day`  
  FROM  cte_0  AS `cte_0`
   UNION ALL 
  SELECT DISTINCT `sales__sold_at_day` `sales__sold_at_day`  
  FROM  cte_2  AS `cte_2`) AS `fk_aggregate_keys_source`) AS `fk_aggregate_keys`
  LEFT JOIN  cte_0  AS `q_0` ON ((`fk_aggregate_keys`.`sales__sold_at_day` = `q_0`.`sales__sold_at_day` OR ((`fk_aggregate_keys`.`sales__sold_at_day` IS NULL) AND (`q_0`.`sales__sold_at_day` IS NULL))))
  LEFT JOIN  cte_2  AS `q_1` ON ((`fk_aggregate_keys`.`sales__sold_at_day` = `q_1`.`sales__sold_at_day` OR ((`fk_aggregate_keys`.`sales__sold_at_day` IS NULL) AND (`q_1`.`sales__sold_at_day` IS NULL)))))
SELECT `fk_aggregate`.`sales__sold_at_day` `sales__sold_at_day`, `fk_aggregate`.`sales__amount_change` `sales__amount_change`  
FROM  cte_3  AS `fk_aggregate` ORDER BY  1  ASC
-- parameters: ["2026-10-02T00:00:00.000Z", "2026-10-04T23:59:59.999Z", "2026-10-02T00:00:00.000Z", "2026-10-04T23:59:59.999Z"]

-- security_rolling
 WITH 
time_series AS (  SELECT CAST(REPLACE(dates.f, 'T', ' ') AS DATETIMEV2(3)) date_from, CAST(REPLACE(dates.t, 'T', ' ') AS DATETIMEV2(3)) date_to 
  FROM (
      select '2026-10-01T00:00:00.000' f, '2026-10-01T23:59:59.999' t 
   UNION ALL
      select '2026-10-02T00:00:00.000' f, '2026-10-02T23:59:59.999' t 
   UNION ALL
      select '2026-10-03T00:00:00.000' f, '2026-10-03T23:59:59.999' t 
  ) AS dates),
cte_0 AS (  SELECT DATE_TRUNC(CONVERT_TZ(`sales`.sold_at, 'UTC', 'UTC'), 'day') `sales__sold_at_day`, sum(`sales`.amount) `sales__amount_3d`  
  FROM  dw.sales_dtl  AS `sales`
  WHERE (CONVERT_TZ(`sales`.sold_at, 'UTC', 'UTC') >= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3)) AND CONVERT_TZ(`sales`.sold_at, 'UTC', 'UTC') <= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3))) AND (`sales`.channel_cd = ?) GROUP BY 1 ORDER BY  1  ASC),
cte_1 AS (  SELECT `time_series`.`date_from` `sales__sold_at_day`, sum(`rolling_source`.`sales__amount_3d`) `sales__amount_3d`  
  FROM  time_series  AS `time_series`
  LEFT JOIN  cte_0  AS `rolling_source` ON `rolling_source`.`sales__sold_at_day` > DATE_SUB(`time_series`.`date_to`, INTERVAL 3 DAY) AND `rolling_source`.`sales__sold_at_day` <= `time_series`.`date_to` GROUP BY 1 ORDER BY  1  ASC)
SELECT `fk_aggregate`.`sales__sold_at_day` `sales__sold_at_day`, `fk_aggregate`.`sales__amount_3d` `sales__amount_3d`  
FROM  cte_1  AS `fk_aggregate` ORDER BY  1  ASC
-- parameters: ["2026-09-28T00:00:00.000", "2026-10-03T23:59:59.999", "C1"]

-- ungrouped_rows
SELECT `sales`.sale_id `sales__sale_id`, `sales`.channel_cd `sales__channel_cd`, `sales`.amount `sales__amount`, CASE WHEN (`sales`.sale_id) IS NOT NULL THEN 1 END `sales__row_count`, CASE WHEN (`sales`.category_cd = 'TOY') THEN `sales`.amount END `sales__toy_amount`  
FROM  dw.sales_dtl  AS `sales`
WHERE (`sales`.channel_cd = ?) ORDER BY  1  ASC
-- parameters: ["C2"]

-- ungrouped_joined_page
SELECT `sales`.sale_id `sales__sale_id`, `stores`.store_name `stores__store_name`, `sales`.amount `sales__amount`  
FROM  dw.sales_dtl  AS `sales`
LEFT JOIN  dw.dim_store  AS `stores` ON `sales`.store_cd = `stores`.store_cd ORDER BY  1  DESC
LIMIT 2 OFFSET 1
-- parameters: []

-- approximate_distinct_count
SELECT `sales`.channel_cd `sales__channel_cd`, APPROX_COUNT_DISTINCT(`sales`.order_no) `sales__order_count_approx`  
FROM  dw.sales_dtl  AS `sales` GROUP BY 1 ORDER BY  1  ASC
-- parameters: []

-- granularity_of_two_days
SELECT DAY_FLOOR(CONVERT_TZ(`sales`.sold_at, 'UTC', 'UTC'), 2, CAST('2026-10-01 00:00:00.000' AS DATETIMEV2(3))) `sales__sold_at_two_days`, sum(`sales`.amount) `sales__amount`  
FROM  dw.sales_dtl  AS `sales`
WHERE (`sales`.sold_at >= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3)) AND `sales`.sold_at <= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3))) GROUP BY 1 ORDER BY  1  ASC
-- parameters: ["2026-10-01T00:00:00.000Z", "2026-10-31T23:59:59.999Z"]

-- granularity_of_two_quarters
SELECT MONTH_FLOOR(CONVERT_TZ(`sales`.sold_at, 'UTC', 'UTC'), 6, CAST('2026-01-01 00:00:00.000' AS DATETIMEV2(3))) `sales__sold_at_half_year`, sum(`sales`.amount) `sales__amount`  
FROM  dw.sales_dtl  AS `sales`
WHERE (`sales`.sold_at >= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3)) AND `sales`.sold_at <= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3))) GROUP BY 1 ORDER BY  1  ASC
-- parameters: ["2026-10-01T00:00:00.000Z", "2026-10-31T23:59:59.999Z"]

-- granularity_with_offset
SELECT DATE_ADD(DATE_TRUNC(DATE_SUB(CONVERT_TZ(`sales`.sold_at, 'UTC', 'UTC'), INTERVAL 3 DAY), 'week'), INTERVAL 3 DAY) `sales__sold_at_retail_week`, sum(`sales`.amount) `sales__amount`  
FROM  dw.sales_dtl  AS `sales`
WHERE (`sales`.sold_at >= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3)) AND `sales`.sold_at <= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3))) GROUP BY 1 ORDER BY  1  ASC
-- parameters: ["2026-10-01T00:00:00.000Z", "2026-10-31T23:59:59.999Z"]

-- view_by_joined_dimension
SELECT `stores`.store_name `sales_overview__stores_store_name`, sum(`sales`.amount) `sales_overview__amount`  
FROM  dw.sales_dtl  AS `sales`
LEFT JOIN  dw.dim_store  AS `stores` ON `sales`.store_cd = `stores`.store_cd GROUP BY 1 ORDER BY  1  ASC
-- parameters: []

-- view_two_hops_filtered
SELECT `regions`.region_name `sales_overview__region_name`, sum(`sales`.amount) `sales_overview__amount`, count(`sales`.sale_id) `sales_overview__row_count`  
FROM  dw.sales_dtl  AS `sales`
LEFT JOIN  dw.dim_store  AS `stores` ON `sales`.store_cd = `stores`.store_cd
LEFT JOIN  dw.dim_region  AS `regions` ON `stores`.region_cd = `regions`.region_cd
WHERE (`sales`.channel_cd IN (?, ?)) GROUP BY 1 ORDER BY  1  ASC
-- parameters: ["C1", "C2"]

-- view_sum_over_repeated_rows
 WITH 
cte_0 AS (  SELECT `sales`.channel_cd `sales_overview__channel_cd`, sum(`sales`.amount) `sales__amount`  
  FROM  dw.sales_dtl  AS `sales` GROUP BY 1),
cte_1 AS (  SELECT `keys`.`sales_overview__channel_cd` `sales_overview__channel_cd`, sum(`stores_key_stores`.floor_area) `stores__floor_area`  
  FROM (SELECT DISTINCT `stores_key_sales`.channel_cd `sales_overview__channel_cd`, `stores_key_stores`.store_cd `stores__store_cd`  
  FROM  dw.sales_dtl  AS `stores_key_sales`
  LEFT JOIN  dw.dim_store  AS `stores_key_stores` ON `stores_key_sales`.store_cd = `stores_key_stores`.store_cd) AS `keys`
  LEFT JOIN  dw.dim_store  AS `stores_key_stores` ON ((`keys`.`stores__store_cd` = `stores_key_stores`.store_cd)) GROUP BY 1)
SELECT `fk_aggregate_keys`.`sales_overview__channel_cd` `sales_overview__channel_cd`, `q_0`.`sales__amount` `sales_overview__amount`, `q_1`.`stores__floor_area` `sales_overview__stores_floor_area`  
FROM (SELECT DISTINCT `sales_overview__channel_cd` `sales_overview__channel_cd`  
FROM (SELECT DISTINCT `sales_overview__channel_cd` `sales_overview__channel_cd`  
FROM  cte_0  AS `cte_0`
 UNION ALL 
SELECT DISTINCT `sales_overview__channel_cd` `sales_overview__channel_cd`  
FROM  cte_1  AS `cte_1`) AS `fk_aggregate_keys_source`) AS `fk_aggregate_keys`
LEFT JOIN  cte_0  AS `q_0` ON ((`fk_aggregate_keys`.`sales_overview__channel_cd` = `q_0`.`sales_overview__channel_cd` OR ((`fk_aggregate_keys`.`sales_overview__channel_cd` IS NULL) AND (`q_0`.`sales_overview__channel_cd` IS NULL))))
LEFT JOIN  cte_1  AS `q_1` ON ((`fk_aggregate_keys`.`sales_overview__channel_cd` = `q_1`.`sales_overview__channel_cd` OR ((`fk_aggregate_keys`.`sales_overview__channel_cd` IS NULL) AND (`q_1`.`sales_overview__channel_cd` IS NULL)))) ORDER BY  1  ASC
-- parameters: []

-- view_formula_and_one_to_one
 WITH 
cte_0 AS (  SELECT `sales`.channel_cd `sales_overview__channel_cd`, sum(`sales`.amount) / NULLIF(COUNT(DISTINCT `sales`.order_no), 0) `sales__amount_per_order`  
  FROM  dw.sales_dtl  AS `sales` GROUP BY 1),
cte_1 AS (  SELECT `sales`.channel_cd `sales_overview__channel_cd`, sum(`receipts`.tax) `receipts__tax`  
  FROM  dw.sales_dtl  AS `sales`
  LEFT JOIN  dw.receipt  AS `receipts` ON `sales`.receipt_no = `receipts`.receipt_no GROUP BY 1)
SELECT `fk_aggregate_keys`.`sales_overview__channel_cd` `sales_overview__channel_cd`, `q_0`.`sales__amount_per_order` `sales_overview__amount_per_order`, `q_1`.`receipts__tax` `sales_overview__tax`  
FROM (SELECT DISTINCT `sales_overview__channel_cd` `sales_overview__channel_cd`  
FROM (SELECT DISTINCT `sales_overview__channel_cd` `sales_overview__channel_cd`  
FROM  cte_0  AS `cte_0`
 UNION ALL 
SELECT DISTINCT `sales_overview__channel_cd` `sales_overview__channel_cd`  
FROM  cte_1  AS `cte_1`) AS `fk_aggregate_keys_source`) AS `fk_aggregate_keys`
LEFT JOIN  cte_0  AS `q_0` ON ((`fk_aggregate_keys`.`sales_overview__channel_cd` = `q_0`.`sales_overview__channel_cd` OR ((`fk_aggregate_keys`.`sales_overview__channel_cd` IS NULL) AND (`q_0`.`sales_overview__channel_cd` IS NULL))))
LEFT JOIN  cte_1  AS `q_1` ON ((`fk_aggregate_keys`.`sales_overview__channel_cd` = `q_1`.`sales_overview__channel_cd` OR ((`fk_aggregate_keys`.`sales_overview__channel_cd` IS NULL) AND (`q_1`.`sales_overview__channel_cd` IS NULL)))) ORDER BY  1  ASC
-- parameters: []

-- security_view
SELECT `stores`.store_name `sales_overview__stores_store_name`, sum(`sales`.amount) `sales_overview__amount`  
FROM  dw.sales_dtl  AS `sales`
LEFT JOIN  dw.dim_store  AS `stores` ON `sales`.store_cd = `stores`.store_cd
LEFT JOIN  dw.dim_region  AS `regions` ON `stores`.region_cd = `regions`.region_cd
WHERE (`regions`.region_name = ?) GROUP BY 1 ORDER BY  1  ASC
-- parameters: ["north"]

-- uw_renewal_share_by_branch
SELECT `branches`.branch_name `branches__branch_name`, CAST(count(CASE WHEN (`policies`.renewal_of IS NOT NULL) THEN `policies`.policy_id END) AS DOUBLE) / NULLIF(count(`policies`.policy_id), 0) `policies__renewal_share`, count(CASE WHEN (`policies`.renewal_of IS NOT NULL) THEN `policies`.policy_id END) `policies__renewed_count`, count(`policies`.policy_id) `policies__policy_count`  
FROM  dw.ins_policy  AS `policies`
LEFT JOIN  dw.ins_branch  AS `branches` ON `policies`.branch_cd = `branches`.branch_cd GROUP BY 1 ORDER BY  1  ASC
-- parameters: []

-- uw_premium_ytd_by_month
 WITH 
time_series AS (  SELECT CAST(REPLACE(dates.f, 'T', ' ') AS DATETIMEV2(3)) date_from, CAST(REPLACE(dates.t, 'T', ' ') AS DATETIMEV2(3)) date_to 
  FROM (
      select '2026-01-01T00:00:00.000' f, '2026-01-31T23:59:59.999' t 
   UNION ALL
      select '2026-02-01T00:00:00.000' f, '2026-02-28T23:59:59.999' t 
   UNION ALL
      select '2026-03-01T00:00:00.000' f, '2026-03-31T23:59:59.999' t 
   UNION ALL
      select '2026-04-01T00:00:00.000' f, '2026-04-30T23:59:59.999' t 
   UNION ALL
      select '2026-05-01T00:00:00.000' f, '2026-05-31T23:59:59.999' t 
   UNION ALL
      select '2026-06-01T00:00:00.000' f, '2026-06-30T23:59:59.999' t 
  ) AS dates),
cte_0 AS (  SELECT DATE_TRUNC(CONVERT_TZ(`policies`.issued_at, 'UTC', 'UTC'), 'month') `policies__issued_at_month`, sum(`policies`.written_premium) `policies__written_premium_ytd`  
  FROM  dw.ins_policy  AS `policies`
  WHERE (CONVERT_TZ(`policies`.issued_at, 'UTC', 'UTC') >= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3)) AND CONVERT_TZ(`policies`.issued_at, 'UTC', 'UTC') <= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3))) GROUP BY 1 ORDER BY  1  ASC),
cte_1 AS (  SELECT `time_series`.`date_from` `policies__issued_at_month`, sum(`rolling_source`.`policies__written_premium_ytd`) `policies__written_premium_ytd`  
  FROM  time_series  AS `time_series`
  LEFT JOIN  cte_0  AS `rolling_source` ON `rolling_source`.`policies__issued_at_month` >= DATE_TRUNC(`time_series`.`date_from`, 'year') and `rolling_source`.`policies__issued_at_month` <= `time_series`.`date_to` GROUP BY 1 ORDER BY  1  ASC),
cte_2 AS (  SELECT DATE_TRUNC(CONVERT_TZ(`policies`.issued_at, 'UTC', 'UTC'), 'month') `policies__issued_at_month`, sum(`policies`.written_premium) `policies__written_premium`  
  FROM  dw.ins_policy  AS `policies`
  WHERE (`policies`.issued_at >= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3)) AND `policies`.issued_at <= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3))) GROUP BY 1)
SELECT `fk_aggregate_keys`.`policies__issued_at_month` `policies__issued_at_month`, `q_1`.`policies__written_premium` `policies__written_premium`, `q_0`.`policies__written_premium_ytd` `policies__written_premium_ytd`  
FROM (SELECT DISTINCT `policies__issued_at_month` `policies__issued_at_month`  
FROM (SELECT DISTINCT `policies__issued_at_month` `policies__issued_at_month`  
FROM  cte_1  AS `cte_1`
 UNION ALL 
SELECT DISTINCT `policies__issued_at_month` `policies__issued_at_month`  
FROM  cte_2  AS `cte_2`) AS `fk_aggregate_keys_source`) AS `fk_aggregate_keys`
LEFT JOIN  cte_1  AS `q_0` ON ((`fk_aggregate_keys`.`policies__issued_at_month` = `q_0`.`policies__issued_at_month` OR ((`fk_aggregate_keys`.`policies__issued_at_month` IS NULL) AND (`q_0`.`policies__issued_at_month` IS NULL))))
LEFT JOIN  cte_2  AS `q_1` ON ((`fk_aggregate_keys`.`policies__issued_at_month` = `q_1`.`policies__issued_at_month` OR ((`fk_aggregate_keys`.`policies__issued_at_month` IS NULL) AND (`q_1`.`policies__issued_at_month` IS NULL)))) ORDER BY  1  ASC
-- parameters: ["2026-01-01T00:00:00.000", "2026-06-30T23:59:59.999", "2026-01-01T00:00:00.000Z", "2026-06-30T23:59:59.999Z"]

-- uw_by_underwriting_year
SELECT DATE_ADD(DATE_TRUNC(DATE_SUB(CONVERT_TZ(`policies`.issued_at, 'UTC', 'UTC'), INTERVAL 3 MONTH), 'year'), INTERVAL 3 MONTH) `policies__issued_at_underwriting_year`, sum(`policies`.written_premium) `policies__written_premium`  
FROM  dw.ins_policy  AS `policies`
WHERE (`policies`.issued_at >= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3)) AND `policies`.issued_at <= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3))) GROUP BY 1 ORDER BY  1  ASC
-- parameters: ["2025-01-01T00:00:00.000Z", "2026-12-31T23:59:59.999Z"]

-- uw_policy_listing
SELECT `policies`.policy_no `policies__policy_no`, `products`.product_name `products__product_name`, `branches`.branch_name `branches__branch_name`, `policies`.written_premium `policies__written_premium`  
FROM  dw.ins_policy  AS `policies`
LEFT JOIN  dw.ins_product  AS `products` ON `policies`.product_cd = `products`.product_cd
LEFT JOIN  dw.ins_branch  AS `branches` ON `policies`.branch_cd = `branches`.branch_cd
WHERE ((`policies`.renewal_of IS NOT NULL) = CAST(? AS BOOLEAN)) ORDER BY  1  ASC
LIMIT 50
-- parameters: ["true"]

-- ep_rolling_12m_by_month
 WITH 
time_series AS (  SELECT CAST(REPLACE(dates.f, 'T', ' ') AS DATETIMEV2(3)) date_from, CAST(REPLACE(dates.t, 'T', ' ') AS DATETIMEV2(3)) date_to 
  FROM (
      select '2026-01-01T00:00:00.000' f, '2026-01-31T23:59:59.999' t 
   UNION ALL
      select '2026-02-01T00:00:00.000' f, '2026-02-28T23:59:59.999' t 
   UNION ALL
      select '2026-03-01T00:00:00.000' f, '2026-03-31T23:59:59.999' t 
   UNION ALL
      select '2026-04-01T00:00:00.000' f, '2026-04-30T23:59:59.999' t 
   UNION ALL
      select '2026-05-01T00:00:00.000' f, '2026-05-31T23:59:59.999' t 
   UNION ALL
      select '2026-06-01T00:00:00.000' f, '2026-06-30T23:59:59.999' t 
  ) AS dates),
cte_0 AS (  SELECT DATE_TRUNC(CONVERT_TZ(`earned_premiums`.earned_month, 'UTC', 'UTC'), 'month') `earned_premiums__earned_month_month`, sum(`earned_premiums`.earned_premium) `earned_premiums__earned_premium_12m`  
  FROM  dw.ins_earned_premium  AS `earned_premiums`
  WHERE (CONVERT_TZ(`earned_premiums`.earned_month, 'UTC', 'UTC') >= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3)) AND CONVERT_TZ(`earned_premiums`.earned_month, 'UTC', 'UTC') <= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3))) GROUP BY 1 ORDER BY  1  ASC),
cte_1 AS (  SELECT `time_series`.`date_from` `earned_premiums__earned_month_month`, sum(`rolling_source`.`earned_premiums__earned_premium_12m`) `earned_premiums__earned_premium_12m`  
  FROM  time_series  AS `time_series`
  LEFT JOIN  cte_0  AS `rolling_source` ON `rolling_source`.`earned_premiums__earned_month_month` > DATE_SUB(`time_series`.`date_to`, INTERVAL 12 MONTH) AND `rolling_source`.`earned_premiums__earned_month_month` <= `time_series`.`date_to` GROUP BY 1 ORDER BY  1  ASC)
SELECT `fk_aggregate`.`earned_premiums__earned_month_month` `earned_premiums__earned_month_month`, `fk_aggregate`.`earned_premiums__earned_premium_12m` `earned_premiums__earned_premium_12m`  
FROM  cte_1  AS `fk_aggregate` ORDER BY  1  ASC
-- parameters: ["2025-01-01T00:00:00.000", "2026-06-30T23:59:59.999"]

-- ep_written_vs_earned_by_line
 WITH 
cte_0 AS (  SELECT `products`.line_of_business `products__line_of_business`, sum(`policies`.written_premium) `policies__written_premium`  
  FROM  dw.ins_policy  AS `policies`
  LEFT JOIN  dw.ins_product  AS `products` ON `policies`.product_cd = `products`.product_cd GROUP BY 1),
cte_1 AS (  SELECT `products`.line_of_business `products__line_of_business`, sum(`earned_premiums`.earned_premium) `earned_premiums__earned_premium`  
  FROM  dw.ins_earned_premium  AS `earned_premiums`
  LEFT JOIN  dw.ins_policy  AS `policies` ON `earned_premiums`.policy_id = `policies`.policy_id
  LEFT JOIN  dw.ins_product  AS `products` ON `policies`.product_cd = `products`.product_cd GROUP BY 1)
SELECT `fk_aggregate_keys`.`products__line_of_business` `products__line_of_business`, `q_0`.`policies__written_premium` `policies__written_premium`, `q_1`.`earned_premiums__earned_premium` `earned_premiums__earned_premium`  
FROM (SELECT DISTINCT `products__line_of_business` `products__line_of_business`  
FROM (SELECT DISTINCT `products__line_of_business` `products__line_of_business`  
FROM  cte_0  AS `cte_0`
 UNION ALL 
SELECT DISTINCT `products__line_of_business` `products__line_of_business`  
FROM  cte_1  AS `cte_1`) AS `fk_aggregate_keys_source`) AS `fk_aggregate_keys`
LEFT JOIN  cte_0  AS `q_0` ON ((`fk_aggregate_keys`.`products__line_of_business` = `q_0`.`products__line_of_business` OR ((`fk_aggregate_keys`.`products__line_of_business` IS NULL) AND (`q_0`.`products__line_of_business` IS NULL))))
LEFT JOIN  cte_1  AS `q_1` ON ((`fk_aggregate_keys`.`products__line_of_business` = `q_1`.`products__line_of_business` OR ((`fk_aggregate_keys`.`products__line_of_business` IS NULL) AND (`q_1`.`products__line_of_business` IS NULL)))) ORDER BY  1  ASC
-- parameters: []

-- cl_counts_by_cause
SELECT `claims`.cause_cd `claims__cause_cd`, count(`claims`.claim_id) `claims__claim_count`, count(CASE WHEN (`claims`.status = 'OPEN') THEN `claims`.claim_id END) `claims__open_count`, avg(`claims`.report_lag_days) `claims__avg_report_lag_days`, max(`claims`.report_lag_days) `claims__max_report_lag_days`  
FROM  dw.ins_claim  AS `claims` GROUP BY 1 ORDER BY  1  ASC
-- parameters: []

-- cl_outstanding_by_line
SELECT `products`.line_of_business `products__line_of_business`, count(`claims`.claim_id) `claims__claim_count`, sum(`claim_reserves`.outstanding) `claim_reserves__outstanding`, sum(`claim_reserves`.outstanding) / NULLIF(count(`claims`.claim_id), 0) `claims__avg_outstanding`  
FROM  dw.ins_claim  AS `claims`
LEFT JOIN  dw.ins_policy  AS `policies` ON `claims`.policy_id = `policies`.policy_id
LEFT JOIN  dw.ins_product  AS `products` ON `policies`.product_cd = `products`.product_cd
LEFT JOIN  dw.ins_claim_reserve  AS `claim_reserves` ON `claims`.claim_id = `claim_reserves`.claim_id GROUP BY 1 ORDER BY  1  ASC
-- parameters: []

-- cl_paid_and_outstanding_by_line
 WITH 
cte_0 AS (  SELECT `products`.line_of_business `products__line_of_business`, sum(`claim_payments`.paid_amount) `claim_payments__paid_amount`  
  FROM  dw.ins_claim_payment  AS `claim_payments`
  LEFT JOIN  dw.ins_claim  AS `claims` ON `claim_payments`.claim_id = `claims`.claim_id
  LEFT JOIN  dw.ins_policy  AS `policies` ON `claims`.policy_id = `policies`.policy_id
  LEFT JOIN  dw.ins_product  AS `products` ON `policies`.product_cd = `products`.product_cd GROUP BY 1),
cte_1 AS (  SELECT `keys`.`products__line_of_business` `products__line_of_business`, sum(`claim_reserves_key_claim_reserves`.outstanding) `claim_reserves__outstanding`  
  FROM (SELECT DISTINCT `claim_reserves_key_products`.line_of_business `products__line_of_business`, `claim_reserves_key_claim_reserves`.claim_id `claim_reserves__claim_id`  
  FROM  dw.ins_claim_payment  AS `claim_reserves_key_claim_payments`
  LEFT JOIN  dw.ins_claim  AS `claim_reserves_key_claims` ON `claim_reserves_key_claim_payments`.claim_id = `claim_reserves_key_claims`.claim_id
  LEFT JOIN  dw.ins_policy  AS `claim_reserves_key_policies` ON `claim_reserves_key_claims`.policy_id = `claim_reserves_key_policies`.policy_id
  LEFT JOIN  dw.ins_product  AS `claim_reserves_key_products` ON `claim_reserves_key_policies`.product_cd = `claim_reserves_key_products`.product_cd
  LEFT JOIN  dw.ins_claim_reserve  AS `claim_reserves_key_claim_reserves` ON `claim_reserves_key_claims`.claim_id = `claim_reserves_key_claim_reserves`.claim_id) AS `keys`
  LEFT JOIN  dw.ins_claim_reserve  AS `claim_reserves_key_claim_reserves` ON ((`keys`.`claim_reserves__claim_id` = `claim_reserves_key_claim_reserves`.claim_id)) GROUP BY 1)
SELECT `fk_aggregate_keys`.`products__line_of_business` `products__line_of_business`, `q_0`.`claim_payments__paid_amount` `claim_payments__paid_amount`, `q_1`.`claim_reserves__outstanding` `claim_reserves__outstanding`  
FROM (SELECT DISTINCT `products__line_of_business` `products__line_of_business`  
FROM (SELECT DISTINCT `products__line_of_business` `products__line_of_business`  
FROM  cte_0  AS `cte_0`
 UNION ALL 
SELECT DISTINCT `products__line_of_business` `products__line_of_business`  
FROM  cte_1  AS `cte_1`) AS `fk_aggregate_keys_source`) AS `fk_aggregate_keys`
LEFT JOIN  cte_0  AS `q_0` ON ((`fk_aggregate_keys`.`products__line_of_business` = `q_0`.`products__line_of_business` OR ((`fk_aggregate_keys`.`products__line_of_business` IS NULL) AND (`q_0`.`products__line_of_business` IS NULL))))
LEFT JOIN  cte_1  AS `q_1` ON ((`fk_aggregate_keys`.`products__line_of_business` = `q_1`.`products__line_of_business` OR ((`fk_aggregate_keys`.`products__line_of_business` IS NULL) AND (`q_1`.`products__line_of_business` IS NULL)))) ORDER BY  1  ASC
-- parameters: []

-- cl_development_triangle
SELECT DATE_TRUNC(CONVERT_TZ(`claims`.loss_at, 'UTC', 'UTC'), 'year') `claims__loss_at_year`, DATE_TRUNC(CONVERT_TZ(`claim_payments`.paid_at, 'UTC', 'UTC'), 'year') `claim_payments__paid_at_year`, sum(`claim_payments`.paid_amount) `claim_payments__paid_amount`  
FROM  dw.ins_claim_payment  AS `claim_payments`
LEFT JOIN  dw.ins_claim  AS `claims` ON `claim_payments`.claim_id = `claims`.claim_id GROUP BY 1, 2 ORDER BY  1  ASC,  2  ASC
-- parameters: []

-- x_premium_paid_by_line
 WITH 
cte_0 AS (  SELECT `products`.line_of_business `products__line_of_business`, sum(`earned_premiums`.earned_premium) `earned_premiums__earned_premium`  
  FROM  dw.ins_earned_premium  AS `earned_premiums`
  LEFT JOIN  dw.ins_policy  AS `policies` ON `earned_premiums`.policy_id = `policies`.policy_id
  LEFT JOIN  dw.ins_product  AS `products` ON `policies`.product_cd = `products`.product_cd GROUP BY 1),
cte_1 AS (  SELECT `products`.line_of_business `products__line_of_business`, sum(`claim_payments`.paid_amount) `claim_payments__paid_amount`  
  FROM  dw.ins_claim_payment  AS `claim_payments`
  LEFT JOIN  dw.ins_claim  AS `claims` ON `claim_payments`.claim_id = `claims`.claim_id
  LEFT JOIN  dw.ins_policy  AS `policies` ON `claims`.policy_id = `policies`.policy_id
  LEFT JOIN  dw.ins_product  AS `products` ON `policies`.product_cd = `products`.product_cd GROUP BY 1),
cte_2 AS (  SELECT `products`.line_of_business `products__line_of_business`, count(`claims`.claim_id) `claims__claim_count`  
  FROM  dw.ins_claim  AS `claims`
  LEFT JOIN  dw.ins_policy  AS `policies` ON `claims`.policy_id = `policies`.policy_id
  LEFT JOIN  dw.ins_product  AS `products` ON `policies`.product_cd = `products`.product_cd GROUP BY 1)
SELECT `fk_aggregate_keys`.`products__line_of_business` `products__line_of_business`, `q_0`.`earned_premiums__earned_premium` `earned_premiums__earned_premium`, `q_1`.`claim_payments__paid_amount` `claim_payments__paid_amount`, `q_2`.`claims__claim_count` `claims__claim_count`  
FROM (SELECT DISTINCT `products__line_of_business` `products__line_of_business`  
FROM (SELECT DISTINCT `products__line_of_business` `products__line_of_business`  
FROM  cte_0  AS `cte_0`
 UNION ALL 
SELECT DISTINCT `products__line_of_business` `products__line_of_business`  
FROM  cte_1  AS `cte_1`
 UNION ALL 
SELECT DISTINCT `products__line_of_business` `products__line_of_business`  
FROM  cte_2  AS `cte_2`) AS `fk_aggregate_keys_source`) AS `fk_aggregate_keys`
LEFT JOIN  cte_0  AS `q_0` ON ((`fk_aggregate_keys`.`products__line_of_business` = `q_0`.`products__line_of_business` OR ((`fk_aggregate_keys`.`products__line_of_business` IS NULL) AND (`q_0`.`products__line_of_business` IS NULL))))
LEFT JOIN  cte_1  AS `q_1` ON ((`fk_aggregate_keys`.`products__line_of_business` = `q_1`.`products__line_of_business` OR ((`fk_aggregate_keys`.`products__line_of_business` IS NULL) AND (`q_1`.`products__line_of_business` IS NULL))))
LEFT JOIN  cte_2  AS `q_2` ON ((`fk_aggregate_keys`.`products__line_of_business` = `q_2`.`products__line_of_business` OR ((`fk_aggregate_keys`.`products__line_of_business` IS NULL) AND (`q_2`.`products__line_of_business` IS NULL)))) ORDER BY  1  ASC
-- parameters: []

-- x_premium_paid_ceded_by_region
 WITH 
cte_0 AS (  SELECT `branches`.region_name `branches__region_name`, sum(`policies`.written_premium) `policies__written_premium`  
  FROM  dw.ins_policy  AS `policies`
  LEFT JOIN  dw.ins_branch  AS `branches` ON `policies`.branch_cd = `branches`.branch_cd
  LEFT JOIN  dw.ins_product  AS `products` ON `policies`.product_cd = `products`.product_cd
  WHERE (`products`.line_of_business = ?) GROUP BY 1),
cte_1 AS (  SELECT `branches`.region_name `branches__region_name`, sum(`cessions`.ceded_premium) `cessions__ceded_premium`  
  FROM  dw.ins_cession  AS `cessions`
  LEFT JOIN  dw.ins_policy  AS `policies` ON `cessions`.policy_id = `policies`.policy_id
  LEFT JOIN  dw.ins_branch  AS `branches` ON `policies`.branch_cd = `branches`.branch_cd
  LEFT JOIN  dw.ins_product  AS `products` ON `policies`.product_cd = `products`.product_cd
  WHERE (`products`.line_of_business = ?) GROUP BY 1),
cte_2 AS (  SELECT `branches`.region_name `branches__region_name`, sum(`claim_payments`.paid_amount) `claim_payments__paid_amount`  
  FROM  dw.ins_claim_payment  AS `claim_payments`
  LEFT JOIN  dw.ins_claim  AS `claims` ON `claim_payments`.claim_id = `claims`.claim_id
  LEFT JOIN  dw.ins_policy  AS `policies` ON `claims`.policy_id = `policies`.policy_id
  LEFT JOIN  dw.ins_branch  AS `branches` ON `policies`.branch_cd = `branches`.branch_cd
  LEFT JOIN  dw.ins_product  AS `products` ON `policies`.product_cd = `products`.product_cd
  WHERE (`products`.line_of_business = ?) GROUP BY 1)
SELECT `fk_aggregate_keys`.`branches__region_name` `branches__region_name`, `q_0`.`policies__written_premium` `policies__written_premium`, `q_1`.`cessions__ceded_premium` `cessions__ceded_premium`, `q_2`.`claim_payments__paid_amount` `claim_payments__paid_amount`  
FROM (SELECT DISTINCT `branches__region_name` `branches__region_name`  
FROM (SELECT DISTINCT `branches__region_name` `branches__region_name`  
FROM  cte_0  AS `cte_0`
 UNION ALL 
SELECT DISTINCT `branches__region_name` `branches__region_name`  
FROM  cte_1  AS `cte_1`
 UNION ALL 
SELECT DISTINCT `branches__region_name` `branches__region_name`  
FROM  cte_2  AS `cte_2`) AS `fk_aggregate_keys_source`) AS `fk_aggregate_keys`
LEFT JOIN  cte_0  AS `q_0` ON ((`fk_aggregate_keys`.`branches__region_name` = `q_0`.`branches__region_name` OR ((`fk_aggregate_keys`.`branches__region_name` IS NULL) AND (`q_0`.`branches__region_name` IS NULL))))
LEFT JOIN  cte_1  AS `q_1` ON ((`fk_aggregate_keys`.`branches__region_name` = `q_1`.`branches__region_name` OR ((`fk_aggregate_keys`.`branches__region_name` IS NULL) AND (`q_1`.`branches__region_name` IS NULL))))
LEFT JOIN  cte_2  AS `q_2` ON ((`fk_aggregate_keys`.`branches__region_name` = `q_2`.`branches__region_name` OR ((`fk_aggregate_keys`.`branches__region_name` IS NULL) AND (`q_2`.`branches__region_name` IS NULL)))) ORDER BY  1  ASC
-- parameters: ["MOTOR", "MOTOR", "MOTOR"]

-- x_totals
 WITH 
cte_0 AS (  SELECT sum(`policies`.written_premium) `policies__written_premium`  
  FROM  dw.ins_policy  AS `policies`),
cte_1 AS (  SELECT sum(`earned_premiums`.earned_premium) `earned_premiums__earned_premium`  
  FROM  dw.ins_earned_premium  AS `earned_premiums`),
cte_2 AS (  SELECT sum(`claim_payments`.paid_amount) `claim_payments__paid_amount`  
  FROM  dw.ins_claim_payment  AS `claim_payments`),
cte_3 AS (  SELECT sum(`claim_reserves`.outstanding) `claim_reserves__outstanding`  
  FROM  dw.ins_claim_reserve  AS `claim_reserves`),
cte_4 AS (  SELECT sum(`cessions`.ceded_premium) `cessions__ceded_premium`  
  FROM  dw.ins_cession  AS `cessions`)
SELECT `q_0`.`policies__written_premium` `policies__written_premium`, `q_1`.`earned_premiums__earned_premium` `earned_premiums__earned_premium`, `q_2`.`claim_payments__paid_amount` `claim_payments__paid_amount`, `q_3`.`claim_reserves__outstanding` `claim_reserves__outstanding`, `q_4`.`cessions__ceded_premium` `cessions__ceded_premium`  
FROM  cte_0  AS `q_0`
INNER JOIN  cte_1  AS `q_1` ON 1 = 1
INNER JOIN  cte_2  AS `q_2` ON 1 = 1
INNER JOIN  cte_3  AS `q_3` ON 1 = 1
INNER JOIN  cte_4  AS `q_4` ON 1 = 1
-- parameters: []

-- v_claims_by_line_cause
SELECT `products`.line_of_business `claims_overview__line_of_business`, `claims`.cause_cd `claims_overview__cause_cd`, sum(`claim_payments`.paid_amount) `claims_overview__paid_amount`, COUNT(DISTINCT `claims`.claim_id) `claims_overview__claim_count`, sum(`claim_payments`.paid_amount) / NULLIF(COUNT(DISTINCT `claims`.claim_id), 0) `claims_overview__paid_per_claim`  
FROM  dw.ins_claim_payment  AS `claim_payments`
LEFT JOIN  dw.ins_claim  AS `claims` ON `claim_payments`.claim_id = `claims`.claim_id
LEFT JOIN  dw.ins_policy  AS `policies` ON `claims`.policy_id = `policies`.policy_id
LEFT JOIN  dw.ins_product  AS `products` ON `policies`.product_cd = `products`.product_cd
WHERE (`claim_payments`.paid_at >= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3)) AND `claim_payments`.paid_at <= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3))) GROUP BY 1, 2 ORDER BY  1  ASC,  2  ASC
-- parameters: ["2026-01-01T00:00:00.000Z", "2026-12-31T23:59:59.999Z"]

-- security_region_across_facts
 WITH 
cte_0 AS (  SELECT `products`.line_of_business `products__line_of_business`, sum(`earned_premiums`.earned_premium) `earned_premiums__earned_premium`  
  FROM  dw.ins_earned_premium  AS `earned_premiums`
  LEFT JOIN  dw.ins_policy  AS `policies` ON `earned_premiums`.policy_id = `policies`.policy_id
  LEFT JOIN  dw.ins_product  AS `products` ON `policies`.product_cd = `products`.product_cd
  LEFT JOIN  dw.ins_branch  AS `branches` ON `policies`.branch_cd = `branches`.branch_cd
  WHERE (`branches`.region_name = ?) GROUP BY 1),
cte_1 AS (  SELECT `products`.line_of_business `products__line_of_business`, sum(`claim_payments`.paid_amount) `claim_payments__paid_amount`  
  FROM  dw.ins_claim_payment  AS `claim_payments`
  LEFT JOIN  dw.ins_claim  AS `claims` ON `claim_payments`.claim_id = `claims`.claim_id
  LEFT JOIN  dw.ins_policy  AS `policies` ON `claims`.policy_id = `policies`.policy_id
  LEFT JOIN  dw.ins_product  AS `products` ON `policies`.product_cd = `products`.product_cd
  LEFT JOIN  dw.ins_branch  AS `branches` ON `policies`.branch_cd = `branches`.branch_cd
  WHERE (`branches`.region_name = ?) GROUP BY 1),
cte_2 AS (  SELECT `products`.line_of_business `products__line_of_business`, count(`claims`.claim_id) `claims__claim_count`  
  FROM  dw.ins_claim  AS `claims`
  LEFT JOIN  dw.ins_policy  AS `policies` ON `claims`.policy_id = `policies`.policy_id
  LEFT JOIN  dw.ins_product  AS `products` ON `policies`.product_cd = `products`.product_cd
  LEFT JOIN  dw.ins_branch  AS `branches` ON `policies`.branch_cd = `branches`.branch_cd
  WHERE (`branches`.region_name = ?) GROUP BY 1)
SELECT `fk_aggregate_keys`.`products__line_of_business` `products__line_of_business`, `q_0`.`earned_premiums__earned_premium` `earned_premiums__earned_premium`, `q_1`.`claim_payments__paid_amount` `claim_payments__paid_amount`, `q_2`.`claims__claim_count` `claims__claim_count`  
FROM (SELECT DISTINCT `products__line_of_business` `products__line_of_business`  
FROM (SELECT DISTINCT `products__line_of_business` `products__line_of_business`  
FROM  cte_0  AS `cte_0`
 UNION ALL 
SELECT DISTINCT `products__line_of_business` `products__line_of_business`  
FROM  cte_1  AS `cte_1`
 UNION ALL 
SELECT DISTINCT `products__line_of_business` `products__line_of_business`  
FROM  cte_2  AS `cte_2`) AS `fk_aggregate_keys_source`) AS `fk_aggregate_keys`
LEFT JOIN  cte_0  AS `q_0` ON ((`fk_aggregate_keys`.`products__line_of_business` = `q_0`.`products__line_of_business` OR ((`fk_aggregate_keys`.`products__line_of_business` IS NULL) AND (`q_0`.`products__line_of_business` IS NULL))))
LEFT JOIN  cte_1  AS `q_1` ON ((`fk_aggregate_keys`.`products__line_of_business` = `q_1`.`products__line_of_business` OR ((`fk_aggregate_keys`.`products__line_of_business` IS NULL) AND (`q_1`.`products__line_of_business` IS NULL))))
LEFT JOIN  cte_2  AS `q_2` ON ((`fk_aggregate_keys`.`products__line_of_business` = `q_2`.`products__line_of_business` OR ((`fk_aggregate_keys`.`products__line_of_business` IS NULL) AND (`q_2`.`products__line_of_business` IS NULL)))) ORDER BY  1  ASC
-- parameters: ["East", "East", "East"]
