-- day
SELECT DATE_TRUNC(CONVERT_TZ(`sales`.sold_at, 'UTC', 'Asia/Tokyo'), 'day') `sales__sold_at_day`, sum(`sales`.amount) `sales__amount`  
FROM  dw.sales_dtl  AS `sales`
WHERE (`sales`.sold_at >= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3)) AND `sales`.sold_at <= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3))) GROUP BY 1 ORDER BY  1  ASC
-- parameters: ["2026-09-30T15:00:00.000Z", "2026-10-31T14:59:59.999Z"]

-- week
SELECT DATE_TRUNC(CONVERT_TZ(`sales`.sold_at, 'UTC', 'Asia/Tokyo'), 'week') `sales__sold_at_week`, sum(`sales`.amount) `sales__amount`  
FROM  dw.sales_dtl  AS `sales`
WHERE (`sales`.sold_at >= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3)) AND `sales`.sold_at <= CAST(LEFT(REPLACE(?, 'T', ' '), 23) AS DATETIMEV2(3))) GROUP BY 1 ORDER BY  1  ASC
-- parameters: ["2026-09-30T15:00:00.000Z", "2026-10-31T14:59:59.999Z"]

